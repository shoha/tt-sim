# Design docs (local planning notes, not for repo)
/docs/plans/
/docs/superpowers/

# Git worktrees
.worktrees/

# Subagent-driven-development scratch workspace (ledgers, briefs, review packages)
.superpowers/

# Godot 4+ specific ignores
.godot/
/android/
/assets/models/user/
/assets/icons/user/
/cursor_hints/
/user_assets/
.vscode/

# Steam — App ID is environment-specific (480/SpaceWar for dev, real ID for release)
steam_appid.txt

# GodotSteam GDExtension shadow-copy DLLs — Godot copies the real DLL to a `~`-prefixed
# file on load (Windows) so it can keep running without locking the original file.
addons/godotsteam/**/~*

# Local debug builds (for multiplayer testing)
/build/windows-debug/

# Claude Code — local overrides are machine-specific
.claude/settings.local.json

# Validation bridge MCP server (build artifacts + deps)
tools/mcp/node_modules/
tools/mcp/dist/

# Python bytecode from the SFX generation tools
__pycache__/
*.pyc

# Native scatter library: native/SConstruct builds it and writes the extension file beside it,
# so a checkout that never built it has no extension for Godot to load (docs/systems/scatter.md)
/native/bin/
/native/tt_scatter.gdextension
/native/tt_scatter.gdextension.uid
/native/.sconsign.dblite
/native/**/*.o
/native/**/*.os
/native/compile_commands.json
