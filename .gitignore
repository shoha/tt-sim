# Steam — App ID is environment-specific (480/SpaceWar for dev, real ID for release)
steam_appid.txt

# GodotSteam GDExtension shadow-copy DLLs — Godot copies the real DLL to a `~`-prefixed
# file on load (Windows) so it can keep running without locking the original file.
addons/godotsteam/**/~*

# Local debug builds (for multiplayer testing)
/build/windows-debug/

# Claude Code — local overrides are machine-specific
.claude/settings.local.json

# Validation bridge MCP server (build artifacts + deps)
tools/mcp/node_modules/
tools/mcp/dist/
