{
  "out_dir": "render_jobs/_msize_",
  "timeout_s": 600,
  "steps": [
    {"op": "wait_title"},
    {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 200, "seed": 3, "landform": "valley"},
    {"op": "no_autosave"},
    {"op": "wait_ready", "settle": 2.0},
    {"op": "call", "script": "res://tools/map_size/dump.gd", "action": "fill"},
    {"op": "wait_ready", "settle": 3.0},
    {"op": "call", "script": "res://tools/map_size/dump.gd", "name": "grass_valley_200_full"},
    {"op": "capture", "name": "grass_valley_200_full", "scale": 0.5},
    {"op": "title"},
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 200, "seed": 3, "landform": "valley"},
    {"op": "no_autosave"},
    {"op": "wait_ready", "settle": 2.0},
    {"op": "call", "script": "res://tools/map_size/dump.gd", "action": "fill"},
    {"op": "wait_ready", "settle": 3.0},
    {"op": "call", "script": "res://tools/map_size/dump.gd", "name": "forest_valley_200_full"},
    {"op": "title"},
    {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 200, "seed": 1234, "landform": "flat"},
    {"op": "no_autosave"},
    {"op": "wait_ready", "settle": 2.0},
    {"op": "call", "script": "res://tools/map_size/dump.gd", "action": "fill"},
    {"op": "wait_ready", "settle": 3.0},
    {"op": "call", "script": "res://tools/map_size/dump.gd", "name": "grass_flat_200_full"},
    {"op": "title"}
  ]
}
