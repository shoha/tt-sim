{
 "out_dir": "render_jobs/noblock_bench",
 "timeout_s": 1500,
 "hang_s": 120,
 "steps": [
  {"op": "wait_title"},
  {"op": "expand", "values": ["false", "true"], "template": [
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "switch", "core": "{value}"},
   {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 320, "seed": 1234, "landform": "hilltop"},
   {"op": "wait_ready", "settle": 1.0},
   {"op": "no_autosave"},
   {"op": "vsync_off"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "ground"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "warm"},
   {"op": "settle", "frames": 10, "timeout": 30},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "river", "press": "none"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "river", "press": "structure"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "river", "press": "crossing"},
