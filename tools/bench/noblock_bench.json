   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "river", "press": "fire"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "river", "press": "putout"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "river", "press": "save"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "river", "press": "table"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "river", "press": "undo"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "river", "press": "redo"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "river", "press": "paint"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "river", "press": "pond"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "none"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "structure"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "crossing"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "settlement"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "fire"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "putout"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "save"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "table"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "undo"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "redo"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "paint"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "trial", "after": "raise", "press": "pond"},
   {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "report"},
   {"op": "title"}
  ]},
  {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "cleanup"},
  {"op": "call", "script": "res://tools/bench/noblock_probe.gd", "action": "switch", "core": false}
 ]
}
