   {"op": "settle"},
   {"op": "capture", "name": "foliage_{value}_p12_y045"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 225, "pitch": 12}, {"op": "settle"}, {"op": "capture", "name": "foliage_{value}_p12_y225"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 135, "pitch": -15}, {"op": "settle"}, {"op": "capture", "name": "foliage_{value}_pm15_y135"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 315, "pitch": -15}, {"op": "settle"}, {"op": "capture", "name": "foliage_{value}_pm15_y315"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
