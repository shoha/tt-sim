{
  "out_dir": "render_jobs/p43_water",
  "timeout_s": 1200,
  "steps": [
    {"op": "expand_biomes", "biomes": ["temperate_forest_summer_s1", "grassland_meadow_summer_s1"], "template": [
      {"op": "new_map", "biome": "{biome}", "size": 200, "seed": 1234},
      {"op": "wait_ready", "settle": 1.0},
      {"op": "no_autosave"},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "tilt", "slope": 0.025},
      {"op": "stroke", "mode": "surface", "surface": "dirt_road_packed", "points": [[-4, -22], [-3, -12], [-4, -4], [-2, 4], [-3, 12], [-2, 22]], "radius": 1.2, "speed": 4.0, "keep_active": true},
      {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
      {"op": "wait_ready", "settle": 1.0},
      {"op": "home"},
      {"op": "wait", "s": 1.5},
      {"op": "capture", "name": "{biome}_a_before", "desc": "{name}: home view before water (ground tilted 2.5 % west to east, a dirt track)"},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "carve", "points": [[-29, 6], [-22, 10], [-15, 9], [-9, 4], [-3, 1], [3, 2], [9, 5], [15, 3], [21, -2], [29, -5]], "half_width": 1.8, "depth": "waist"},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "carve", "points": [[6, -11], [12, -14], [19, -13], [29, -17]], "half_width": 3.2, "depth": "deep"},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "pond", "points": [[-17, -14], [-15, -13]], "radius": 4.5, "depth": "waist"},
      {"op": "wait_ready", "settle": 1.5},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "check"},
      {"op": "capture", "name": "{biome}_b_after", "desc": "{name}: home view after: a winding waist-deep river in three reaches, a deep river, a pond"},
      {"op": "zoom", "size": 9.0},
      {"op": "wait", "s": 1.5},
      {"op": "look_at", "at": [-3, 1]},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_c_crossing", "desc": "{name}, zoom 9: the river crossing the dirt track (the track stops at the water)"},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "look", "at": "found:c1_joint1"},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_d_step", "desc": "{name}, zoom 9: a step between reaches, a small rapid"},
      {"op": "look_at", "at": [-16, -13.5]},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_e_pond", "desc": "{name}, zoom 9: the pond"},
      {"op": "look_at", "at": [16, -13]},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_f_deep", "desc": "{name}, zoom 9: the deep river"},
      {"op": "zoom", "size": 34.0},
      {"op": "wait", "s": 2.0},
      {"op": "look_at", "at": [0, -3]},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_g_overview", "desc": "{name}, zoom 34"},
      {"op": "title"},
      {"op": "wait", "s": 1.0}
    ]},
    {"op": "new_map", "biome": "rocky_badlands_summer_s1", "size": 200, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "tilt", "slope": 0.025},
    {"op": "stroke", "mode": "surface", "surface": "dirt_road_caliche", "points": [[-4, -22], [-3, -12], [-4, -4], [-2, 4], [-3, 12], [-2, 22]], "radius": 1.2, "speed": 4.0, "keep_active": true},
    {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "home"},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "rocky_badlands_a_before", "desc": "Rocky badlands: home view before water (tilted 2.5 %, a caliche track)"},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "carve", "points": [[-29, 6], [-22, 10], [-15, 9], [-9, 4], [-3, 1], [3, 2], [9, 5], [15, 3], [21, -2], [29, -5]], "half_width": 1.8, "depth": "waist"},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "carve", "points": [[6, -11], [12, -14], [19, -13], [29, -17]], "half_width": 3.2, "depth": "deep"},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "pond", "points": [[-17, -14], [-15, -13]], "radius": 4.5, "depth": "waist"},
    {"op": "wait_ready", "settle": 1.5},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "check"},
    {"op": "capture", "name": "rocky_badlands_b_after", "desc": "Rocky badlands: home view after"},
    {"op": "zoom", "size": 9.0},
    {"op": "wait", "s": 1.5},
    {"op": "look_at", "at": [-3, 1]},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "rocky_badlands_c_crossing", "desc": "Rocky badlands, zoom 9: the river crossing the caliche track"},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "look", "at": "found:c1_joint1"},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "rocky_badlands_d_step", "desc": "Rocky badlands, zoom 9: a step between reaches"},
    {"op": "look_at", "at": [-16, -13.5]},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "rocky_badlands_e_pond", "desc": "Rocky badlands, zoom 9: the pond"},
    {"op": "look_at", "at": [16, -13]},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "rocky_badlands_f_deep", "desc": "Rocky badlands, zoom 9: the deep river"},
    {"op": "zoom", "size": 14.0},
    {"op": "wait", "s": 2.0},
    {"op": "look_at", "at": [-3, 0]},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "rocky_badlands_g_grid", "desc": "Rocky badlands, zoom 14, grid on: squares continue across the water"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
    {"op": "zoom", "size": 34.0},
    {"op": "wait", "s": 2.0},
    {"op": "look_at", "at": [0, -3]},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "rocky_badlands_h_overview", "desc": "Rocky badlands, zoom 34"},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p43_badlands"},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "erase", "points": [[-4, -2], [-3, 4]], "radius": 3.0},
    {"op": "wait_ready", "settle": 1.5},
    {"op": "zoom", "size": 12.0},
    {"op": "wait", "s": 1.5},
    {"op": "look_at", "at": [-3, 1]},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "rocky_badlands_i_erased", "desc": "Rocky badlands, zoom 12: the water erased at the crossing, the carved channel left dry"},
    {"op": "eval", "expr": "_authoring_controller.undo()"},
    {"op": "wait_ready", "settle": 1.5},
    {"op": "capture", "name": "rocky_badlands_j_undone", "desc": "Rocky badlands, zoom 12: the erase undone"},
    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "play", "folder": "_p43_badlands"},
    {"op": "wait", "s": 8.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "tokens", "points": [[-6.5, 2.2], [-1.0, 1.2], [15.5, -13.5], [17.5, -12.5], [-16, -13.5]]},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "report"},
    {"op": "zoom", "size": 10.0},
    {"op": "wait", "s": 2.0},
    {"op": "look_at", "at": [-3.5, 1.5]},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "rocky_badlands_k_wading", "desc": "Play, zoom 10: tokens wading the waist-deep river"},
    {"op": "look_at", "at": [16.5, -13]},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "rocky_badlands_l_floating", "desc": "Play, zoom 10: tokens floating in the deep river"},
    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "cleanup"},
    {"op": "index", "title": "Carving and dressing water (P4-3)", "intro": "Per biome, a new 200 ft map tilted 2.5 % with a painted track, then a winding waist-deep river carved across it (three flat reaches joined by small rapids), a deep river and a painted pond, through the AuthoringEditor water API (probes/water.gd). Badlands: grid, an erase and its undo, then play with tokens wading and floating."}
  ]
}
