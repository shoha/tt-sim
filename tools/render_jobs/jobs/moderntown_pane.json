{
 "out_dir": "render_jobs/moderntown_pane",
 "timeout_s": 300,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 160, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [0, -14], "to": [0, 14], "preset": 11, "seed": 21},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "modern_town", "wealth": 0.6, "density": 1.0},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"village\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1280, 720]},
  {"op": "settle"},
  {"op": "zoom", "size": 30.0},
  {"op": "look_at", "at": [0, 0]},
  {"op": "input", "events": [{"type": "move", "at": [-60, -60]}]},
  {"op": "settle"},
  {"op": "capture", "name": "a_720_pane_modern", "desc": "1280x720: the Village pane for a modern town street; five character tiles on one line, the Modern town tile (phone box on mint) picked"},
  {"op": "eval", "expr": "[_authoring_controller.panel.find_child(\"VillagePane\", true, false).get_global_rect(), get_viewport().get_visible_rect()]"},
  {"op": "index", "title": "moderntown pane", "intro": "The Village pane at 720p with the fifth character, five tiles on one line"}
 ]
}
