{
 "out_dir": "render_jobs/widestreets_diag",
 "timeout_s": 300,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_widestreets_diag", "load": "dress"},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 320, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-28, 0], "to": [28, 0], "preset": 11, "seed": 14, "setback": "tool", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "modern_town", "wealth": 0.7, "density": 1.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "corridor", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_widestreets_diag", "replace": true, "phase": "build"},
  {"op": "wait", "s": 3.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "corridor"},
  {"op": "call", "script": "res://tools/render_jobs/probes/paint_check.gd", "points": [[0, 0], [0, 2], [0, 4.2], [0, 6], [0, -2], [0, -6], [10, 0]]}
 ]
}
