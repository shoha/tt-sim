{
 "out_dir": "render_jobs/designer_flow",
 "timeout_s": 600,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "wait_title"},
  {"op": "library_dev", "path": "D:/dev/plantgen/out/lib_core"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1600, 900]},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "a_title", "desc": "the title with the new Design a biome tool next to Collections"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "picker"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "b_picker", "desc": "Design a biome: your biomes (none yet) and the core biomes to try or copy"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "press", "under": "Row_core_temperate_forest", "name": "Copy"},
  {"op": "wait", "s": 0.5},
  {"op": "capture", "name": "c_name", "desc": "Make my own copy: the new collection's name, with the id it will have"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "text", "name": "CollectionName", "value": "My Temperate Forest"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "press", "name": "Create"},
  {"op": "wait_ready", "settle": 3.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/tree_fade.gd", "factor": 0},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "report"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "select", "rule": "oak"},
  {"op": "wait", "s": 0.5},
  {"op": "capture", "name": "d_copy_open", "desc": "the copy open in the designer: Save is enabled, the plants come from core"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "set", "rule": "oak", "field": "density_per_m2", "value": 0.02},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "capture", "name": "e_edited", "desc": "the oak density doubled: unsaved changes, the map regenerated"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "save"},
  {"op": "wait", "s": 0.5},
  {"op": "capture", "name": "f_saved", "desc": "after Save: no unsaved changes"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "leave"},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "libraries"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "picker"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "g_picker_after", "desc": "the picker again: the saved collection's biome is under Your biomes"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "cleanup", "library": "my_temperate_forest"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "libraries"},
  {"op": "index", "title": "biome designer: from the title to a saved copy", "intro": "Design a biome on the title, a core biome copied into a collection of the player's own (it depends on core for its plants), edited on the proving ground, saved, and found again in the picker. The collection is deleted at the end."}
 ]
}
