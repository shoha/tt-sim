{
 "out_dir": "render_jobs/p6_perf",
 "timeout_s": 900,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "build start"},

  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [2, 14]},
  {"op": "zoom", "size": 44.0},
  {"op": "wait", "s": 1.5},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 6.0, "curve": true, "points": [[-4, -6], [-2, 10], [0, 21], [3, 28], [10, 34], [18, 37]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "water_timing"},
  {"op": "look_at", "at": [6, -8]},
  {"op": "wait", "s": 1.0},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "ankle", "radius": 0.6, "speed": 6.0, "curve": true, "points": [[-8, -14], [4, -11], [14, -9], [22.5, -6], [27, -4.5]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "water_timing"},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p6_perf_exits", "replace": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "info"},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "cache_check"},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "exits_build", "runs": 5},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "apply_bench", "runs": 5},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "mirror_bench", "runs": 5},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "mem", "name": "exits authoring", "ws": true},
  {"op": "home"},
  {"op": "zoom", "size": 46.0},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "exits_overview", "scale": 0.5, "desc": "_p6_perf_exits: the waist river drawn past the near edge and the ankle stream to the right edge"},

  {"op": "look_at", "at": [-14, 8]},
  {"op": "zoom", "size": 24.0},
  {"op": "wait", "s": 1.5},
  {"op": "hide_ui"},
  {"op": "vsync_off"},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "record", "on": true, "name": "idle"},
  {"op": "wait", "s": 4.0},
  {"op": "record", "on": false},
  {"op": "record", "on": true, "name": "river_short"},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 4.0, "points": [[-8, 8], [-19.5, 9]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "record", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "water_timing"},
  {"op": "record", "on": true, "name": "river_short_erase"},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 4.0, "ctrl": true, "points": [[-8, 8], [-19.5, 9]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "record", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "water_timing"},
  {"op": "record", "on": true, "name": "river_to_edge"},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 4.0, "points": [[-8, 8], [-28, 9]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "record", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "water_timing"},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "info"},
  {"op": "capture", "name": "exits_left_edge", "scale": 0.5, "desc": "A third river drawn past the left edge (then erased)"},
  {"op": "record", "on": true, "name": "river_to_edge_erase"},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 4.0, "ctrl": true, "points": [[-8, 8], [-20, 9]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "record", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "water_timing"},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "info"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},

  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [2, 14]},
  {"op": "zoom", "size": 44.0},
  {"op": "wait", "s": 1.5},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 6.0, "curve": true, "points": [[-4, -6], [-2, 10], [-0.5, 17], [0.5, 20.5]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "look_at", "at": [6, -8]},
  {"op": "wait", "s": 1.0},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "ankle", "radius": 0.6, "speed": 6.0, "curve": true, "points": [[-8, -14], [4, -11], [14, -9], [20.5, -6.5]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p6_perf_short", "replace": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "info"},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "exits_build", "runs": 5},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "mem", "name": "short authoring", "ws": true},
  {"op": "home"},
  {"op": "zoom", "size": 46.0},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "short_overview", "scale": 0.5, "desc": "_p6_perf_short: the same rivers stopping about 2.4 m short of the edges"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "build end"}
 ]
}
