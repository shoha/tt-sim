{
 "out_dir": "render_jobs/fire_shards",
 "timeout_s": 240,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "dress", "folder": "_firefeat_look"},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire_shards.gd", "action": "chunks"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "day_zs", "label": "ALL"},
  {"op": "wait", "s": 3.0},
  {"op": "capture", "name": "dbg_all"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire_shards.gd", "action": "only", "keep": ["ground", "skirt"]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "GROUND ONLY  chunks and skirt"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "dbg_ground"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "param", "target": "ground", "name": "fire_present", "value": 0},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "GROUND ONLY  fire_present 0"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "dbg_nofire"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "param", "target": "ground", "name": "fire_present", "value": 1},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shadows", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "GROUND ONLY  no shadows"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "dbg_noshadow"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shadows", "on": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire_shards.gd", "action": "effects", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "GROUND ONLY  no SSAO, SSIL, SSR, SDFGI"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "dbg_noeffects"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire_shards.gd", "action": "effects", "on": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire_shards.gd", "action": "show"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire_shards.gd", "action": "only", "keep": ["rest"]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "NO GROUND  everything but the chunks and skirt"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "dbg_rest"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire_shards.gd", "action": "show"},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_shards", "names": ["dbg_all", "dbg_ground", "dbg_nofire", "dbg_noshadow", "dbg_noeffects", "dbg_rest"], "columns": 2, "tile": [960, 540], "out": "sheet_debug"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire_shards.gd", "action": "only", "keep": ["ground", "skirt"]},
  {"op": "expand", "values": ["1", "2", "3", "4", "5", "6", "7", "8"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire_shards.gd", "action": "debug", "view": "{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "GROUND ONLY  debug view {value}"},
   {"op": "wait", "s": 2.0},
   {"op": "capture", "name": "dbg_view{value}"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire_shards.gd", "action": "debug", "view": 0},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire_shards.gd", "action": "show"},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_shards", "names": ["dbg_ground", "dbg_view1", "dbg_view2", "dbg_view3", "dbg_view4", "dbg_nofire"], "columns": 2, "tile": [960, 540], "out": "sheet_debug2"},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_shards", "names": ["dbg_view2", "dbg_view5", "dbg_view6", "dbg_view7", "dbg_view8", "dbg_ground"], "columns": 2, "tile": [960, 300], "crop": [0.0, 0.45, 1.0, 0.55], "out": "sheet_debug3"},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_shards", "names": ["user://render_jobs/fire_shards_before/day_zs_new", "user://render_jobs/fire_shards_after/day_zs_new", "user://render_jobs/fire_shards_before/sunset_zs_new", "user://render_jobs/fire_shards_after/sunset_zs_new"], "columns": 2, "tile": [960, 540], "out": "sheet_before_after"},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
