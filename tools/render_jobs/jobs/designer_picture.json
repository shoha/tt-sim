{
 "out_dir": "render_jobs/designer_picture",
 "timeout_s": 600,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "wait_title"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1600, 900]},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "picker"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "press", "under": "Row_core_temperate_forest", "name": "Copy"},
  {"op": "wait", "s": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "text", "name": "CollectionName", "value": "Thumb Check"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "press", "name": "Create"},
  {"op": "wait_ready", "settle": 3.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "set", "rule": "oak", "field": "density_per_m2", "value": 0.02},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "capture", "name": "a_before", "desc": "a copy of core's temperate forest with an unsaved edit (the oak's density): the header's Thumbnail button is enabled"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "picture"},
  {"op": "wait", "s": 2.0},
  {"op": "capture", "name": "b_during", "desc": "the standard map opened for the picture (the proving ground is back afterwards)"},
  {"op": "wait", "s": 25.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "picture_check"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "report"},
  {"op": "capture", "name": "c_after", "desc": "back on the proving ground with the unsaved edit still unsaved; the picture is in the collection's thumbnails folder"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "leave"},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "cleanup", "library": "thumb_check"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "libraries"},
  {"op": "index", "title": "biome designer: the Thumbnail button", "intro": "A copy of core's temperate forest (a collection of the player's own, deleted at the end) takes its thumbnail from the draft on the standard map and saves it; the draft keeps its unsaved edit and the proving ground comes back."}
 ]
}
