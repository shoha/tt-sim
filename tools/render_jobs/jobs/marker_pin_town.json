{
 "out_dir": "render_jobs/marker_pin_town",
 "timeout_s": 1500,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_marker_town", "load": "play"},
  {"op": "new_map", "biome": "", "size": 250, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_marker_town", "replace": true, "phase": "build"},
  {"op": "play", "folder": "_marker_town", "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 34.0},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/rosterfolk.gd", "action": "row", "pack": "folk", "ids": ["villager_man", "farmhand_woman", "hunter_man", "wanderer_woman"], "at": [-4.5, 4.0], "spacing": 3.0, "per_row": 4},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "tokens", "from": [8, 2], "to": [11, 2], "items": ["avatar:0", "chunky:1", "avatar:2", "chunky:0", "avatar:1", "chunky:1"]},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "tokens", "from": [-5, 0], "to": [5, 0], "zig": 1.2, "items": ["avatar:0", "chunky:0", "avatar:3", "chunky:1", "chunky:2"]},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_toon_row.gd", "action": "hide", "index": 1},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "scale", "scale": {"chunky:2": 3.0}},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "zoom", "which": "closest"},
  {"op": "settle"},
  {"op": "look_at", "at": [-5, 0.3]},
  {"op": "settle"},
  {"op": "expand", "values": ["60", "75", "90"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": "{value}"},
   {"op": "settle"},
   {"op": "wait", "s": 1.5},
   {"op": "capture", "name": "town_closest_p{value}", "desc": "town, closest zoom (2 m), pitch {value}: the pin above an avatar"}
  ]},
  {"op": "zoom", "size": 6.0},
  {"op": "settle"},
  {"op": "look_at", "at": [-0.5, 0.6]},
  {"op": "settle"},
  {"op": "expand", "values": ["60", "75", "90"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": "{value}"},
   {"op": "settle"},
   {"op": "wait", "s": 1.0},
   {"op": "capture", "name": "town_mid_p{value}", "desc": "town, 6 m view, pitch {value}"}
  ]},
  {"op": "zoom", "size": 5.0},
  {"op": "settle"},
  {"op": "look_at", "at": [9.5, 2.2]},
  {"op": "settle"},
  {"op": "expand", "values": ["75", "90"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": "{value}"},
   {"op": "settle"},
   {"op": "wait", "s": 1.0},
   {"op": "capture", "name": "town_crowd_p{value}", "desc": "town, 5 m view, pitch {value}: six tokens 0.6 m apart"}
  ]},
  {"op": "zoom", "size": 34.0},
  {"op": "settle"},
  {"op": "look_at", "at": [8, 1]},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": 90},
  {"op": "settle"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "town_far_crowd_p90", "desc": "town, 34 m view, pitch 90: the crowd's pins overlap (0.6 m is 19 px here); the lower pin lies over the one above"},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "zoom", "which": "home"},
  {"op": "settle"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "settle"},
  {"op": "expand", "values": ["60", "75", "90"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": "{value}"},
   {"op": "settle"},
   {"op": "wait", "s": 1.0},
   {"op": "capture", "name": "town_home_p{value}", "desc": "town, home zoom, pitch {value}: folk, avatars, chunky models, a six-token crowd at right"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": 21.6},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "zoom", "which": "home"},
  {"op": "settle"},
  {"op": "wind", "freeze": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "clip", "name": "town_o_toggle", "dir": "user://render_jobs/marker_pin_town/town_o_toggle", "seconds": 3.0, "fps": 30, "width": 960, "events": [{"at": 10, "do": "toggle"}, {"at": 55, "do": "toggle"}]},
  {"op": "wait", "s": 3.5},
  {"op": "index", "title": "marker pin town", "intro": "Camera rig card 4: the token pin, hamlet and market town"},
  {"op": "title"},
  {"op": "wait", "s": 0.5}
 ]
}
