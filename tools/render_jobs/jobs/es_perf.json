{
 "out_dir": "render_jobs/es_perf",
 "timeout_s": 300,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "play", "folder": "_camera_es_hamlet"},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "hide_ui"},
  {"op": "vsync_off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "before"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "enter", "at": [0, 30], "yaw": 184, "pitch": 3, "fov": 60},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "sky", "on": false},
  {"op": "wait", "s": 0.5},
  {"op": "gpu", "name": "eye_flat_1", "s": 4.0, "for": "sky_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "sky", "on": true},
  {"op": "wait", "s": 0.5},
  {"op": "gpu", "name": "eye_painted_1", "s": 4.0, "for": "sky_gpu"},
  {"op": "gpu", "name": "eye_painted_2", "s": 4.0, "for": "sky_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "sky", "on": false},
  {"op": "wait", "s": 0.5},
  {"op": "gpu", "name": "eye_flat_2", "s": 4.0, "for": "sky_gpu"},
  {"op": "gpu", "name": "eye_flat_3", "s": 4.0, "for": "sky_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "sky", "on": true},
  {"op": "wait", "s": 0.5},
  {"op": "gpu", "name": "eye_painted_3", "s": 4.0, "for": "sky_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "eye"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "after"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
  {"op": "title"},
  {"op": "wait", "s": 0.5}
 ]
}
