{
 "out_dir": "render_jobs/eye_view_street",
 "timeout_s": 900,
 "hang_s": 150,
 "saved": {"folder": "_camera_ev_street", "load": "play"},
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_camera_ev_street", "load": "play"},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 250, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.4, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_camera_ev_street", "replace": true, "phase": "build"},
  {"op": "play", "folder": "_camera_ev_street", "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 26.0},
  {"op": "settle"},
  {"op": "capture", "name": "ev_street_orbit_before", "desc": "orbit home before the eye"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "enter", "at": [-18, -20], "yaw": 45, "pitch": 3, "fov": 60},
  {"op": "settle"},
  {"op": "capture", "name": "ev_street_y045", "desc": "eye on the street, yaw 45, pitch 3"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 135},
  {"op": "settle"},
  {"op": "capture", "name": "ev_street_y135", "desc": "eye, yaw 135"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 225},
  {"op": "settle"},
  {"op": "capture", "name": "ev_street_y225", "desc": "eye, yaw 225"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 315},
  {"op": "settle"},
  {"op": "capture", "name": "ev_street_y315", "desc": "eye, yaw 315"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
  {"op": "settle"},
  {"op": "capture", "name": "ev_street_orbit_after", "desc": "orbit view after leaving the eye"},
  {"op": "wind", "freeze": false},
  {"op": "wait", "s": 0.5}
 ]
}
