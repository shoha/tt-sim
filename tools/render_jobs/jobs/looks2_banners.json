   "width": 8.0,
   "depth": 8.0,
   "yaw": 0.0,
   "seed": 5,
   "decor": false
  },
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "calm", "clock": 0.0},
  {"op": "thumbnail_prepare", "zoom": 26.0, "at": [0, -12.0]},
  {"op": "settle"},
  {"op": "capture", "name": "keep_home_calm", "desc": "keep with banners, home camera, calm"},
  {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "windy", "clock": 3.0},
  {"op": "wait", "s": 0.4},
  {"op": "capture", "name": "keep_home_windy", "desc": "keep with banners, home camera, windy"}
 ]
