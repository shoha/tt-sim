{
 "out_dir": "render_jobs/firefeat_line",
 "timeout_s": 600,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 200, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "points": [[9, -28], [9, 28]], "speed": 5.0, "radius": 9.0, "flow": 2.0},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "points": [[19, 28], [19, -28]], "speed": 5.0, "radius": 9.0, "flow": 2.0},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "points": [[28, -28], [28, 28]], "speed": 5.0, "radius": 9.0, "flow": 2.0},
  {"op": "wait_ready", "settle": 1.0},

  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"fire\")"},
  {"op": "home"},
  {"op": "wait", "s": 1.0},
  {"op": "input", "events": [{"type": "move", "at": [5, 5]}, {"type": "key", "key": "tab"}, {"type": "key", "key": "tab", "pressed": false}]},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "pane_after_tab", "desc": "The Fire pane after one real Tab key: the Shape field shows Line selected (it followed the brush), the hint names Tab"},
  {"op": "eval", "expr": "_authoring_controller.panel.close()"},
  {"op": "hide_ui"},
  {"op": "eval", "expr": "_authoring_controller.brush.set_radius(2.5)"},
  {"op": "eval", "expr": "_authoring_controller.brush.mode.set(\"intensity\", 255)"},
  {"op": "look_at", "at": [3, 0]},
  {"op": "zoom", "size": 22.0},
  {"op": "wait", "s": 1.5},

  {"op": "gesture", "points": [[22, 14], [17, 10], [12, 8], [7, 7.5], [2, 5], [-3, 1], [-7, -4], [-10, -10], [-16, -14]], "speed": 6.0, "release": false},
  {"op": "wait", "s": 0.3},
  {"op": "capture", "name": "line_drag", "desc": "Mid-drag with the Line shape at zoom 22: the river's ribbon (gradient, edges, chevrons) in ember orange at the brush width, from the meadow into the forest"},
  {"op": "input", "events": [{"type": "release", "at": [-16, -14]}]},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info"},
  {"op": "wait", "s": 2.0},
  {"op": "capture", "name": "laid_day_z22", "desc": "The laid Blaze line at zoom 22, before any erase"},

  {"op": "look_at", "at": [1.5, 4.5]},
  {"op": "zoom", "size": 8.0},
  {"op": "wait", "s": 2.0},
  {"op": "gesture", "points": [[4.5, 6.2], [2, 5], [0, 3.4]], "speed": 3.0, "ctrl": true, "release": false},
  {"op": "wait", "s": 0.3},
  {"op": "capture", "name": "erase_drag", "desc": "Mid-drag of a Ctrl line over part of the fire line at zoom 8: the ribbon red, no chevrons, the ring's chip Put out fire"},
  {"op": "input", "events": [{"type": "release", "at": [0, 3.4], "ctrl": true}, {"type": "key", "key": "ctrl", "pressed": false}]},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "wait", "s": 1.0},

  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "day_home", "label": ""},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
  {"op": "wait", "s": 2.5},
  {"op": "capture", "name": "day_home", "desc": "Day, home view: the line of fire curving from the meadow into the forest, a gap put out near the forest edge"},
  {"op": "look_at", "at": [1.5, 4.5]},
  {"op": "zoom", "size": 8.0},
  {"op": "wait", "s": 3.0},
  {"op": "capture", "name": "day_z8", "desc": "Day, zoom 8 on the forest edge: fire in the meadow, the put-out gap (ash), fire in the forest with snags"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "night_home", "label": ""},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
  {"op": "home"},
  {"op": "wait", "s": 2.5},
  {"op": "capture", "name": "night_home", "desc": "Night, home view"},
  {"op": "look_at", "at": [1.5, 4.5]},
  {"op": "zoom", "size": 8.0},
  {"op": "wait", "s": 3.0},
  {"op": "capture", "name": "night_z8", "desc": "Night, zoom 8 on the forest edge"},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/firefeat_line", "out": "sheet_line", "columns": 2, "names": ["day_home", "day_z8", "night_home", "night_z8"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/firefeat_line", "out": "sheet_drag", "columns": 2, "names": ["line_drag", "laid_day_z22", "erase_drag", "pane_after_tab"], "tile": [960, 540]},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
