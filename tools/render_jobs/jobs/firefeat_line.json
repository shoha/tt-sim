{
 "out_dir": "render_jobs/firefeat_line",
 "timeout_s": 900,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "expand", "values": ["1920x1080", "1280x720"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "{value}"},
   {"op": "wait", "s": 1.0},
   {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 200, "seed": 1234},
   {"op": "wait_ready", "settle": 1.0},
   {"op": "no_autosave"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "day_home", "label": ""},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
   {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "points": [[9, -28], [9, 28]], "speed": 5.0, "radius": 9.0, "flow": 2.0},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "points": [[19, 28], [19, -28]], "speed": 5.0, "radius": 9.0, "flow": 2.0},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "points": [[28, -28], [28, 28]], "speed": 5.0, "radius": 9.0, "flow": 2.0},
   {"op": "wait_ready", "settle": 1.0},

   {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"fire\")"},
   {"op": "home"},
   {"op": "wait", "s": 1.0},
   {"op": "input", "events": [{"type": "move", "at": [5, 5]}]},
   {"op": "wait", "s": 1.0},
   {"op": "eval", "expr": "[_authoring_controller.brush.get_radius(), _authoring_controller.brush.get_flow(), _game_map.get_camera_controller().get(\"_target_zoom\")]"},
   {"op": "capture", "name": "{value}_fire_pane", "desc": "{value}: the Fire pane fresh (Area): its help naming Line and Area, the width keys, Ctrl and Tab; the Area ring at the pointer at the brush size the meadow strokes left (9 m)"},
   {"op": "input", "events": [{"type": "key", "key": "tab"}, {"type": "key", "key": "tab", "pressed": false}]},
   {"op": "wait", "s": 1.0},
   {"op": "capture", "name": "{value}_pane_after_tab", "desc": "{value}: the Fire pane after one real Tab: Line selected; the Line ring at the band its fire would stand in (line_reach of the 9 m brush), inside the Area ring's size"},
   {"op": "eval", "expr": "_authoring_controller.panel.close()"},
   {"op": "hide_ui"},
   {"op": "eval", "expr": "_authoring_controller.brush.set_radius(2.5)"},
   {"op": "eval", "expr": "_authoring_controller.brush.mode.set(\"intensity\", 255)"},
   {"op": "look_at", "at": [3, 0]},
   {"op": "zoom", "size": 22.0},
   {"op": "wait", "s": 1.5},
   {"op": "look_at", "at": [3, 0]},
   {"op": "wait", "s": 0.5},

   {"op": "gesture", "points": [[22, 14], [17, 10], [12, 8], [7, 7.5], [2, 5], [-3, 1], [-7, -4], [-10, -10], [-16, -14]], "speed": 6.0, "release": false},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag", "desc": "{value}: mid-drag with the Line shape at zoom 22, from the yellow meadow into the green forest: the ember ribbon (persimmon fill, amber edge, cream chevrons) at the band's width, chip Line of fire N ft"},
   {"op": "input", "events": [{"type": "release", "at": [-16, -14]}]},
   {"op": "wait_ready", "settle": 1.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "profile", "points": [[22, 14], [17, 10], [12, 8], [7, 7.5], [2, 5], [-3, 1], [-7, -4], [-10, -10], [-16, -14]], "every": 0.5, "across": 4.0, "radius": 2.5, "flow": 2.0},
   {"op": "wait", "s": 2.0},
   {"op": "capture", "name": "{value}_laid_day_z22", "desc": "{value}: the laid Blaze line at zoom 22, before any erase: its flames should fill the band the ribbon showed"},

   {"op": "look_at", "at": [1.5, 4.5]},
   {"op": "zoom", "size": 8.0},
   {"op": "wait", "s": 2.0},
   {"op": "look_at", "at": [1.5, 4.5]},
   {"op": "wait", "s": 0.5},
   {"op": "eval", "expr": "_authoring_controller.brush.mode.set(\"put_out_tint\", Color(\"#887A8E\"))"},
   {"op": "gesture", "points": [[4.5, 6.2], [2, 5], [0, 3.4]], "speed": 3.0, "ctrl": true, "release": false},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_erase_drag_a", "desc": "{value}: mid-drag of a Ctrl line over the blaze at zoom 8, interior (a) the ash plum-grey (ThemeColors.PAPER_TRACK) at the lay's coverage, salmon edge and chevrons on ink, round ends, chip Put out fire N ft"},
   {"op": "eval", "expr": "_authoring_controller.brush.mode.set(\"put_out_tint\", Color(\"#2A6880\"))"},
   {"op": "eval", "expr": "_authoring_controller.brush.redraw()"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_erase_drag_b", "desc": "{value}: the same drag, interior (b) the lake (ThemeColors.LAKE, water on fire), the same salmon edge and chevrons"},   {"op": "input", "events": [{"type": "release", "at": [0, 3.4], "ctrl": true}, {"type": "key", "key": "ctrl", "pressed": false}]},
   {"op": "wait_ready", "settle": 1.0},

   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "night_home", "label": ""},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
   {"op": "look_at", "at": [14, -12]},
   {"op": "zoom", "size": 22.0},
   {"op": "wait", "s": 2.0},
   {"op": "look_at", "at": [14, -12]},
   {"op": "wait", "s": 0.5},
   {"op": "gesture", "points": [[30, -6], [24, -10], [18, -12], [12, -14], [6, -16], [0, -19]], "speed": 6.0, "release": false},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_night", "desc": "{value}: at night (the outdoor_night preset), mid-drag with the Line shape from the meadow toward the forest at zoom 22, the laid line burning to the left: the ember ribbon must still glow, not dirty"},
   {"op": "input", "events": [{"type": "key", "key": "escape"}, {"type": "key", "key": "escape", "pressed": false}, {"type": "release", "at": [0, -19]}]},
   {"op": "wait", "s": 0.5},

   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "sunset_home", "label": ""},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
   {"op": "look_at", "at": [14, -12]},
   {"op": "zoom", "size": 22.0},
   {"op": "wait", "s": 2.0},
   {"op": "look_at", "at": [14, -12]},
   {"op": "wait", "s": 0.5},
   {"op": "gesture", "points": [[30, -6], [24, -10], [18, -12], [12, -14], [6, -16], [0, -19]], "speed": 6.0, "release": false},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_dusk", "desc": "{value}: under the outdoor_sunset preset at dusk, the same Line drag at zoom 22: the ember ribbon must glow in the warm low light, not turn brown"},
   {"op": "input", "events": [{"type": "key", "key": "escape"}, {"type": "key", "key": "escape", "pressed": false}, {"type": "release", "at": [0, -19]}]},
   {"op": "wait", "s": 0.5},
   {"op": "title"},
   {"op": "wait", "s": 1.0}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "1920x1080"},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/firefeat_line", "out": "sheet_1920", "columns": 2, "names": ["1920x1080_line_drag", "1920x1080_line_drag_night", "1920x1080_line_drag_dusk", "1920x1080_laid_day_z22", "1920x1080_erase_drag_a", "1920x1080_erase_drag_b"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/firefeat_line", "out": "sheet_720", "columns": 2, "names": ["1280x720_line_drag", "1280x720_line_drag_night", "1280x720_line_drag_dusk", "1280x720_laid_day_z22", "1280x720_erase_drag_a", "1280x720_erase_drag_b"], "tile": [640, 360]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/firefeat_line", "out": "sheet_water", "columns": 2, "names": ["water_before/water_pane", "water_after/water_pane", "water_before/river_drag", "water_after/river_drag"], "tile": [960, 540]},
  {"op": "wait", "s": 1.0}
 ]
}
