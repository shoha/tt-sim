{
  "out_dir": "render_jobs/perf3_village",
  "timeout_s": 420,
  "hang_s": 120,
  "remove_override": true,
  "steps": [
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 320, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
    {"op": "look_at", "at": [0, 0]},
    {"op": "zoom", "size": 60.0},
    {"op": "vsync_off"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "idle"},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "base"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "mem", "name": "base"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "base_a"},
    {"op": "wait", "s": 4.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structure_perf3.gd", "action": "load", "count": 128},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/structure_perf3.gd", "action": "fill", "from": 0, "to": 100},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/structure_perf3.gd", "action": "hitch_start", "from": 100, "count": 20, "interval": 0.5},
    {"op": "wait", "s": 11.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/structure_perf3.gd", "action": "hitch_stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structure_perf3.gd", "action": "fill", "from": 120, "to": 127},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/structure_perf3.gd", "action": "cap"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structure_perf3.gd", "action": "fill", "from": 126, "to": 128},
    {"op": "wait", "s": 3.0},
    {"op": "capture", "name": "01_v128_home", "desc": "128 structures, home zoom"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "v128_home"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "mem", "name": "v128"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "v128_home"},
    {"op": "wait", "s": 5.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structure_perf3.gd", "action": "consumers", "n": 300},
    {"op": "zoom", "size": 20.0},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "v128_close"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "v128_close"},
    {"op": "wait", "s": 5.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structure_perf3.gd", "action": "reset"},
    {"op": "wait", "s": 2.0},
    {"op": "zoom", "size": 60.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "base_b"},
    {"op": "wait", "s": 4.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "title"}
  ]
}
