{
 "out_dir": "render_jobs/arch_ford_tools",
 "timeout_s": 480,
 "hang_s": 90,
 "saved": {"folder": "_p4d_tools", "load": "dress"},
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [0, 0], "phase": "build"},
  {"op": "zoom", "size": 20.0, "phase": "build"},
  {"op": "wait", "s": 1.5, "phase": "build"},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 4.0, "points": [[-7, -12], [-7, 12]], "phase": "build"},
  {"op": "wait_ready", "settle": 0.5, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "carve", "points": [[8, -10], [8, 10]], "half_width": 1.2, "depth": "deep", "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()", "phase": "build"},
  {"op": "wait_ready", "settle": 0.5, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p4d_tools", "replace": true, "phase": "build"},

  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"bridge\")"},
  {"op": "bridge_kind", "kind": "arch"},
  {"op": "home", "phase": "look", "for": "pane"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "pane"},
  {"op": "capture", "name": "pane", "desc": "The Bridge pane: Planks, Stones, Arch and Ford tiles in one row, Arch selected; the hint says arches cross like planks and a ford needs wadeable water"},
  {"op": "eval", "expr": "_authoring_controller.panel.close()"},
  {"op": "hide_ui"},

  {"op": "look_at", "at": [-7, 2], "phase": "look", "for": "arch_*,ctrl_hover"},
  {"op": "zoom", "size": 10.0, "phase": "look", "for": "arch_*,ctrl_hover"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "arch_*,ctrl_hover"},
  {"op": "gesture", "points": [[-11, 2], [-3, 2]], "speed": 3.0, "release": false, "phase": "look", "for": "arch_*,ctrl_hover"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "arch_*,ctrl_hover"},
  {"op": "capture", "name": "arch_drag", "desc": "An Arch line held across the waist river at z = 2: the pale stone ghost of the deck along its arch with a dot on each bank, and the readout 'Stone arch  N ft'"},
  {"op": "input", "events": [{"type": "release", "at": [-3, 2]}], "phase": "look", "for": "arch_placed,ctrl_hover"},
  {"op": "wait_ready", "settle": 0.5, "phase": "look", "for": "arch_placed,ctrl_hover"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "list", "phase": "look", "for": "arch_placed,ctrl_hover"},
  {"op": "capture", "name": "arch_placed", "desc": "Released: the stone arch bank to bank over the waist river, idle readout 'Stone arch  6.5 ft wide'"},

  {"op": "bridge_kind", "kind": "ford", "phase": "look", "for": "ford_*"},
  {"op": "look_at", "at": [8, 0], "phase": "look", "for": "ford_refused*"},
  {"op": "zoom", "size": 10.0, "phase": "look", "for": "ford_refused*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "ford_refused*"},
  {"op": "gesture", "points": [[4, 0], [12, 0]], "speed": 3.0, "release": false, "phase": "look", "for": "ford_refused*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "ford_refused*"},
  {"op": "capture", "name": "ford_refused", "desc": "A Ford line held across the deep river at z = 0: drawn red and heavier with a dot at both ends, and 'Too deep to ford. Fords cross wadeable water.' beside the cursor"},
  {"op": "input", "events": [{"type": "release", "at": [12, 0]}], "phase": "look", "for": "ford_refused*"},
  {"op": "wait", "s": 0.4, "phase": "look", "for": "ford_refused*"},
  {"op": "capture", "name": "ford_refused_toast", "desc": "Released there: nothing is placed and the toast says why"},

  {"op": "look_at", "at": [-7, -5], "phase": "look", "for": "ford_placed"},
  {"op": "zoom", "size": 10.0, "phase": "look", "for": "ford_placed"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "ford_placed"},
  {"op": "gesture", "points": [[-11, -5], [-3, -5]], "speed": 3.0, "phase": "look", "for": "ford_placed"},
  {"op": "wait_ready", "settle": 0.5, "phase": "look", "for": "ford_placed"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "list", "phase": "look", "for": "ford_placed"},
  {"op": "capture", "name": "ford_placed", "desc": "A Ford line across the waist river at z = -5, released: the gravel bar under the surface with its marker stones and landings, idle readout 'Ford  8 ft wide', and any toast still showing"},

  {"op": "look_at", "at": [-7, 2], "phase": "look", "for": "ctrl_hover"},
  {"op": "zoom", "size": 10.0, "phase": "look", "for": "ctrl_hover"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "ctrl_hover"},
  {"op": "input", "events": [{"type": "move", "at": [-7, 2.0]}, {"type": "key", "key": "ctrl", "pressed": true}, {"type": "move", "at": [-7, 2.1], "ctrl": true}], "phase": "look", "for": "ctrl_hover"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "ctrl_hover"},
  {"op": "capture", "name": "ctrl_hover", "desc": "Ctrl held over the arch: its deck outlined in red with 'Remove stone arch'"},
  {"op": "input", "events": [{"type": "move", "at": [-7, 2.0]}, {"type": "key", "key": "ctrl", "pressed": false}], "phase": "look", "for": "ctrl_hover"},

  {"op": "index", "title": "P4d-3 Arch and Ford tiles", "intro": "Produced by tools/render_jobs/jobs/arch_ford_tools.json at 1920x1080. A new 150 ft temperate forest map (seed 1234) with a straight waist river at x = -7 and a deep river carved at x = 8, saved as _p4d_tools. Then through the real Bridge tool (bridge_kind, gesture, input): the pane with its four tiles and Arch selected; an arch held across the waist river at z = 2 (ghost and readout) and released; a ford held across the deep river at z = 0 (red line, the deep refusal beside the cursor) and released (toast); a ford across the waist river at z = -5, released; Ctrl held over the arch (the removal readout). The level is kept for look runs."},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
