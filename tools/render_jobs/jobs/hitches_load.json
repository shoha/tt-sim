{
  "out_dir": "render_jobs/hitches_load",
  "timeout_s": 300,
  "hang_s": 90,
  "remove_override": true,
  "steps": [
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 300, "seed": 1234},
    {"op": "wait_ready", "settle": 1.5},
    {"op": "no_autosave"},
    {"op": "vsync_off"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "many", "count": 44},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "save"},
    {"op": "title"},
    {"op": "wait_title"},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "load_44"},
    {"op": "dress", "folder": "_hitches_load"},
    {"op": "wait", "s": 12.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "split"},
    {"op": "title"},
    {"op": "wait_title"},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "load_44_again"},
    {"op": "dress", "folder": "_hitches_load"},
    {"op": "wait", "s": 12.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "cleanup"},
    {"op": "title"}
  ]
}
