{
 "out_dir": "render_jobs/collshape_look",
 "timeout_s": 600,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar_token.gd", "action": "save", "folder": "_avatartoken_collshape", "replace": true},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "play", "folder": "_avatartoken_collshape"},
  {"op": "wait", "s": 3.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/rosterfolk.gd", "action": "row", "pack": "beasts", "ids": ["horse", "pig", "sheep", "wolf"], "at": [-4.5, -2.0], "spacing": 3.0, "per_row": 4},
  {"op": "call", "script": "res://tools/render_jobs/probes/rosterfolk.gd", "action": "row", "pack": "folk", "ids": ["villager_man", "scout_woman"], "at": [-4.5, 2.0], "spacing": 3.0, "per_row": 2},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "tokens", "from": [1.5, 2], "to": [4.5, 2], "items": ["chunky:0", "chunky:1"]},
  {"op": "wait", "s": 5.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/collshape.gd", "action": "debug", "on": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/collshape.gd", "action": "report"},
  {"op": "look_at", "at": [0.0, 0.0]},
  {"op": "zoom", "size": 11.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": 35},
  {"op": "settle"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "cs_row", "desc": "Pitch 35: horse, pig, sheep, wolf (back row), a villager and a scout, two chunky models; red wire = collision shape"},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": 75},
  {"op": "settle"},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "cs_pin_p75", "desc": "Pitch 75: the same tokens with their pins; the pin tail should land on the shape's far edge"},
  {"op": "call", "script": "res://tools/render_jobs/probes/collshape.gd", "action": "table", "at": [8.0, -2.0]},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/collshape.gd", "action": "put", "at": [8.0, -2.0], "token": "Pig"},
  {"op": "call", "script": "res://tools/render_jobs/probes/collshape.gd", "action": "onto", "token": "Sheep", "target": "Horse"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/collshape.gd", "action": "report"},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": 28},
  {"op": "look_at", "at": [2.0, -2.0]},
  {"op": "settle"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "cs_drop", "desc": "Pitch 28: the pig on a 0.75 m table at right, the sheep set on the horse's top (the box tops are the visible backs)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/collshape.gd", "action": "debug", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": 30},
  {"op": "look_at", "at": [-1.5, -2.0]},
  {"op": "zoom", "size": 5.0},
  {"op": "settle"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "cs_plain", "desc": "Pitch 30, no wires: the pig on its own and the horse with the sheep set on its back, for the models alone"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar_token.gd", "action": "cleanup"},
  {"op": "title"},
  {"op": "index", "title": "collshape_look", "intro": "Pack token collision shapes (red wire) over the models"}
 ]
}
