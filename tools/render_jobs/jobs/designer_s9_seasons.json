{
 "out_dir": "render_jobs/designer-s9_seasons",
 "timeout_s": 600,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "wait_title"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "open", "library": "core", "biome": "temperate_forest"},
  {"op": "wait_ready", "settle": 3.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/tree_fade.gd", "factor": 0},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "debounce", "seconds": 0.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1600, 900]},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "surfaces"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "state"},
  {"op": "capture", "name": "a_summer", "desc": "summer: the biome as the library ships it (one season)"},

  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "add_season", "id": "autumn"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "add_season", "id": "winter"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season_density", "season": "winter", "size_class": "large", "scale": 0.4},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season_rule", "season": "winter", "rule": "grass", "field": "density_factor", "value": 0.15},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season_hide", "season": "winter", "rule": "birch", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season_ground", "season": "winter", "field": "surface", "surface": "gravel"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season_ground", "season": "autumn", "field": "surface", "surface": "sand_red"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season_rule", "season": "autumn", "rule": "oak", "field": "density_factor", "value": 0.6},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "look_color", "season": "autumn", "index": 0, "hex": "#b8722a"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "look_color", "season": "autumn", "index": 1, "hex": "#8a3b1d"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "look_color", "season": "autumn", "index": 2, "hex": "#c9a04a"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "look_color", "season": "autumn", "index": 3, "hex": "#7a4a2a"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "look_color", "season": "winter", "index": 0, "hex": "#dfe6ea"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "look_color", "season": "winter", "index": 1, "hex": "#b9c4cc"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "look_color", "season": "winter", "index": 2, "hex": "#f2f5f7"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "look_color", "season": "winter", "index": 3, "hex": "#9aa7b0"},
  {"op": "wait", "s": 1.5},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "state"},
  {"op": "capture", "name": "b_three_seasons_summer", "desc": "autumn and winter added with changes; summer still on the map and unchanged"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season", "id": "autumn"},
  {"op": "wait", "s": 2.5},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "season switch to autumn"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "state"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "select", "rule": "oak"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "section", "name": "Seasons"},
  {"op": "wait", "s": 0.8},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "inspector_scroll"},
  {"op": "wait", "s": 0.5},
  {"op": "capture", "name": "c_autumn", "desc": "autumn: red sand ground, the oak rule thinned to 0.6 (its Seasons section shows it in the inspector)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season", "id": "winter"},
  {"op": "wait", "s": 2.5},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "season switch to winter"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "state"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "select", "rule": "grass"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "section", "name": "Seasons"},
  {"op": "wait", "s": 0.8},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "inspector_scroll"},
  {"op": "wait", "s": 0.5},
  {"op": "capture", "name": "d_winter", "desc": "winter: gravel ground, large trees at 0.4, no birches, grass at 0.15 (the grass rule's Seasons section)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "focus", "rule": "no_such_rule"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "d2_winter_bare", "desc": "winter with every plant hidden (the focus on a rule that is not there): the ground alone"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "focus", "rule": ""},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1280, 800]},
  {"op": "wait", "s": 1.0},
  {"op": "settle"},
  {"op": "capture", "name": "e_winter_1280", "desc": "winter at 1280x800"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season", "id": "summer"},
  {"op": "wait", "s": 2.5},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "state"},
  {"op": "capture", "name": "f_back_to_summer", "desc": "back to summer: the same map as a_summer"},
  {"op": "title"}, {"op": "wait", "s": 1.0}
 ]
}
