{
 "out_dir": "render_jobs/p5_perf",
 "timeout_s": 900,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "strokes start"},

  {"op": "expand", "values": ["terraces", "flat"], "template": [
   {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 3, "landform": "{value}"},
   {"op": "wait_ready", "settle": 1.0},
   {"op": "no_autosave"},
   {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
   {"op": "look_at", "at": [-0.5, -2]},
   {"op": "zoom", "size": 20.0},
   {"op": "wait", "s": 1.5},
   {"op": "hide_ui"},
   {"op": "vsync_off"},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "record", "on": true, "name": "{value}_idle"},
   {"op": "wait", "s": 4.0},
   {"op": "record", "on": false},
   {"op": "record", "on": true, "name": "{value}_raise_stage"},
   {"op": "stroke", "mode": "sculpt", "tile": "raise", "points": [[-0.5, 0], [-0.5, 0]], "radius": 4.0, "speed": 3.0, "hold": 2.0},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "record", "on": false},
   {"op": "record", "on": true, "name": "{value}_smooth_face"},
   {"op": "stroke", "mode": "sculpt", "tile": "smooth", "points": [[1, -11], [1, -5]], "radius": 2.5, "speed": 2.0},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "record", "on": false},
   {"op": "record", "on": true, "name": "{value}_river"},
   {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 4.0, "points": [[6, -12], [6, 8]]},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "record", "on": false},
   {"op": "call", "script": "res://tools/render_jobs/probes/falls.gd", "action": "falls"},
   {"op": "record", "on": true, "name": "{value}_river_erase"},
   {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 4.0, "ctrl": true, "points": [[6, -12], [6, 8]]},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "record", "on": false},
   {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p5_perf_{value}", "replace": true},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "mem", "name": "{value} authoring", "ws": true},
   {"op": "home"},
   {"op": "wait", "s": 1.5},
   {"op": "capture", "name": "perf_{value}_home", "desc": "The {value} stroke map (forest, 150 ft, seed 3) after a Raise on the stage, a Smooth over the north step, a waist river at x 6 drawn and erased"},
   {"op": "title"},
   {"op": "wait", "s": 1.0}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "strokes end"}
 ]
}
