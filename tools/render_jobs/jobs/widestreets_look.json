{
 "out_dir": "render_jobs/widestreets_look",
 "timeout_s": 900,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_widestreets_look", "load": "play"},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 320, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-28, -40], "to": [28, -40], "preset": 11, "seed": 1, "setback": "tool", "side": 0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-28, 0], "to": [28, 0], "preset": 11, "seed": 14, "setback": "tool", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [28, 40], "to": [-28, 40], "preset": 11, "seed": 6, "setback": "tool", "side": 0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "modern_town", "wealth": 0.6, "density": 1.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "modern_town", "wealth": 0.7, "density": 1.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 3, "kit": "modern_town", "wealth": 0.8, "density": 1.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "report", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_widestreets_look", "replace": true, "phase": "build"},
  {"op": "play", "folder": "_widestreets_look", "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [2, 40], "preset": 0, "yaw": 90},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [3.5, 42.4], "preset": 1, "yaw": 90},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [2, 46.3], "preset": 2, "yaw": 0},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [5, 33.8], "preset": 3, "yaw": 180},
  {"op": "hide_ui"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 90.0},
  {"op": "settle"},
  {"op": "capture", "name": "a_village_home", "desc": "three Modern streets along x, 40 m apart (z -40, 0, 40; the outer two built on their inner side only, the 320 ft map ends 8 m past them), Street tool setback 8.4 m: road 8.6 m between 4.1 m pavements. The fixed camera looks from +z: the z 40 street's road lies in front of its row, the z -40 street's behind its row"},
  {"op": "zoom", "size": 30.0},
  {"op": "look_at", "at": [0, 38]},
  {"op": "settle"},
  {"op": "capture", "name": "b_street_home", "desc": "the z 40 street at home zoom, its row on the far (-z) side: road, both pavements, cars, furniture, four tokens"},
  {"op": "zoom", "size": 12.0},
  {"op": "look_at", "at": [3, 40]},
  {"op": "settle"},
  {"op": "capture", "name": "c_cross_section", "desc": "close: tokens on the centre line (2,40), the near lane (3.5,42.4), the outer pavement (2,46.3) and the pavement by the facades (5,33.8)"},
  {"op": "zoom", "size": 20.0},
  {"op": "look_at", "at": [-24, 38]},
  {"op": "settle"},
  {"op": "capture", "name": "d_street_end", "desc": "the west end of the z 40 street (drawn east to west): the corner lot and the road's end"},
  {"op": "zoom", "size": 30.0},
  {"op": "look_at", "at": [0, 0]},
  {"op": "settle"},
  {"op": "capture", "name": "e_street_both_sides", "desc": "the z 0 street, built on both sides, at home zoom: how much of the road the near (+z) row hides"},
  {"op": "index", "title": "widestreets look", "intro": "Modern streets widened to a two-lane road between 4.1 m pavements (StreetProfile), asphalt repainted as tarmac, procgen dc515a9"}
 ]
}
