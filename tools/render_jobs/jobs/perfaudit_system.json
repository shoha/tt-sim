{
  "out_dir": "render_jobs/perfaudit_system",
  "timeout_s": 1500,
  "hang_s": 120,
  "steps": [
    {"op": "wait_title"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "boot"},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "census", "name": "title", "ws": true, "textures": true},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "frames", "name": "title_idle", "s": 5.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "await"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "serve", "runs": 3},
    {"op": "expand", "values": ["100", "200", "320"], "template": [
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "load", "new": {"biome": "temperate_forest_summer_s1", "size": "{value}", "seed": 1234, "landform": "flat"}, "ws": true},
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "await"},
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "await"},
      {"op": "no_autosave"},
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "census", "name": "author_{value}"},
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "save", "folder": "_perfaudit_sys_{value}"},
      {"op": "title"},
      {"op": "wait", "s": 1.5},
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "census", "name": "title_after_author_{value}", "ws": true}
    ]},
    {"op": "expand", "values": ["100", "200", "320", "100", "200", "320"], "template": [
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "load", "folder": "_perfaudit_sys_{value}", "mode": "play", "ws": true},
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "await"},
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "await"},
      {"op": "wait", "s": 2.0},
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "census", "name": "play_{value}", "textures": true},
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "frames", "name": "play_idle_{value}", "s": 8.0},
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "await"},
      {"op": "title"},
      {"op": "wait", "s": 1.5},
      {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "census", "name": "title_after_play_{value}", "ws": true}
    ]},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "load", "folder": "_perfaudit_sys_200", "mode": "play"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "await"},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "cpu", "name": "play_200_windowed", "s": 10.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "await"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "window", "mode": "minimized"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "cpu", "name": "play_200_minimized", "s": 10.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "await"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "window", "mode": "windowed"},
    {"op": "wait", "s": 1.0},
    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "cpu", "name": "title_windowed", "s": 10.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "await"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "cleanup"}
  ]
}
