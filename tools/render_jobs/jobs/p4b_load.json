  {"op": "wait_ready", "settle": 0.3},
  {"op": "stroke", "mode": "water", "shape": "pond", "depth": "waist", "radius": 2.4, "speed": 2.5, "points": [[12.5, 11.5], [15, 14], [17, 15]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
