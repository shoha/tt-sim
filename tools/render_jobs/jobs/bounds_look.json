  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "boundary", "id": 1, "kind": "hedge"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "boundary", "id": 2, "kind": "low_wall"},
