    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "census", "name": "title", "ws": true},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "profiler", "on": true},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "load", "new": {"biome": "temperate_forest_summer_s1", "size": 200, "seed": 1234, "landform": "valley"}, "ws": true},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "await"},
