    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "census", "name": "title_after_author", "ws": true},
    {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_system.gd", "action": "drop_caches"},
