{
 "out_dir": "render_jobs/camera_rig_town",
 "timeout_s": 900,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_camera_fantasy", "load": "play"},
  {"op": "new_map", "biome": "", "size": 250, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_camera_fantasy", "replace": true, "phase": "build"},
  {"op": "play", "folder": "_camera_fantasy", "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 34.0},
  {"op": "settle"},
  {"op": "expand", "values": ["45", "135", "225", "315"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "yaw", "deg": "{value}"},
   {"op": "settle"},
   {"op": "capture", "name": "town_y{value}", "desc": "farming hamlet and market town, camera azimuth {value}, sun fixed in the world, size 34, compass top right"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "yaw", "deg": 45},
  {"op": "settle"},
  {"op": "wind", "freeze": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "clip", "name": "town_snap", "dir": "user://render_jobs/camera_rig_town/town_snap", "seconds": 3.0, "lead": 0.5, "turn": 1, "fps": 30, "width": 960},
  {"op": "wait", "s": 3.5},
  {"op": "index", "title": "camera rig town", "intro": "Camera rig card 1: snap yaw, hamlet and market town"},
  {"op": "title"},
  {"op": "wait", "s": 0.5}
 ]
}
