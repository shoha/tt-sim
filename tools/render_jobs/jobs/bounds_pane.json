{
 "out_dir": "render_jobs/bounds_pane",
 "timeout_s": 900,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 320, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 60.0},
  {"op": "wait", "s": 1.0},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-30, -15], "to": [-30, 15], "preset": 3, "seed": 21},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [0, -15], "to": [0, 15], "preset": 2, "seed": 31},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [30, -15], "to": [30, 15], "preset": 4, "seed": 41},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.5, "density": 0.9},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 3, "kit": "hill_fort_village", "wealth": 0.5, "density": 0.9},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"village\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "pick", "id": 1},
  {"op": "input", "events": [{"type": "move", "at": [-90, -60]}]},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1280, 720]},
  {"op": "settle"},
  {"op": "capture", "name": "a_pane_auto", "desc": "1280x720: three villages, village 1 (farming hamlet) picked; the Boundary row under the character tiles reads Automatic with the kit's own pick named"},
  {"op": "eval", "expr": "_authoring_controller.panel.find_child(\"VillageBoundary\", true, false).select(4)"},
  {"op": "eval", "expr": "_authoring_controller.panel.find_child(\"VillageBoundary\", true, false).item_selected.emit(4)"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "settle"},
  {"op": "capture", "name": "b_pane_wall", "desc": "1280x720: village 1 switched to Wall from the dropdown; the pane shows Wall"},
  {"op": "eval", "expr": "_authoring_controller.panel.find_child(\"VillageBoundary\", true, false).get_global_rect()"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "pick", "id": 2},
  {"op": "settle"},
  {"op": "eval", "expr": "_authoring_controller.panel.find_child(\"VillageBoundary\", true, false).select(2)"},
  {"op": "eval", "expr": "_authoring_controller.panel.find_child(\"VillageBoundary\", true, false).item_selected.emit(2)"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "settle"},
  {"op": "capture", "name": "c_pane_hedge", "desc": "1280x720: village 2 (market town) switched to Hedge; the pane shows Hedge"},
  {"op": "eval", "expr": "[_authoring_controller.panel.find_child(\"VillagePane\", true, false).get_global_rect(), get_viewport().get_visible_rect()]"},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "hide_ui"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 60.0},
  {"op": "wait_ready", "settle": 1.5},
  {"op": "settle"},
  {"op": "capture", "name": "d_home", "desc": "home zoom: village 1 (left) in a stone wall by the pane's Wall, village 2 (middle) in a hedge by the pane's Hedge, village 3 (right) the hill fort on Automatic (its own wall)"},
  {"op": "index", "title": "bounds pane", "intro": "The Village pane's Boundary dropdown: Automatic, None, Hedge, Low wall, Wall. The pane at 720p with three villages, then home zoom with village 1 switched to Wall and village 2 to Hedge."}
 ]
}
