{
 "out_dir": "render_jobs/pol_trees",
 "timeout_s": 600,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_pol_forest"},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [0, 0], "phase": "build"},
  {"op": "zoom", "size": 20.0, "phase": "build"},
  {"op": "wait", "s": 1.5, "phase": "build"},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 4.0, "points": [[-9, -14], [-9, 14]], "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()", "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_pol_forest", "replace": true, "phase": "build"},
  {"op": "hide_ui"},

  {"op": "zoom", "size": 20.0, "phase": "look", "for": "f_a_z20"},
  {"op": "look_at", "at": [0, 0], "phase": "look", "for": "f_a_z20"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_a_z20"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "phase": "look", "for": "f_a_z20"},
  {"op": "capture", "name": "f_a_z20", "desc": "Forest, zoom 20 at (0, 0)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "near", "near": 0.001, "phase": "look", "for": "f_a_z20_old"},
  {"op": "capture", "name": "f_a_z20_old", "desc": "The same with the near plane where it was before the canopy hold (0.001 in front of the camera)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "hold", "phase": "look", "for": "f_a_z20_old"},

  {"op": "zoom", "phase": "look", "for": "f_out*"},
  {"op": "wait", "s": 2.5, "phase": "look", "for": "f_out*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "phase": "look", "for": "f_out*"},
  {"op": "capture", "name": "f_out", "desc": "Authoring, full zoom-out: the whole map with its river, skirt and backdrop (near plane behind the camera, far 1000)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "f_out_grid"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "f_out_grid"},
  {"op": "capture", "name": "f_out_grid", "desc": "Full zoom-out with the grid"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "near", "near": 0.001, "phase": "look", "for": "f_out_grid_old"},
  {"op": "capture", "name": "f_out_grid_old", "desc": "Full zoom-out with the grid, near plane as before"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "hold", "phase": "look", "for": "f_out_grid_old"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "f_out_grid"},

  {"op": "zoom", "size": 13.85, "phase": "look", "for": "f_a_z13*"},
  {"op": "look_at", "at": [0, 0], "phase": "look", "for": "f_a_z13*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_a_z13*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "phase": "look", "for": "f_a_z13*"},
  {"op": "capture", "name": "f_a_z13", "desc": "Forest, home zoom 13.85 at (0, 0)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "near", "near": 0.001, "phase": "look", "for": "f_a_z13_old"},
  {"op": "capture", "name": "f_a_z13_old", "desc": "Home zoom with the near plane where it was before the canopy hold: the trees at the bottom edge cut away"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "hold", "phase": "look", "for": "f_a_z13_old"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "back", "d": 40.0, "phase": "look", "for": "f_a_z13_back"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "f_a_z13_back"},
  {"op": "capture", "name": "f_a_z13_back", "desc": "Forest, home zoom at (0, 0), camera 40 m back along its view axis (same frame, no near-plane cut)"},

  {"op": "zoom", "size": 12.0, "phase": "look", "for": "f_a_z12"},
  {"op": "look_at", "at": [0, 0], "phase": "look", "for": "f_a_z12"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_a_z12"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "phase": "look", "for": "f_a_z12"},
  {"op": "capture", "name": "f_a_z12", "desc": "Forest, zoom 12 at (0, 0)"},

  {"op": "zoom", "size": 10.0, "phase": "look", "for": "f_a_z10"},
  {"op": "look_at", "at": [0, 0], "phase": "look", "for": "f_a_z10"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_a_z10"},
  {"op": "capture", "name": "f_a_z10", "desc": "Forest, zoom 10 at (0, 0)"},

  {"op": "zoom", "size": 8.0, "phase": "look", "for": "f_a_z8*"},
  {"op": "look_at", "at": [0, 0], "phase": "look", "for": "f_a_z8*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_a_z8*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "phase": "look", "for": "f_a_z8*"},
  {"op": "capture", "name": "f_a_z8", "desc": "Forest, zoom 8 at (0, 0)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "back", "d": 40.0, "phase": "look", "for": "f_a_z8_back"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "f_a_z8_back"},
  {"op": "capture", "name": "f_a_z8_back", "desc": "Forest, zoom 8 at (0, 0), camera 40 m back"},

  {"op": "zoom", "size": 6.0, "phase": "look", "for": "f_a_z6*"},
  {"op": "look_at", "at": [0, 0], "phase": "look", "for": "f_a_z6*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_a_z6*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "phase": "look", "for": "f_a_z6*"},
  {"op": "capture", "name": "f_a_z6", "desc": "Forest, zoom 6 at (0, 0)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false, "phase": "look", "for": "f_a_z6_nofade"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "f_a_z6_nofade"},
  {"op": "capture", "name": "f_a_z6_nofade", "desc": "Forest, zoom 6 at (0, 0), camera held back but the canopy fade off: the wall of leaves the fade removes"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": true, "phase": "look", "for": "f_a_z6_nofade"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "scatter", "visible": false, "phase": "look", "for": "f_a_z6_noscatter"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "f_a_z6_noscatter"},
  {"op": "capture", "name": "f_a_z6_noscatter", "desc": "Forest, zoom 6 at (0, 0), scatter hidden: the ground under the trees"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "scatter", "visible": true, "phase": "look", "for": "f_a_z6_noscatter"},

  {"op": "zoom", "size": 4.0, "phase": "look", "for": "f_a_z4"},
  {"op": "look_at", "at": [0, 0], "phase": "look", "for": "f_a_z4"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_a_z4"},
  {"op": "capture", "name": "f_a_z4", "desc": "Forest, zoom 4 at (0, 0)"},

  {"op": "zoom", "size": 2.0, "phase": "look", "for": "f_a_z2*"},
  {"op": "look_at", "at": [0, 0], "phase": "look", "for": "f_a_z2*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_a_z2*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "phase": "look", "for": "f_a_z2*"},
  {"op": "capture", "name": "f_a_z2", "desc": "Forest, minimum zoom 2 at (0, 0)"},

  {"op": "zoom", "size": 8.0, "phase": "look", "for": "f_b_z8"},
  {"op": "look_at", "at": [9, -7], "phase": "look", "for": "f_b_z8"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_b_z8"},
  {"op": "capture", "name": "f_b_z8", "desc": "Forest, zoom 8 at (9, -7), inside a grove"},
  {"op": "zoom", "size": 6.0, "phase": "look", "for": "f_b_z6*,f_gpu"},
  {"op": "look_at", "at": [9, -7], "phase": "look", "for": "f_b_z6*,f_gpu"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_b_z6*,f_gpu"},
  {"op": "capture", "name": "f_b_z6", "desc": "Forest, zoom 6 at (9, -7), inside a grove"},
  {"op": "vsync_off", "phase": "look", "for": "f_gpu"},
  {"op": "gpu", "name": "fade_on_1", "s": 3.0, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false, "phase": "look", "for": "f_gpu"},
  {"op": "gpu", "name": "fade_off_1", "s": 3.0, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": true, "phase": "look", "for": "f_gpu"},
  {"op": "gpu", "name": "fade_on_2", "s": 3.0, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false, "phase": "look", "for": "f_gpu"},
  {"op": "gpu", "name": "fade_off_2", "s": 3.0, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": true, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "near", "near": 0.001, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false, "phase": "look", "for": "f_gpu"},
  {"op": "gpu", "name": "old_near_no_fade", "s": 3.0, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": true, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "hold", "phase": "look", "for": "f_gpu"},
  {"op": "zoom", "size": 13.85, "phase": "look", "for": "f_gpu"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_gpu"},
  {"op": "gpu", "name": "home_on", "s": 3.0, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false, "phase": "look", "for": "f_gpu"},
  {"op": "gpu", "name": "home_off", "s": 3.0, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "near", "near": 0.001, "phase": "look", "for": "f_gpu"},
  {"op": "gpu", "name": "home_old_near", "s": 3.0, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "hold", "phase": "look", "for": "f_gpu"},
  {"op": "gpu", "name": "home_hold", "s": 3.0, "phase": "look", "for": "f_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": true, "phase": "look", "for": "f_gpu"},

  {"op": "zoom", "size": 6.0, "phase": "look", "for": "f_river_z6*"},
  {"op": "look_at", "at": [-9, 2], "phase": "look", "for": "f_river_z6*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_river_z6*"},
  {"op": "capture", "name": "f_river_z6", "desc": "Forest, zoom 6 on the waist river at (-9, 2): the water's depth reads with the camera held back"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "f_river_z6_grid"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "f_river_z6_grid"},
  {"op": "capture", "name": "f_river_z6_grid", "desc": "The same with the grid on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "near", "near": 0.001, "phase": "look", "for": "f_river_z6_grid_old"},
  {"op": "capture", "name": "f_river_z6_grid_old", "desc": "The same with the near plane where it was before the canopy hold"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "f_river_z6_grid"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "f_river_z6_old"},
  {"op": "capture", "name": "f_river_z6_old", "desc": "Grid off, near plane as before"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "hold", "phase": "look", "for": "f_river_z6_grid_old"},

  {"op": "zoom", "size": 6.0, "phase": "look", "for": "f_thin_z6"},
  {"op": "look_at", "at": [9, -7], "phase": "look", "for": "f_thin_z6"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "f_thin_z6"},
  {"op": "stroke", "mode": "thin", "radius": 2.0, "points": [[11, -4], [11.5, -4]], "release": false, "phase": "look", "for": "f_thin_z6"},
  {"op": "wait", "s": 0.5, "phase": "look", "for": "f_thin_z6"},
  {"op": "capture", "name": "f_thin_z6", "desc": "Authoring: the Thin brush held at (11.5, -4) at zoom 6, its ring's canopy fade"},
  {"op": "cancel", "phase": "look", "for": "f_thin_z6"},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()", "phase": "look", "for": "f_thin_z6"},

  {"op": "saved", "folder": "_pol_forest", "load": "play"},
  {"op": "play", "folder": "_pol_forest", "phase": "build"},
  {"op": "wait", "s": 4.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "tokens", "points": [[9, -7], [7.5, -9], [-9, 2]], "phase": "look", "for": "p_*"},
  {"op": "wait", "s": 2.0, "phase": "look", "for": "p_*"},
  {"op": "zoom", "size": 13.85, "phase": "look", "for": "p_tok_z13"},
  {"op": "look_at", "at": [9, -7], "phase": "look", "for": "p_tok_z13"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "p_tok_z13"},
  {"op": "capture", "name": "p_tok_z13", "desc": "Play, home zoom, tokens in the grove at (9, -7) and (7.5, -9): the token occlusion fade"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "drag", "token": 0, "to": [11, -3], "phase": "look", "for": "p_drag_z13"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "p_drag_z13"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "report", "phase": "look", "for": "p_drag_z13"},
  {"op": "capture", "name": "p_drag_z13", "desc": "Play, home zoom: a token dragged through DragAndDrop3D (its ray starts on the near plane behind the camera) onto (11, -3)"},
  {"op": "zoom", "size": 6.0, "phase": "look", "for": "p_tok_z6*"},
