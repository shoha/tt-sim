  {"op": "wait", "s": 1.5, "phase": "look", "for": "b_*"},
  {"op": "capture", "name": "b_dc_z13", "desc": "Blender map deciduous_clusters in play (read-only), home zoom at (-16, -1)"},
  {"op": "zoom", "size": 6.0, "phase": "look", "for": "b_*"},
  {"op": "look_at", "at": [-16, -1], "phase": "look", "for": "b_*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "b_*"},
  {"op": "capture", "name": "b_dc_z6", "desc": "deciduous_clusters, zoom 6 at (-16, -1): its baked scatter imports every surface as cards, so the fade keeps the trunk by its authored flutter weight"},
  {"op": "title", "phase": "look", "for": "b_*"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "b_*"},

  {"op": "saved", "folder": "_pol_taiga"},
  {"op": "new_map", "biome": "boreal_taiga_summer_s1", "size": 150, "seed": 1234, "phase": "build"},
