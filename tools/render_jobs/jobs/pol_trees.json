  {"op": "wait", "s": 1.0, "phase": "look", "for": "p_tok_z6_grid"},
  {"op": "capture", "name": "p_tok_z6_grid", "desc": "The same with the grid on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "p_tok_z6_grid"},
  {"op": "zoom", "size": 6.0, "phase": "look", "for": "p_river_z6"},
  {"op": "look_at", "at": [-9, 2], "phase": "look", "for": "p_river_z6"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "p_river_z6"},
  {"op": "capture", "name": "p_river_z6", "desc": "Play, zoom 6 on a token wading in the river at (-9, 2)"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},

  {"op": "play", "folder": "deciduous_clusters", "phase": "look", "for": "b_*"},
  {"op": "wait", "s": 5.0, "phase": "look", "for": "b_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540], "phase": "look", "for": "b_*"},
  {"op": "zoom", "size": 13.85, "phase": "look", "for": "b_*"},
