{
 "out_dir": "render_jobs/eyehints_look",
 "timeout_s": 600,
 "hang_s": 90,
 "steps": [
  {"op": "wait_title"},
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 100, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "save", "folder": "_hintbar_eyehints", "name": "Eye Hints Room", "replace": true},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "play", "folder": "_hintbar_eyehints"},
  {"op": "wait", "s": 0.5},
  {"op": "wait_ready", "settle": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": "1280x720"},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "drawer", "which": "visuals", "pane": "sun"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "enter", "at": [0, 0], "yaw": 45, "pitch": 3, "fov": 60},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/hint_bar.gd", "action": "base", "street": false},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/hint_bar.gd", "action": "measure"},
  {"op": "capture", "name": "eyehints_720_before_drawer", "desc": "1280x720, at the eye with the orbit hints, Visuals drawer open"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "enter", "at": [0, 0], "yaw": 45, "pitch": 3, "fov": 60},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/hint_bar.gd", "action": "measure"},
  {"op": "capture", "name": "eyehints_720_after_drawer", "desc": "1280x720, at the eye (the hints swapped on entering), Visuals drawer open"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/hint_bar.gd", "action": "measure"},
  {"op": "capture", "name": "eyehints_720_back_in_orbit", "desc": "1280x720, back in the orbit view: the orbit hints return"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "drawer", "which": "visuals", "pane": "sun", "open": false},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": "1920x1080"},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "enter", "at": [0, 0], "yaw": 45, "pitch": 3, "fov": 60},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/hint_bar.gd", "action": "base", "street": false},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "eyehints_1080_before", "desc": "1920x1080, at the eye with the orbit hints"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "enter", "at": [0, 0], "yaw": 45, "pitch": 3, "fov": 60},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/hint_bar.gd", "action": "measure"},
  {"op": "capture", "name": "eyehints_1080_after", "desc": "1920x1080, at the eye with the street hints"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "cleanup"}
 ]
}
