{
 "out_dir": "render_jobs/windf_smoke",
 "timeout_s": 400,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "nocursor"},
  {"op": "hide_ui"},
  {"op": "stroke", "mode": "fire", "tile": "blaze", "points": [[-13, -6], [-2, -6]], "speed": 3.0, "radius": 3.0},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "stroke", "mode": "fire", "tile": "blaze", "points": [[-2, -3.5], [-13, -3.5]], "speed": 3.0, "radius": 3.0},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "wait", "s": 4.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info"},
  {"op": "expand", "values": ["calm", "storm"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "{value}", "clock": 0.0, "motion": 1.0, "sway": false},
   {"op": "zoom", "size": 20.0},
   {"op": "look_at", "at": [-7.5, -13]},
   {"op": "wait", "s": 1.5},
   {"op": "capture", "name": "{value}_z20", "desc": "{value}, zoom 20, view shifted 8 m toward -z: the smoke columns whole, wind clock 0"},
   {"op": "zoom", "size": 12.0},
   {"op": "look_at", "at": [-7.5, -12]},
   {"op": "wait", "s": 1.5},
   {"op": "capture", "name": "{value}_z12", "desc": "{value}, zoom 12 on the columns, wind clock 0"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "storm", "clock": 3.0, "motion": 1.0, "sway": false},
  {"op": "zoom", "size": 20.0},
  {"op": "look_at", "at": [-7.5, -13]},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "storm3_z20", "desc": "storm, zoom 20, wind clock 3 s (another place in the gust)"},
  {"op": "zoom", "size": 12.0},
  {"op": "look_at", "at": [-7.5, -12]},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "storm3_z12", "desc": "storm, zoom 12, wind clock 3 s"},
  {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "storm", "clock": 0.0, "motion": 0.0, "sway": false},
  {"op": "zoom", "size": 20.0},
  {"op": "look_at", "at": [-7.5, -13]},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "still_z20", "desc": "storm with Wind motion 0: the column as before the wind"},
  {"op": "zoom", "size": 12.0},
  {"op": "look_at", "at": [-7.5, -12]},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "still_z12", "desc": "storm, motion 0, zoom 12"},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/windf_smoke", "out": "sheet_z20", "columns": 2, "names": ["calm_z20", "storm_z20", "storm3_z20", "still_z20"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/windf_smoke", "out": "sheet_z12", "columns": 2, "names": ["calm_z12", "storm_z12", "storm3_z12", "still_z12"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "calm", "motion": 1.0, "unpin": true},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
