{
 "out_dir": "render_jobs/es_hamlet",
 "timeout_s": 900,
 "hang_s": 150,
 "saved": {"folder": "_camera_es_hamlet", "load": "play"},
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_camera_es_hamlet", "load": "play"},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 250, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_camera_es_hamlet", "replace": true, "phase": "build"},
  {"op": "play", "folder": "_camera_es_hamlet", "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 34.0},
  {"op": "settle"},
  {"op": "capture", "name": "es_hamlet_orbit_before", "desc": "orbit home before the eye (look must be unchanged)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "enter", "via_key": true, "at": [33, 0], "yaw": 270, "pitch": 3, "fov": 60},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "skystate"},
  {"op": "capture", "name": "es_hamlet_a_y270", "desc": "painted sky, near the east edge, facing the edge"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 0},
  {"op": "settle"},
  {"op": "capture", "name": "es_hamlet_a_y000", "desc": "painted sky, yaw 0"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 90},
  {"op": "settle"},
  {"op": "capture", "name": "es_hamlet_a_y090", "desc": "painted sky, yaw 90 (into the map)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 180},
  {"op": "settle"},
  {"op": "capture", "name": "es_hamlet_a_y180", "desc": "painted sky, yaw 180"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "sky", "on": false},
  {"op": "settle"},
  {"op": "capture", "name": "es_hamlet_b_y180", "desc": "before (flat sky, no fog), yaw 180"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 90},
  {"op": "settle"},
  {"op": "capture", "name": "es_hamlet_b_y090", "desc": "before, yaw 90"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 0},
  {"op": "settle"},
  {"op": "capture", "name": "es_hamlet_b_y000", "desc": "before, yaw 0"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 270},
  {"op": "settle"},
  {"op": "capture", "name": "es_hamlet_b_y270", "desc": "before, facing the edge"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "sky", "on": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
  {"op": "settle"},
  {"op": "capture", "name": "es_hamlet_orbit_after", "desc": "orbit view after leaving the eye"},
  {"op": "wind", "freeze": false},
  {"op": "wait", "s": 0.5}
 ]
}
