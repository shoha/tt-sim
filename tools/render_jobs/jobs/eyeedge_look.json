{
 "out_dir": "render_jobs/eyeedge_look",
 "timeout_s": 1800,
 "hang_s": 150,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_camera_eyeedge_hamlet", "load": "play"},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 250, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_camera_eyeedge_hamlet", "replace": true, "phase": "build"},
  {"op": "play", "folder": "_camera_eyeedge_hamlet", "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 34.0},
  {"op": "settle"},
  {"op": "capture", "name": "eyeedge_hamlet_orbit_before"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "enter", "at": [0, 30], "yaw": 135, "pitch": 0, "fov": 60},
  {"op": "settle"},
  {"op": "capture", "name": "eyeedge_hamlet_p00_y135"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 225, "pitch": 0}, {"op": "settle"}, {"op": "capture", "name": "eyeedge_hamlet_p00_y225"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 315, "pitch": 0}, {"op": "settle"}, {"op": "capture", "name": "eyeedge_hamlet_p00_y315"},
  {"op": "eval", "expr": "get_tree().root.find_child(\"EyeRim\", true, false).set(\"visible\", false)"},
  {"op": "eval", "expr": "get_tree().root.find_child(\"TerrainSkirt\", true, false).mesh.surface_get_material(0).set_shader_parameter(\"skirt_hold_m\", 0.0)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 135, "pitch": 0}, {"op": "settle"}, {"op": "capture", "name": "eyeedge_hamlet_p00_y135_before"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 225, "pitch": 0}, {"op": "settle"}, {"op": "capture", "name": "eyeedge_hamlet_p00_y225_before"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
  {"op": "settle"},
  {"op": "capture", "name": "eyeedge_hamlet_orbit_after"},
  {"op": "wind", "freeze": false},
  {"op": "title"},
  {"op": "wait", "s": 1.0},

  {"op": "expand", "values": ["temperate_forest", "savanna"], "template": [
   {"op": "saved", "folder": "_camera_eyeedge_{value}", "load": "play"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "new", "biome": "{value}_summer_s1", "size": 150, "seed": 3, "landform": "valley", "phase": "build"},
   {"op": "wait_ready", "settle": 1.5, "phase": "build"},
   {"op": "no_autosave", "phase": "build"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_camera_eyeedge_{value}", "replace": true, "phase": "build"},
   {"op": "play", "folder": "_camera_eyeedge_{value}", "phase": "build"},
   {"op": "wait_ready", "settle": 2.0, "phase": "build"},
   {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
   {"op": "hide_ui"},
   {"op": "wind", "freeze": true},
   {"op": "look_at", "at": [0, 0]},
   {"op": "zoom", "size": 26.0},
   {"op": "settle"},
   {"op": "capture", "name": "eyeedge_{value}_orbit"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "enter", "at": [10, 10], "yaw": 135, "pitch": 0, "fov": 60},
   {"op": "settle"},
   {"op": "capture", "name": "eyeedge_{value}_p00_y135"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 225, "pitch": 0}, {"op": "settle"}, {"op": "capture", "name": "eyeedge_{value}_p00_y225"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 225, "pitch": -15}, {"op": "settle"}, {"op": "capture", "name": "eyeedge_{value}_pm15_y225"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 315, "pitch": -15}, {"op": "settle"}, {"op": "capture", "name": "eyeedge_{value}_pm15_y315"},
   {"op": "eval", "expr": "get_tree().root.find_child(\"EyeRim\", true, false).set(\"visible\", false)"},
   {"op": "eval", "expr": "get_tree().root.find_child(\"TerrainSkirt\", true, false).mesh.surface_get_material(0).set_shader_parameter(\"skirt_hold_m\", 0.0)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 135, "pitch": 0}, {"op": "settle"}, {"op": "capture", "name": "eyeedge_{value}_p00_y135_before"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 225, "pitch": 0}, {"op": "settle"}, {"op": "capture", "name": "eyeedge_{value}_p00_y225_before"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 135, "pitch": 0}, {"op": "settle"},
   {"op": "eval", "expr": "get_tree().root.find_child(\"TerrainSkirt\", true, false).set(\"visible\", false)", "for": "*_noskirt"},
   {"op": "settle", "for": "*_noskirt"},
   {"op": "capture", "name": "eyeedge_{value}_p00_y135_noskirt"},
   {"op": "eval", "expr": "get_tree().root.find_child(\"TerrainSkirt\", true, false).set(\"visible\", true)", "for": "*_noskirt"},
   {"op": "eval", "expr": "get_tree().root.find_child(\"TerrainSkirt\", true, false).mesh.surface_get_material(0).set_shader_parameter(\"skirt_fade_m\", 100.0)", "for": "*_nofade"},
   {"op": "settle", "for": "*_nofade"},
   {"op": "capture", "name": "eyeedge_{value}_p00_y135_nofade"},
   {"op": "eval", "expr": "get_tree().root.find_child(\"TerrainSkirt\", true, false).mesh.surface_get_material(0).set_shader_parameter(\"skirt_fade_m\", 24.0)", "for": "*_nofade"},
   {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
   {"op": "settle"},
   {"op": "wind", "freeze": false},
   {"op": "title"},
   {"op": "wait", "s": 1.0}
  ]}
 ]
}
