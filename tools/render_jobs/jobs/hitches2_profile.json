{
  "out_dir": "render_jobs/hitches2_profile",
  "timeout_s": 300,
  "hang_s": 90,
  "remove_override": true,
  "steps": [
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 300, "seed": 1234},
    {"op": "wait_ready", "settle": 1.5},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
    {"op": "wind", "freeze": true},
    {"op": "look_at", "at": [0, 0]},
    {"op": "zoom", "size": 60.0},
    {"op": "vsync_off"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "idle"},
    {"op": "settle"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "idle_a"},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},

    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "open_structure_tool"},
    {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"structure\")"},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "place1_cold"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "place", "count": 1, "seed": 100},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "place1_warm"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "place", "count": 1, "seed": 700},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
    {"op": "wait", "s": 1.0},

    {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
    {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
    {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-26, -28], "to": [26, -28], "preset": 2, "seed": 3},
    {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-26, 0], "to": [26, 0], "preset": 2, "seed": 4},
    {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-26, 28], "to": [26, 28], "preset": 2, "seed": 5},
    {"op": "settle", "timeout": 30},

    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "dress_street_1"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "dress", "id": 1, "kit": "market_town", "wealth": 0.7, "density": 1.0},
    {"op": "wait", "s": 4.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "dress_street_2"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.0},
    {"op": "wait", "s": 4.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "redress_1"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "redress", "id": 1},
    {"op": "wait", "s": 4.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "redress_1_again"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "redress", "id": 1},
    {"op": "wait", "s": 4.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "redress_2"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "redress", "id": 2},
    {"op": "wait", "s": 4.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "clear_1"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "clear", "id": 1},
    {"op": "wait", "s": 4.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "clear_2"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "clear", "id": 2},
    {"op": "wait", "s": 4.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},

    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "idle_b"},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "title"}
  ]
}
