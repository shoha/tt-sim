{
 "out_dir": "render_jobs/structures_round",
 "timeout_s": 300,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 200, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 40.0},
  {"op": "wait", "s": 1.5},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"structure\")"},
  {"op": "wait", "s": 0.8},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "pick", "ref": "core:round_hut"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "rounds"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "flush"},
  {"op": "eval", "expr": "_authoring_controller.panel.close()"},
  {"op": "hide_ui"},
  {"op": "look_at", "at": [2, 4]},
  {"op": "zoom", "size": 38.0},
  {"op": "wait", "s": 3.0},
  {"op": "input", "events": [{"type": "move", "at": [-6, 14, 0]}]},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "01_hamlet_and_ghost", "desc": "The five round starters as a hamlet, and the round timber hut's ghost (a 12-gon, door bar on its front) following the pointer"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 14.0},
  {"op": "wait", "s": 5.0},
  {"op": "input", "events": [{"type": "move", "at": [0, 0, 0]}]},
  {"op": "wait", "s": 0.4},
  {"op": "input", "events": [{"type": "press", "at": [0, 0]}, {"type": "release", "at": [0, 0]}]},
  {"op": "wait", "s": 0.6},
  {"op": "input", "events": [{"type": "move", "at": [-3.3, 1.4, 0]}]},
  {"op": "wait", "s": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "report"},
  {"op": "capture", "name": "03_selected", "desc": "A click selected the roundhouse: a dot at each of the eight corners, a tab at each side"},
  {"op": "input", "events": [{"type": "move", "at": [-3.3, 1.4, 0]}, {"type": "press", "at": [-3.3, 1.4, 0]}, {"type": "move", "at": [-3.8, 1.6, 0]}, {"type": "move", "at": [-4.6, 1.9, 0]}, {"type": "move", "at": [-5.4, 2.2, 0]}]},
  {"op": "wait", "s": 0.8},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "report"},
  {"op": "capture", "name": "04_scaling", "desc": "A corner dot dragged outward: the whole polygon scales about its middle and stays regular; the building follows"},
  {"op": "input", "events": [{"type": "release", "at": [-5.4, 2.2, 0]}]},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "flush"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "report"},
  {"op": "capture", "name": "05_scaled", "desc": "The roundhouse after the drag: larger, still an octagon, the door still on the front"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
