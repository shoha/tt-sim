{
  "out_dir": "render_jobs/sculpt_pipeline",
  "timeout_s": 600,
  "steps": [
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 200, "seed": 1234},
    {"op": "wait_ready", "settle": 2.0},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "place", "biome": "temperate_forest_summer_s1", "species": "boulder", "at": [-3, -7]},
    {"op": "place", "biome": "temperate_forest_summer_s1", "species": "log", "at": [1, -3]},
    {"op": "place", "biome": "temperate_forest_summer_s1", "species": "oak", "at": [-9, 0]},
    {"op": "home"},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "01_before", "desc": "Painted temperate forest, flat, three props placed near the hill site"},
    {"op": "vsync_off"},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "view_shift", "rise": 8.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "collision", "reps": 20},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "snap_dense"},

    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "stroke", "name": "hill_r8 (a capture lands mid-stroke)", "sculpt": "raise", "points": [[-5, -4], [-3, -4]], "radius": 8.0, "speed": 1.0, "hold": 2.8},
    {"op": "wait", "s": 2.4},
    {"op": "capture", "name": "02_hill_mid", "desc": "Raising a hill (8 m brush), mid-stroke: plants and props ride the ground"},
    {"op": "wait", "s": 3.0},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "capture", "name": "03_hill", "desc": "The 6-7 m hill after its stroke and regeneration (slope rules thin the steep flanks)"},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "check", "area": [-16, -16, 8, 8]},

    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "stroke", "name": "hollow_r5", "sculpt": "lower", "points": [[12, 8], [12.5, 8]], "radius": 5.0, "speed": 0.5, "hold": 1.2},
    {"op": "wait", "s": 3.0},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "stroke", "name": "smooth_r6", "sculpt": "smooth", "points": [[-12, -10], [2, 2]], "radius": 6.0, "speed": 3.0},
    {"op": "wait", "s": 6.0},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "stroke", "name": "flatten_r3", "sculpt": "flatten", "points": [[-1, -9], [4, -11]], "radius": 3.0, "speed": 2.0, "target_at": [-1, -9]},
    {"op": "wait", "s": 4.0},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "stroke", "name": "tier_r5", "sculpt": "tier", "points": [[18, -14], [19, -14]], "radius": 5.0, "speed": 0.5, "hold": 1.0, "target_y": 1.524},
    {"op": "wait", "s": 4.0},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "home"},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "04_home_after", "desc": "Home view after hill, hollow (east), smooth, flatten (a shelf on the hill's south flank) and a tier stub"},
    {"op": "zoom", "size": 26.0},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "05_zoom26", "desc": "Zoom 26 over the sculpted area"},

    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "stroke", "name": "edge_r5", "sculpt": "raise", "points": [[30.4, 2], [30.4, 6]], "radius": 5.0, "speed": 2.0, "hold": 1.0},
    {"op": "wait", "s": 4.0},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "zoom"},
    {"op": "wait", "s": 2.0},
    {"op": "capture", "name": "06_zoomed_out", "desc": "Full zoom-out: the east edge raised, the skirt follows it"},

    {"op": "home"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "compare", "at": [-4, -4], "radius": 12.0, "reps": 12},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "stroke", "name": "continuous_r4", "sculpt": "raise", "points": [[-24, 16], [-8, 22], [8, 16], [24, 22]], "radius": 4.0, "speed": 6.0, "flow": 0.3},
    {"op": "wait", "s": 10.0},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "stroke", "name": "continuous_r12", "sculpt": "raise", "points": [[-20, 22], [0, 14], [20, 22]], "radius": 12.0, "speed": 4.0, "flow": 0.15},
    {"op": "wait", "s": 11.0},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "stroke", "name": "capture_r12 (a capture lands mid-stroke; timings not representative)", "sculpt": "lower", "points": [[20, 22], [0, 14], [-20, 22]], "radius": 12.0, "speed": 4.0, "flow": 0.08},
    {"op": "wait", "s": 3.0},
    {"op": "capture", "name": "07_r12_mid", "desc": "A 12 m brush mid-stroke (lowering back part of the ridge the previous stroke raised)"},
    {"op": "wait", "s": 8.0},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "capture", "name": "08_r12_after", "desc": "After the 12 m stroke and its regeneration"},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "check", "area": [-30, -30, 30, 30]},

    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "look_bottom", "at": [-4, -4], "y": 6.5},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "09_hill_at_bottom", "desc": "The hill top at the bottom edge of the screen: no near-plane clipping"},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "check", "area": [-16, -16, 8, 8]},
    {"op": "zoom", "size": 8.0},
    {"op": "wait", "s": 1.5},
    {"op": "call", "script": "res://tools/render_jobs/probes/sculpt.gd", "action": "look_bottom", "at": [-4, -4], "y": 6.5},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "10_hill_at_bottom_zoom8", "desc": "Zoomed in to 8 with the hill top at the bottom edge"},
    {"op": "index", "title": "Sculpt pipeline (P3-3a)", "intro": "Programmatic height strokes on a new 200 ft temperate forest map (seed 1234) through AuthoringEditor; see log.txt for the stroke timings and the checks."},
    {"op": "title"}
  ]
}
