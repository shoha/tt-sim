{
  "out_dir": "render_jobs/perf_ground_ab",
  "timeout_s": 600,
  "remove_override": true,
  "steps": [
    {"op": "new_map", "biome": "", "size": 200, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "home"},
    {"op": "vsync_off"},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "variant", "name": "loop", "replace": [["#define SLOT_LOOP_END MAX_LAYERS", "#define SLOT_LOOP_END layer_count"]]},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "shader", "version": "old"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "shader", "version": "loop"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "shader", "version": "new"},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "01_flat", "desc": "Bare grass map"},
    {"op": "expand_ab", "configs": ["old", "new", "loop", "old", "new", "loop"], "label": "flat"},

    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "layers", "mode": "4"},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "02_layers4", "desc": "Four biome grounds in quadrants"},
    {"op": "expand_ab", "configs": ["new", "loop", "new", "loop"], "label": "4 layers"},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "paint", "mode": "mix8"},
    {"op": "wait", "s": 1.0},
    {"op": "expand_ab", "configs": ["new", "loop", "new", "loop"], "label": "8 mix"},

    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "", "size": 200, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "terraces", "rings": 6},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "home"},
    {"op": "vsync_off"},
    {"op": "capture", "name": "03_terraces", "desc": "Terraces"},
    {"op": "expand_ab", "configs": ["old", "new", "loop", "old", "new", "loop"], "label": "terraces"},
    {"op": "index", "title": "Ground shader A/B", "intro": "old = before P3-4, new = working tree, loop = working tree with the slot loops bounded by layer_count"},
    {"op": "title"}
  ]
}
