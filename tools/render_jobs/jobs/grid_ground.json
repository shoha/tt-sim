    {"op": "zoom", "size": 8},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "dec_g_zoom8", "desc": "deciduous_clusters, G on, zoom 8"},
    {"op": "look_at", "at": [-8.0, -9.0]},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "dec_g_forest", "desc": "deciduous_clusters, G on, zoom 8, forest edge"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "measure", "on": true},
    {"op": "home"},
    {"op": "zoom", "size": 8},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "dec_measure", "desc": "deciduous_clusters, measure tool active"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "measure", "on": false},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "drag", "on": true},
    {"op": "wait", "s": 0.6},
    {"op": "capture", "name": "dec_drag", "desc": "deciduous_clusters, drag auto-show (no token on this level)"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "drag", "on": false},
    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "play", "folder": "river"},
    {"op": "wait", "s": 3.0},
    {"op": "wait_ready", "settle": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "fit"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "grid"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "survey", "spacings": [0.25]},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
    {"op": "wait", "s": 0.6},
    {"op": "capture", "name": "river_g_home", "desc": "river, G on, home"},
    {"op": "look_at", "at": [-8.38, -6.86]},
    {"op": "zoom", "size": 8},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "river_g_token", "desc": "river, G on, zoom 8 on Bulbasaur"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "measure", "on": true},
    {"op": "wait", "s": 0.6},
    {"op": "capture", "name": "river_measure", "desc": "river, measure tool active"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "measure", "on": false},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "drag", "on": true},
    {"op": "wait", "s": 0.6},
    {"op": "capture", "name": "river_drag", "desc": "river, token drag auto-show"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "drag", "on": false},
    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "play_res", "path": "res://assets/models/maps/oaks_lab.tres"},
    {"op": "wait", "s": 3.0},
    {"op": "wait_ready", "settle": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "fit"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "grid"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "survey", "spacings": [0.25]},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
    {"op": "wait", "s": 0.6},
    {"op": "capture", "name": "oaks_g_home", "desc": "oaks_lab, G on, home (flat Y = 0 map: fixed band kept)"},
    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "dress", "folder": "river"},
    {"op": "no_autosave"},
    {"op": "wait", "s": 2.0},
    {"op": "wait_ready", "settle": 2.0},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "fit"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
    {"op": "wait", "s": 0.6},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "grid"},
    {"op": "capture", "name": "river_dress_g", "desc": "river opened for dressing in authoring, G on"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
    {"op": "index", "title": "Grid on Blender maps' ground", "intro": "Grid on GLB maps following ground sampled from the layer-1 collision (P3-3c)"},
    {"op": "title"}
  ]
}
