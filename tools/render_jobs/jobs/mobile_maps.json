{
  "out_dir": "render_jobs/mobile_maps",
  "timeout_s": 280,
  "steps": [
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 200, "seed": 1234},
    {"op": "no_autosave"},
    {"op": "wait_ready", "settle": 2.0},
    {"op": "no_autosave"},
    {"op": "zoom"},
    {"op": "wait", "s": 2.0},
    {"op": "capture", "name": "01_forest200", "desc": "New 200 ft temperate forest map, full zoom-out"},
    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "play", "folder": "deciduous_clusters"},
    {"op": "wait", "s": 3.0},
    {"op": "wait_ready", "settle": 3.0},
    {"op": "capture", "name": "02_play_deciduous", "desc": "deciduous_clusters in play"},
    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "play", "folder": "river"},
    {"op": "wait", "s": 3.0},
    {"op": "wait_ready", "settle": 3.0},
    {"op": "capture", "name": "03_play_river", "desc": "river in play"},
    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "dress", "folder": "river"},
    {"op": "no_autosave"},
    {"op": "wait", "s": 2.0},
    {"op": "wait_ready", "settle": 3.0},
    {"op": "no_autosave"},
    {"op": "capture", "name": "04_dress_river", "desc": "river opened for dressing"},
    {"op": "index", "title": "Mobile renderer with scatter", "intro": "Authored and Blender maps with plants under --rendering-method mobile"},
    {"op": "title"}
  ]
}
