{
 "out_dir": "render_jobs/structure_select",
 "timeout_s": 300,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 16.0},
  {"op": "wait", "s": 1.5},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"structure\")"},
  {"op": "wait", "s": 0.8},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "pick", "ref": "core:cottage"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "lay", "ref": "core:cottage", "at": [0, 0], "size": [6, 4]},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "flush"},
  {"op": "eval", "expr": "_authoring_controller.panel.close()"},
  {"op": "hide_ui"},
  {"op": "look_at", "at": [3, 1]},
  {"op": "zoom", "size": 16.0},
  {"op": "wait", "s": 3.0},
  {"op": "input", "events": [{"type": "move", "at": [0, 0]}]},
  {"op": "wait", "s": 0.4},
  {"op": "input", "events": [{"type": "press", "at": [0, 0]}, {"type": "release", "at": [0, 0]}]},
  {"op": "wait", "s": 0.5},
  {"op": "input", "events": [{"type": "move", "at": [3.8, 0, 0]}]},
  {"op": "wait", "s": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "report"},
  {"op": "capture", "name": "01_selected", "desc": "A click on the roof selected the cottage: dots at the corners, tabs at the sides (the right one hovered, with its door hint)"},
  {"op": "input", "events": [{"type": "move", "at": [3, 2, 0]}, {"type": "press", "at": [3, 2, 0]}, {"type": "move", "at": [4, 2.4, 0]}, {"type": "move", "at": [6, 3, 0]}, {"type": "move", "at": [9, 4, 0]}, {"type": "move", "at": [12, 5.5, 0]}, {"type": "move", "at": [15, 6.5, 0]}, {"type": "move", "at": [17, 7, 0]}]},
  {"op": "wait", "s": 0.6},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "report"},
  {"op": "capture", "name": "02_drag_clamped", "desc": "A corner dot dragged past the largest size: the outline stops at the clamp, the dot goes warm, a thin line runs to the pointer; the building has followed the drag"},
  {"op": "input", "events": [{"type": "release", "at": [17, 7, 0]}]},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "flush"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "report"},
  {"op": "input", "events": [{"type": "move", "at": [11.46, 2.39, 0]}]},
  {"op": "wait", "s": 0.4},
  {"op": "input", "events": [{"type": "press", "at": [11.46, 2.39, 0]}, {"type": "release", "at": [11.46, 2.39, 0]}]},
  {"op": "wait", "s": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "bar", "press": "variant", "ref": "core:cottage_chimneyed"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "bar", "press": "param", "param": "floors", "direction": 1},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "bar", "press": "param", "param": "floors", "direction": 1},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "flush"},
  {"op": "input", "events": [{"type": "move", "at": [40, 40]}]},
  {"op": "hide_ui", "hide": false},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"structure\")"},
  {"op": "wait", "s": 1.0},
  {"op": "look_at", "at": [7, 11]},
  {"op": "zoom", "size": 24.0},
  {"op": "wait", "s": 4.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "report"},
  {"op": "capture", "name": "03_result_and_bar", "desc": "After the gestures: resized to the clamp, the door moved to the right end, the chimney variant at two floors, still selected, with its bar in the pane"},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
