{
 "out_dir": "render_jobs/structure_tool",
 "timeout_s": 420,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "cleanup"},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 20.0},
  {"op": "wait", "s": 1.5},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"structure\")"},
  {"op": "wait", "s": 0.8},
  {"op": "capture", "name": "01_pane", "desc": "The Building tool's pane: the library's buildings by family, with pictures"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "pick", "ref": "core:cottage"},
  {"op": "eval", "expr": "_authoring_controller.panel.close()"},
  {"op": "hide_ui"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 14.0},
  {"op": "wait", "s": 1.0},
  {"op": "input", "events": [{"type": "move", "at": [0, 0]}]},
  {"op": "wait", "s": 0.6},
  {"op": "capture", "name": "02_idle_ghost", "desc": "The cottage lot following the pointer: footprint, height ring, door bar on the front"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "rotate", "steps": 2},
  {"op": "wait", "s": 0.4},
  {"op": "capture", "name": "03_turned", "desc": "After two E notches: the lot turned 30 degrees"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "rotate", "steps": -2},
  {"op": "gesture", "points": [[-7, -5], [1, 1]], "speed": 3.0, "release": false},
  {"op": "wait", "s": 0.4},
  {"op": "capture", "name": "04_drag", "desc": "Dragging corner to corner: the sized lot and its readout"},
  {"op": "input", "events": [{"type": "release", "at": [1, 1]}]},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "flush"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "report"},
  {"op": "capture", "name": "05_laid", "desc": "The cottage laid by the drag"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "pick", "ref": "core:townhouse_trimmed"},
  {"op": "look_at", "at": [0, -3]},
  {"op": "zoom", "size": 22.0},
  {"op": "input", "events": [{"type": "move", "at": [-3, 2]}]},
  {"op": "wait", "s": 0.8},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "report"},
  {"op": "capture", "name": "06_eased", "desc": "The townhouse lot held over the cottage: it settles on the free ground beside it"},
  {"op": "input", "events": [{"type": "press", "at": [-3, 2]}, {"type": "release", "at": [-3, 2]}]},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "flush"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "report"},
  {"op": "capture", "name": "07_town", "desc": "Two buildings laid: a dragged cottage and a clicked townhouse"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "save", "folder": "_structs4_tool"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "play", "folder": "_structs4_tool"},
  {"op": "wait", "s": 3.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "home"},
  {"op": "look_at", "at": [0, -3]},
  {"op": "zoom", "size": 22.0},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "report"},
  {"op": "capture", "name": "08_play", "desc": "In play after a reload: both buildings, as saved"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_tool.gd", "action": "cleanup"}
 ]
}
