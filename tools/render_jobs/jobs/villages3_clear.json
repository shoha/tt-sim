{
 "out_dir": "render_jobs/villages3_clear",
 "timeout_s": 400,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 250, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31},
  {"op": "settle"},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 0.9},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "plaza", "id": 1, "at": [-18, 32], "radius": 5.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "plaza", "id": 2, "at": [18, 33], "radius": 6.0},
  {"op": "settle"},
  {"op": "look_at", "at": [18, 4]},
  {"op": "zoom", "size": 30.0},
  {"op": "settle"},
  {"op": "capture", "name": "dressed_market", "desc": "market street dressed with its ground"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "clear", "id": 2},
  {"op": "settle"},
  {"op": "capture", "name": "cleared_market", "desc": "the same street after Clear: road, paths and plaza paint gone, the hamlet to the left untouched"},
  {"op": "look_at", "at": [0, 4]},
  {"op": "zoom", "size": 60.0},
  {"op": "settle"},
  {"op": "capture", "name": "cleared_home", "desc": "home zoom: the hamlet still paved, the market street bare"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "plaza", "id": 2, "at": [18, 33], "radius": 6.0},
  {"op": "settle"},
  {"op": "capture", "name": "redressed_home", "desc": "home zoom after a fresh Dress of the cleared street"},
  {"op": "look_at", "at": [18, 4]},
  {"op": "zoom", "size": 30.0},
  {"op": "settle"},
  {"op": "capture", "name": "redressed_market", "desc": "the market street re-dressed"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "redress", "id": 2},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "redress", "id": 2},
  {"op": "settle"},
  {"op": "capture", "name": "redressed_twice_market", "desc": "two more re-dresses: the same road, new furnishings"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "report"}
 ]
}
