{
  "out_dir": "render_jobs/drag_check",
  "timeout_s": 240,
  "hang_s": 60,
  "steps": [
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
    {"op": "call", "script": "res://tools/render_jobs/probes/avatar_token.gd", "action": "save", "folder": "_avatartoken_dragcheck", "replace": true},
    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "play", "folder": "_avatartoken_dragcheck"},
    {"op": "wait", "s": 3.0},
    {"op": "wait_ready", "settle": 2.0},
    {"op": "hide_ui"},
    {"op": "home"},
    {"op": "settle"},
    {"op": "call", "script": "res://tools/render_jobs/probes/drag_check.gd", "action": "start", "out": "user://render_jobs/drag_check"},
    {"op": "wait", "s": 45.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/drag_check.gd", "action": "result"},
    {"op": "title"},
    {"op": "call", "script": "res://tools/render_jobs/probes/avatar_token.gd", "action": "cleanup"}
  ]
}
