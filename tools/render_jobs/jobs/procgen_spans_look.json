{
 "out_dir": "render_jobs/procgen_spans_look",
 "timeout_s": 900,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "cleanup"},
  {"op": "call", "script": "res://tools/render_jobs/probes/procgen_switch.gd", "enabled": true},

  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 20.0},
  {"op": "wait", "s": 1.5},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.8, "speed": 4.0, "curve": true, "points": [[-21, 5], [-14, 6], [-7, 4], [0, 1], [7, 0], [14, 1], [21, -2]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "plank", "from": [-12, 4.5], "to": [-12, 7.5]},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "arch", "from": [-4, 1.8], "to": [-4, 5.2]},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "stones", "from": [4, -1], "to": [4, 1]},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "ford", "from": [11, -0.5], "to": [11, 2.5]},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "report"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "home"},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "home", "desc": "Home zoom: plank, arch, stones and ford, all built by the procgen module"},
  {"op": "zoom", "size": 8.0},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "look", "at": "found:c2_mid"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "arch_z8", "desc": "Zoom 8: the procgen stone arch"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "look", "at": "found:c4_mid"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "ford_z8", "desc": "Zoom 8: the procgen ford"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "look", "at": "found:c3_mid"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "stones_z8", "desc": "Zoom 8: the procgen stepping stones"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "look", "at": "found:c1_mid"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "plank_z8", "desc": "Zoom 8: the procgen plank bridge"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "save", "folder": "_p4b1_procgen_spans"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "play", "folder": "_p4b1_procgen_spans"},
  {"op": "wait", "s": 3.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "report"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "tokens", "points": ["found:c1_mid", "found:c2_mid", "found:c3_stone0", "found:c4_mid"]},
  {"op": "wait", "s": 3.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "points", "points": ["found:c1_mid", "found:c2_mid", "found:c4_mid"]},
  {"op": "home"},
  {"op": "zoom", "size": 14.0},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "look", "at": "found:c2_mid"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "play_tokens", "desc": "In play: tokens on the procgen arch, plank, stones and ford"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "cleanup"},
  {"op": "call", "script": "res://tools/render_jobs/probes/procgen_switch.gd", "enabled": false}
 ]
}
