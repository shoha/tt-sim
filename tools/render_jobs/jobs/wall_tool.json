{
 "out_dir": "render_jobs/wall_tool",
 "timeout_s": 600,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "cleanup"},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 20.0},
  {"op": "wait", "s": 1.5},
  {"op": "stroke", "mode": "sculpt", "tile": "raise", "radius": 5.0, "speed": 3.0, "hold": 2.0, "points": [[6, -2], [6, 2]]},
  {"op": "wait_ready", "settle": 0.5},

  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "home"},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "01_pane", "desc": "The Wall rail item and pane: Stone and Fence tiles, the gestures in the hint"},
  {"op": "eval", "expr": "_authoring_controller.panel.close()"},
  {"op": "hide_ui"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 14.0},
  {"op": "wait", "s": 1.5},

  {"op": "gesture", "points": [[-8, -6], [-2, -6]], "speed": 3.0, "release": false},
  {"op": "wait", "s": 0.3},
  {"op": "capture", "name": "02_preview", "desc": "Dragging the first side of a stone wall: the ghost shows the line, its top and posts, with the length"},
  {"op": "input", "events": [{"type": "release", "at": [-2, -6]}]},
  {"op": "wait", "s": 1.0},
  {"op": "gesture", "points": [[-2, -6], [-2, 0]], "speed": 3.0},
  {"op": "wait", "s": 0.6},
  {"op": "gesture", "points": [[-2, 0], [-8, 0]], "speed": 3.0},
  {"op": "wait", "s": 0.6},
  {"op": "gesture", "points": [[-8, 0], [-8, -6]], "speed": 3.0},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "03_closed", "desc": "Four drags, each from the last one's end, and the last ending on the first end: a closed stone wall"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "report"},

  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "eval", "expr": "_authoring_controller.panel.close()"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "fence"},
  {"op": "gesture", "points": [[2, -6], [8, -4]], "speed": 3.0},
  {"op": "wait", "s": 0.6},
  {"op": "gesture", "points": [[8, -4], [10, 3]], "speed": 3.0},
  {"op": "wait", "s": 1.0},
  {"op": "look_at", "at": [6, -1]},
  {"op": "zoom", "size": 12.0},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "04_fence_slope", "desc": "A fence laid over the sculpted mound: its posts and rails follow the ground"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "report"},

  {"op": "look_at", "at": [-5, -3]},
  {"op": "zoom", "size": 8.0},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "05_wall_z8", "desc": "Zoom 8: the stone wall, courses and coping"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "save", "folder": "_p4b1_walls"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "play", "folder": "_p4b1_walls"},
  {"op": "wait", "s": 3.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "report"},
  {"op": "home"},
  {"op": "look_at", "at": [-5, -3]},
  {"op": "zoom", "size": 12.0},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "06_play", "desc": "In play after a save and reload: the walls are there"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "cleanup"}
 ]
}
