{
 "out_dir": "render_jobs/designer-s9_perf",
 "timeout_s": 600,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "wait_title"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "open", "library": "core", "biome": "temperate_forest"},
  {"op": "wait_ready", "settle": 3.0},
  {"op": "no_autosave"},
  {"op": "vsync_off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "debounce", "seconds": 0.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1600, 900]},
  {"op": "wait", "s": 1.0},

  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "compare", "kind": "biome", "label": "Savanna", "runtime": "savanna_summer_s1"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "AB START (first time: the reference's plants load)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "compare_off"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "AB OFF"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "compare", "kind": "biome", "label": "Savanna", "runtime": "savanna_summer_s1"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "AB START (second time)"},
  {"op": "expand", "values": [0.35, 0.65, 0.5, 0.2, 0.8], "template": [
    {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "divider", "frac": "{value}"},
    {"op": "wait_ready", "settle": 0.5},
    {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "AB DIVIDER to {value}"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "compare_off"},
  {"op": "wait_ready", "settle": 1.0},

  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "look_color", "index": 0, "hex": "#d0402a"},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "LOOK colour edit (bake only)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "look", "group": "light", "key": "shade", "value": "0.8"},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "LOOK light edit (bake only)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "look", "group": "zones", "key": "scale_m", "value": "[4, 6, 8]"},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "LOOK zone shape edit (bake and the plants that read the zones)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "undo"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "undo"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "undo"},
  {"op": "wait_ready", "settle": 0.5},

  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "add_season", "id": "autumn"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season_density", "season": "autumn", "size_class": "large", "scale": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "add_season", "id": "winter"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season_ground", "season": "winter", "field": "surface", "surface": "gravel"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season", "id": "autumn"},
  {"op": "wait", "s": 2.0},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "SEASON switch summer to autumn (same ground: only the plants change)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season", "id": "winter"},
  {"op": "wait", "s": 2.0},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "SEASON switch autumn to winter (other ground: the proving ground is built again)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "season", "id": "summer"},
  {"op": "wait", "s": 2.0},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "SEASON switch winter to summer"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "edit_timed", "rule": "oak", "field": "density_per_m2", "value": "0.02"},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "stats", "label": "TREE edit with three seasons (the other seasons are compiled too)"},
  {"op": "title"}, {"op": "wait", "s": 1.0}
 ]
}
