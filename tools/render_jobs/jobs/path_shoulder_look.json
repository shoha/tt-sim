{
  "out_dir": "render_jobs/path_shoulder",
  "timeout_s": 300,
  "steps": [
    {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 200, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "call", "script": "res://tools/render_jobs/probes/tree_fade.gd", "factor": 0.0},
    {"op": "home"},
    {"op": "wait", "s": 1.0},
    {"op": "stroke", "mode": "surface", "surface": "dirt_road_packed", "curve": true, "points": [[-28, 10], [-18, 5], [-8, 1], [2, 0], [12, 2], [22, -2], [28, -6]], "radius": 1.3, "speed": 4.0, "keep_active": true},
    {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
    {"op": "eval", "expr": "_authoring_controller.brush.cursor.set_visible(false)"},
    {"op": "wait_ready", "settle": 1.5},
    {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
    {"op": "hide_ui"},
    {"op": "home"},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "ps01_home", "desc": "Grassland meadow 200 ft, seed 1234, home view: a dirt road (dirt_road_packed, radius 1.3) across the map; canopy fade off, cursor hidden"},
    {"op": "zoom", "size": 10.0},
    {"op": "wait", "s": 1.5},
    {"op": "look_at", "at": [-6, 1]},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "ps02_road_z10", "desc": "Zoom 10 on the road at (-6, 1): its shoulders"},
    {"op": "index", "title": "Path shoulders (path-shoulder-grass)", "intro": "Which grasses thin beside a painted road on the grassland meadow."},
    {"op": "title"}
  ]
}
