  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "tile", "id": "collapse", "phase": "look", "for": "pane_nobridge"},
  {"op": "capture", "name": "pane_nobridge", "desc": "After the drop, before the undo: no bridge stands, so the Drop bridge tile is disabled and 'No bridge on this map' stands under the Happenings tiles (the tile step logs its tooltip, which says why); Topple trees stays available"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "close", "phase": "look", "for": "pane_nobridge"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "close", "phase": "look", "for": "pane_toasts_720,pane_player_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "1280x720", "phase": "look", "for": "pane_toasts_720,pane_player_720"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "pane_toasts_720,pane_player_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "forest", "zoom": 16.0, "phase": "look", "for": "pane_toasts_720,pane_player_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "toasts", "phase": "look", "for": "pane_toasts_720"},
