   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "put_away", "phase": "look", "for": "{value}_pane_ignite"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": [-7, 4], "zoom": 11.0, "phase": "look", "for": "pane_ignite_refused"},
