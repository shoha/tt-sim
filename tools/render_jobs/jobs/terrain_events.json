{
 "out_dir": "render_jobs/terrain_events",
 "timeout_s": 420,
 "hang_s": 90,
 "saved": {"folder": "_gm_events_spectacle", "load": "play"},
 "steps": [
  {"op": "wait_title"},
  {"op": "wait", "s": 1.0},

  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "look_at", "at": [0, 0], "phase": "build"},
  {"op": "zoom", "size": 20.0, "phase": "build"},
  {"op": "wait", "s": 1.5, "phase": "build"},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.8, "speed": 4.0, "curve": true, "points": [[-21, 5], [-14, 6], [-7, 4], [0, 1], [7, 0], [14, 1], [21, -2]], "phase": "build"},
  {"op": "wait_ready", "settle": 0.5, "phase": "build"},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "plank", "from": [-7, 2.5], "to": [-7, 5.5], "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "save", "folder": "_gm_events_spectacle", "phase": "build"},
  {"op": "title", "phase": "build"},
  {"op": "wait", "s": 1.0, "phase": "build"},
  {"op": "play", "folder": "_gm_events_spectacle", "phase": "build"},
  {"op": "wait", "s": 3.0, "phase": "build"},
  {"op": "wait_ready", "settle": 1.5, "phase": "build"},

  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "1920x1080"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "report"},

  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "bridge", "zoom": 11.0, "yaw": 56.0, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 2.0, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_0_before", "desc": "Bridge collapse, before: the plank bridge over the river at tabletop zoom, the camera turned 56 degrees to look west up the river so no crown stands in front of it"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "fire", "kind": "collapse", "seed": 7, "phase": "look", "for": "collapse_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_1_shudder", "desc": "0.3 s: the deck shudders on its posts (the real crossing hidden behind its pieces)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.4, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_2_break", "desc": "0.7 s: the middle breaks first, its pieces tipping into the gap"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.4, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_3_fall", "desc": "1.1 s: pieces falling, the first splashes where they meet the water"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_4_splash", "desc": "1.6 s: the bank ends down, splashes rising, the middle sinking"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "bridge", "phase": "look", "for": "collapse_4_gm"},
  {"op": "wait", "s": 0.5, "phase": "look", "for": "collapse_4_gm"},
  {"op": "capture", "name": "collapse_4_gm", "desc": "1.6 s as a GM sees it: the play angle, the bridge at the screen centre, the canopy fade thinning the crowns over it"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "bridge", "yaw": 56.0, "phase": "look", "for": "collapse_4_gm"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_5_settle", "desc": "2.1 s: the last pieces gone under, the spray fading"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.6, "phase": "look", "for": "collapse_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "free", "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_6_after", "desc": "After: the crossing removed (the live edit), the river open, the 'bridge fell' toast with Undo"},

  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "dismiss"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "forest", "zoom": 16.0, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 2.0, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_0_before", "desc": "Forest fall, before: the stand of trees at tabletop zoom"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "fire", "kind": "fall", "radius": 6.0, "seed": 7, "phase": "look", "for": "fall_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.45, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_1_tip", "desc": "0.45 s: the nearest trees tipping away from the centre"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_2_ripple", "desc": "0.95 s: the ripple running outward, the first trees landing in dust"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_3_down", "desc": "1.45 s: most trees down, dust over the crowns"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false, "phase": "look", "for": "fall_3_nofade"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_3_nofade"},
  {"op": "capture", "name": "fall_3_nofade", "desc": "1.45 s with the canopy fade off (A/B with fall_3_down): the fallen crowns should match, only the standing crowns in the window differ"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": true, "phase": "look", "for": "fall_3_nofade"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_4_settle", "desc": "1.95 s: the fallen trees settling into the ground under the dust"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_5_clear", "desc": "2.45 s: the last dust fading over open ground"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.6, "phase": "look", "for": "fall_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "free", "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 2.0, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_6_after", "desc": "After: the area cleared (the live edit), the 'trees fell' toast with Undo"},

  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "dismiss"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "undo", "phase": "look", "for": "*_presets*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "undo", "phase": "look", "for": "*_presets*"},
  {"op": "wait", "s": 2.0, "phase": "look", "for": "*_presets*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "dismiss", "phase": "look", "for": "*_presets*"},
  {"op": "expand", "values": ["1280x720", "1920x1080"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "put_away", "phase": "look", "for": "{value}_presets*"},
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "{value}", "phase": "look", "for": "{value}_presets*"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "{value}_presets*"},
   {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "forest", "zoom": 16.0, "phase": "look", "for": "{value}_presets*"},
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "open", "phase": "look", "for": "{value}_presets*"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "{value}_presets*"},
   {"op": "capture", "name": "{value}_presets", "desc": "{value}: the Events pane with its Presets field (Collapse, Topple) above Brushes, nothing picked"},
   {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "arm", "preset": "topple", "phase": "look", "for": "{value}_presets_topple"},
   {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "hover", "at": "forest", "phase": "look", "for": "{value}_presets_topple"},
   {"op": "wait", "s": 0.8, "phase": "look", "for": "{value}_presets_topple"},
   {"op": "capture", "name": "{value}_presets_topple", "desc": "{value}: Topple picked: its tile pressed, its gesture line and the Advanced size; the ochre ring with 'Topple trees' on the board, no fill over the crowns; Topple's keys lead the hint bar"}
  ]},

  {"op": "index", "title": "Terrain events", "intro": "The GM's presets with spectacle (card gm-events-2b): a bridge collapse and a forest fall, filmstrips at tabletop zoom, and the pane."}
 ]
}
