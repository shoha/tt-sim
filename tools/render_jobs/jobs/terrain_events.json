   {"op": "wait", "s": 0.8, "phase": "look", "for": "{value}_pane_topple"},
   {"op": "capture", "name": "{value}_pane_topple", "desc": "{value}: Topple trees picked: its tile pressed, its gesture line and Advanced (size only) directly under the Happenings row; the ochre ring, a small ochre spot on the ground at the foot of each tree that will fall, inside the ring, and 'Topple trees' in a glass chip; the short keys lead the hint bar"},
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "put_away", "phase": "look", "for": "{value}_pane_putaway"},
   {"op": "wait", "s": 0.5, "phase": "look", "for": "{value}_pane_putaway"},
   {"op": "capture", "name": "{value}_pane_putaway", "desc": "{value}: Topple trees put away: the line and Advanced gone with it, the pane as {value}_pane_fresh"},
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "arm", "tool": "ignite", "radius": 6.0, "phase": "look", "for": "{value}_pane_ignite"},
   {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "hover", "at": "forest", "phase": "look", "for": "{value}_pane_ignite"},
   {"op": "wait", "s": 0.8, "phase": "look", "for": "{value}_pane_ignite"},
