  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/terrain_events", "out": "sheet_fire", "columns": 3, "names": ["fire_1_catch", "fire_2_spread", "fire_3_front", "fire_4_rim", "fire_5_smoke", "fire_6_change"], "phase": "look", "for": "fire_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "dismiss", "phase": "look", "for": "fire_*"},
