{
 "out_dir": "render_jobs/terrain_events",
 "timeout_s": 600,
 "hang_s": 90,
 "saved": {"folder": "_gm_events_spectacle", "load": "play"},
 "steps": [
  {"op": "wait_title"},
  {"op": "wait", "s": 1.0},

  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "look_at", "at": [0, 0], "phase": "build"},
  {"op": "zoom", "size": 20.0, "phase": "build"},
  {"op": "wait", "s": 1.5, "phase": "build"},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.8, "speed": 4.0, "curve": true, "points": [[-21, 5], [-14, 6], [-7, 4], [0, 1], [7, 0], [14, 1], [21, -2]], "phase": "build"},
  {"op": "wait_ready", "settle": 0.5, "phase": "build"},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "plank", "from": [-7, 2.5], "to": [-7, 5.5], "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "stones", "from": [14, -2], "to": [14, 4], "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "save", "folder": "_gm_events_spectacle", "phase": "build"},
  {"op": "title", "phase": "build"},
  {"op": "wait", "s": 1.0, "phase": "build"},
  {"op": "play", "folder": "_gm_events_spectacle", "phase": "build"},
  {"op": "wait", "s": 3.0, "phase": "build"},
  {"op": "wait_ready", "settle": 1.5, "phase": "build"},

  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "1920x1080"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "report"},

  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "bridge", "zoom": 11.0, "yaw": 56.0, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 2.0, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_0_before", "desc": "Bridge collapse, before: the plank bridge over the river at tabletop zoom, the camera turned 56 degrees to look west up the river so no crown stands in front of it"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "fire", "kind": "collapse", "seed": 7, "phase": "look", "for": "collapse_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_1_shudder", "desc": "0.3 s: the deck shudders on its posts (the real crossing hidden behind its pieces)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.4, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_2_break", "desc": "0.7 s: the middle breaks first, its pieces tipping into the gap"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.4, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_3_fall", "desc": "1.1 s: pieces falling, the first splashes where they meet the water"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_4_splash", "desc": "1.6 s: the bank ends down, splashes rising, the middle sinking"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "bridge", "phase": "look", "for": "collapse_4_gm"},
  {"op": "wait", "s": 0.5, "phase": "look", "for": "collapse_4_gm"},
  {"op": "capture", "name": "collapse_4_gm", "desc": "1.6 s as a GM sees it: the play angle, the bridge at the screen centre, the canopy fade thinning the crowns over it"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "bridge", "yaw": 56.0, "phase": "look", "for": "collapse_4_gm"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_5_settle", "desc": "2.1 s: the last pieces gone under, the spray fading"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.6, "phase": "look", "for": "collapse_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "free", "phase": "look", "for": "collapse_*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "collapse_*"},
  {"op": "capture", "name": "collapse_6_after", "desc": "After: the crossing removed (the live edit), the river open, the 'bridge fell' toast with Undo"},

  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "dismiss"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "forest", "zoom": 16.0, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 2.0, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_0_before", "desc": "Forest fall, before: the stand of trees at tabletop zoom"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "fire", "kind": "fall", "radius": 6.0, "seed": 7, "phase": "look", "for": "fall_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.45, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_1_tip", "desc": "0.45 s: the nearest trees tipping away from the centre"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_2_ripple", "desc": "0.95 s: the ripple running outward, the first trees landing in dust"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_3_down", "desc": "1.45 s: most trees down, dust over the crowns"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false, "phase": "look", "for": "fall_3_nofade"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_3_nofade"},
  {"op": "capture", "name": "fall_3_nofade", "desc": "1.45 s with the canopy fade off (A/B with fall_3_down): the fallen crowns should match, only the standing crowns in the window differ"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": true, "phase": "look", "for": "fall_3_nofade"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_4_settle", "desc": "1.95 s: the fallen trees settling into the ground under the dust"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.5, "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_5_clear", "desc": "2.45 s: the last dust fading over open ground"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "advance", "s": 0.6, "phase": "look", "for": "fall_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "free", "phase": "look", "for": "fall_*"},
  {"op": "wait", "s": 2.0, "phase": "look", "for": "fall_*"},
  {"op": "capture", "name": "fall_6_after", "desc": "After: the area cleared (the live edit), the 'trees fell' toast with Undo"},

  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "dismiss"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "open", "phase": "look", "for": "pane_nobridge"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "pane_nobridge"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "tile", "id": "collapse", "phase": "look", "for": "pane_nobridge"},
  {"op": "capture", "name": "pane_nobridge", "desc": "After the drop, before the undo: no bridge stands, so the Drop bridge tile is disabled (the tile step logs its tooltip, which says why); Topple trees stays available"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "close", "phase": "look", "for": "pane_nobridge"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "undo", "phase": "look", "for": "*pane_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "undo", "phase": "look", "for": "*pane_*"},
  {"op": "wait", "s": 2.0, "phase": "look", "for": "*pane_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "dismiss", "phase": "look", "for": "*pane_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "bridge", "zoom": 11.0, "yaw": 56.0},
  {"op": "wait", "s": 0.3},
  {"op": "eval", "expr": "_game_map.camera_node.near"},
  {"op": "eval", "expr": "_game_map.camera_node.global_position"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "bridge", "zoom": 11.0},
  {"op": "wait", "s": 0.3},
  {"op": "eval", "expr": "_game_map.camera_node.near"},
  {"op": "expand", "values": ["1280x720", "1920x1080"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "put_away", "phase": "look", "for": "{value}_pane_*"},
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "{value}", "phase": "look", "for": "{value}_pane_*"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "{value}_pane_*"},
   {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "forest", "zoom": 16.0, "phase": "look", "for": "{value}_pane_*"},
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "open", "phase": "look", "for": "{value}_pane_*"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "{value}_pane_*"},
   {"op": "capture", "name": "{value}_pane_fresh", "desc": "{value}: the Events pane, nothing picked: the Happenings tiles (Drop bridge, Topple trees) above Brushes"},
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "arm", "tool": "topple", "radius": 6.0, "phase": "look", "for": "{value}_pane_topple,{value}_pane_putaway"},
   {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "hover", "at": "forest", "phase": "look", "for": "{value}_pane_topple"},
   {"op": "wait", "s": 0.8, "phase": "look", "for": "{value}_pane_topple"},
   {"op": "capture", "name": "{value}_pane_topple", "desc": "{value}: Topple trees picked: its tile pressed, its gesture line and Advanced (size only) directly under the Happenings row; the ochre ring, a short ochre blaze across each trunk that will fall, and 'Topple trees' in a glass chip; the short keys lead the hint bar"},
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "put_away", "phase": "look", "for": "{value}_pane_putaway"},
   {"op": "wait", "s": 0.5, "phase": "look", "for": "{value}_pane_putaway"},
   {"op": "capture", "name": "{value}_pane_putaway", "desc": "{value}: Topple trees put away: the line and Advanced gone with it, the pane as {value}_pane_fresh"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "bridge", "zoom": 11.0, "phase": "look", "for": "pane_drop_bridge"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "arm", "preset": "collapse", "phase": "look", "for": "pane_drop_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "hover", "at": "bridge", "phase": "look", "for": "pane_drop_bridge"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "pane_drop_bridge"},
  {"op": "capture", "name": "pane_drop_bridge", "desc": "1920: Drop bridge armed over the plank bridge: the ochre outline and 'Drop bridge' in a glass chip; its line under the Happenings row, no Advanced"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": [14, 1], "zoom": 11.0, "phase": "look", "for": "pane_drop_stones"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "hover_crossing", "kind": "stones", "phase": "look", "for": "pane_drop_stones"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "pane_drop_stones"},
  {"op": "capture", "name": "pane_drop_stones", "desc": "1920: Drop bridge over the stepping stones: the small ochre ring and 'Only a bridge falls'"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "put_away", "phase": "look", "for": "pane_toasts_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "close", "phase": "look", "for": "pane_toasts_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "1280x720", "phase": "look", "for": "pane_toasts_720"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "pane_toasts_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "forest", "zoom": 16.0, "phase": "look", "for": "pane_toasts_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "toasts", "phase": "look", "for": "pane_toasts_720"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "pane_toasts_720"},
  {"op": "capture", "name": "pane_toasts_720", "desc": "1280x720, the GM's view with the drawer aside: both events' toasts ('The bridge fell for everyone at the table', 'The trees fell ...'), each with Undo"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "dismiss", "phase": "look", "for": "pane_toasts_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "1920x1080", "phase": "look", "for": "pane_dusk_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "open", "phase": "look", "for": "pane_dusk_*,pane_player_720"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "pane_dusk_*,pane_player_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "dusk", "hour": 19.0, "phase": "look", "for": "pane_dusk_*,pane_player_720"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "pane_dusk_*,pane_player_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "forest", "zoom": 16.0, "phase": "look", "for": "pane_dusk_topple"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "arm", "tool": "topple", "radius": 6.0, "phase": "look", "for": "pane_dusk_topple"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "hover", "at": "forest", "phase": "look", "for": "pane_dusk_topple"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "pane_dusk_topple"},
  {"op": "capture", "name": "pane_dusk_topple", "desc": "1920 at dusk (19:00): the Topple trees ring, trunk blazes and chip over a dark board"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "bridge", "zoom": 11.0, "phase": "look", "for": "pane_dusk_drop"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "arm", "preset": "collapse", "phase": "look", "for": "pane_dusk_drop"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "hover", "at": "bridge", "phase": "look", "for": "pane_dusk_drop"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "pane_dusk_drop"},
  {"op": "capture", "name": "pane_dusk_drop", "desc": "1920 at dusk: the Drop bridge outline and chip over the dark river"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "1280x720", "phase": "look", "for": "pane_player_720"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "pane_player_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "forest", "zoom": 16.0, "phase": "look", "for": "pane_player_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "toasts", "phase": "look", "for": "pane_player_720"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "player", "phase": "look", "for": "pane_player_720"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "pane_player_720"},
  {"op": "capture", "name": "pane_player_720", "desc": "1280x720 as a player sees the table once an event lands: no toast and so no Undo (the event toasts are the GM's; a player sees the spectacle on the board, UI_TASTE M7, G14)"},

  {"op": "index", "title": "Terrain events", "intro": "The GM's presets with spectacle (cards gm-events-2b, presets-pane-fix): a bridge collapse and a forest fall, filmstrips at tabletop zoom, and the pane: fresh, armed and put away at both sizes, Drop bridge over a bridge and over stepping stones, the disabled tile with no bridge, the toasts at 720p for the GM and a player, and the cursors at dusk."}
 ]
}
