  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "hover", "at": [-7, 4], "phase": "look", "for": "pane_ignite_refused"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "pane_ignite_refused"},
  {"op": "capture", "name": "pane_ignite_refused", "desc": "1920: Start a fire over the river by the plank bridge, no tree in its small ring: the ring in chalk_soft (a click does nothing there) and 'Only a forest burns' in its chip"},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "put_away", "phase": "look", "for": "pane_ignite_refused"},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_events.gd", "action": "look", "at": "bridge", "zoom": 11.0, "phase": "look", "for": "pane_drop_bridge"},
