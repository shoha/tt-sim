{
 "out_dir": "render_jobs/phase5_lakeshore",
 "timeout_s": 900,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "expand", "values": ["5", "1", "2"], "template": [
   {"op": "saved", "folder": "_p5j_lakeshore_temperate_forest_summer_s1_{value}"},
   {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": "{value}", "landform": "lakeshore", "phase": "build"},
   {"op": "wait_ready", "settle": 1.5, "phase": "build"},
   {"op": "no_autosave"},
   {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p5j_lakeshore_temperate_forest_summer_s1_{value}", "replace": true, "phase": "build"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "report", "landform": "lakeshore"},
   {"op": "hide_ui"},
   {"op": "home", "phase": "look", "for": "lakeshore_forest_{value}_home*"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "lakeshore_forest_{value}_home*"},
   {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "lakeshore_forest_{value}_home"},
   {"op": "wait", "s": 0.8, "phase": "look", "for": "lakeshore_forest_{value}_home"},
   {"op": "capture", "name": "lakeshore_forest_{value}_home", "desc": "Temperate forest, 150 ft, Lakeshore, seed {value}, the home camera with the grid: does the lake (its centre at 0.5 of the half extent toward its corner since P5-4) read as a place with its shore, the islet and the feeding stream when drawn"},
   {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "lakeshore_forest_{value}_home"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": false, "phase": "look", "for": "lakeshore_forest_{value}_home_nowater"},
   {"op": "wait", "s": 0.5, "phase": "look", "for": "lakeshore_forest_{value}_home_nowater"},
   {"op": "capture", "name": "lakeshore_forest_{value}_home_nowater", "desc": "The same with the water hidden: the basin, the rising shore and the islet"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": true},
   {"op": "zoom", "size": 8.0, "phase": "look", "for": "lakeshore_forest_{value}_*_z8"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "lakeshore_forest_{value}_*_z8"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "stage", "landform": "lakeshore", "phase": "look", "for": "lakeshore_forest_{value}_stage_z8"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "lakeshore_forest_{value}_stage_z8"},
   {"op": "capture", "name": "lakeshore_forest_{value}_stage_z8", "desc": "Zoom 8 on the stage on the shore nearest the centre"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "crossing", "landform": "lakeshore", "phase": "look", "for": "lakeshore_forest_{value}_feature_z8"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "lakeshore_forest_{value}_feature_z8"},
   {"op": "capture", "name": "lakeshore_forest_{value}_feature_z8", "desc": "Zoom 8 on the stepping stones, else the stream's middle, else the lake's near shore"},
   {"op": "title"},
   {"op": "wait", "s": 1.0}
  ]},

  {"op": "saved", "folder": "_p5j_lakeshore_wetland_riparian_summer_s1_5"},
  {"op": "new_map", "biome": "wetland_riparian_summer_s1", "size": 150, "seed": 5, "landform": "lakeshore", "phase": "build"},
  {"op": "wait_ready", "settle": 1.5, "phase": "build"},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p5j_lakeshore_wetland_riparian_summer_s1_5", "replace": true, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "report", "landform": "lakeshore"},
  {"op": "hide_ui"},
  {"op": "home", "phase": "look", "for": "lakeshore_wetland_5_home*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "lakeshore_wetland_5_home*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "lakeshore_wetland_5_home"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "lakeshore_wetland_5_home"},
  {"op": "capture", "name": "lakeshore_wetland_5_home", "desc": "Riverside wetland, 150 ft, Lakeshore, seed 5 (the forest's seed 5 among willows and reeds: islet, feeding stream, stones), the home camera with the grid"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "lakeshore_wetland_5_home"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": false, "phase": "look", "for": "lakeshore_wetland_5_home_nowater"},
  {"op": "wait", "s": 0.5, "phase": "look", "for": "lakeshore_wetland_5_home_nowater"},
  {"op": "capture", "name": "lakeshore_wetland_5_home_nowater", "desc": "The same with the water hidden"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": true},
  {"op": "zoom", "size": 8.0, "phase": "look", "for": "lakeshore_wetland_5_*_z8"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "lakeshore_wetland_5_*_z8"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "stage", "landform": "lakeshore", "phase": "look", "for": "lakeshore_wetland_5_stage_z8"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "lakeshore_wetland_5_stage_z8"},
  {"op": "capture", "name": "lakeshore_wetland_5_stage_z8", "desc": "Zoom 8 on the stage"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "crossing", "landform": "lakeshore", "phase": "look", "for": "lakeshore_wetland_5_feature_z8"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "lakeshore_wetland_5_feature_z8"},
  {"op": "capture", "name": "lakeshore_wetland_5_feature_z8", "desc": "Zoom 8 on the stepping stones"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},

  {"op": "play", "folder": "_p5j_lakeshore_temperate_forest_summer_s1_5", "phase": "look", "for": "lakeshore_forest_5_play_*"},
  {"op": "wait", "s": 3.0, "phase": "look", "for": "lakeshore_forest_5_play_*"},
  {"op": "wait_ready", "settle": 2.0, "phase": "look", "for": "lakeshore_forest_5_play_*"},
  {"op": "hide_ui", "phase": "look", "for": "lakeshore_forest_5_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540], "phase": "look", "for": "lakeshore_forest_5_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "tokens", "points": [[-1.5, -1.5], [14.9, -12.5]], "phase": "look", "for": "lakeshore_forest_5_play_*"},
  {"op": "wait", "s": 3.0, "phase": "look", "for": "lakeshore_forest_5_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "report", "phase": "look", "for": "lakeshore_forest_5_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "lakeshore_forest_5_play_*"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "lakeshore_forest_5_play_*"},
  {"op": "home", "phase": "look", "for": "lakeshore_forest_5_play_home_grid"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "lakeshore_forest_5_play_home_grid"},
  {"op": "capture", "name": "lakeshore_forest_5_play_home_grid", "desc": "Seed 5 in play, home zoom, grid on: a token on the stage and one on the stepping stones"},
  {"op": "title", "phase": "look", "for": "lakeshore_forest_5_play_*"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "lakeshore_forest_5_play_*"},

  {"op": "index", "title": "P5-4 judgment set: Lakeshore", "intro": "Produced by tools/render_jobs/jobs/phase5_lakeshore.json at 1920x1080. New 150 ft Lakeshore maps through the driver's new_map op, saved as _p5j_lakeshore_<biome>_<seed>: temperate forest seeds 5 (islet, feeding stream, stones), 1 (a stream, no stones) and 2 (the lake alone), and riverside wetland seed 5. Per level: home with the grid, home with the water hidden, zoom 8 on the stage and on the stones, the stream or the shore; then seed 5 played with tokens. The recipe's report per level is in log.txt."}
 ]
}
