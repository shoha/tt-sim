{
 "out_dir": "render_jobs/phase5_valley",
 "timeout_s": 900,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "expand", "values": ["3", "2", "1234"], "template": [
   {"op": "saved", "folder": "_p5j_valley_temperate_forest_summer_s1_{value}"},
   {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": "{value}", "landform": "valley", "phase": "build"},
   {"op": "wait_ready", "settle": 1.5, "phase": "build"},
   {"op": "no_autosave"},
   {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p5j_valley_temperate_forest_summer_s1_{value}", "replace": true, "phase": "build"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "report", "landform": "valley"},
   {"op": "hide_ui"},
   {"op": "home", "phase": "look", "for": "valley_forest_{value}_home*"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "valley_forest_{value}_home*"},
   {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "valley_forest_{value}_home"},
   {"op": "wait", "s": 0.8, "phase": "look", "for": "valley_forest_{value}_home"},
   {"op": "capture", "name": "valley_forest_{value}_home", "desc": "Temperate forest, 150 ft, Valley, seed {value}, the home camera with the grid: does the trough read as a valley from here, with a bluff on the outer bank when the seed drew one, the water in its floor and the floor open under the forest (the glade along the floor since P5-7)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "valley_forest_{value}_home"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": false, "phase": "look", "for": "valley_forest_{value}_home_nowater"},
   {"op": "wait", "s": 0.5, "phase": "look", "for": "valley_forest_{value}_home_nowater"},
   {"op": "capture", "name": "valley_forest_{value}_home_nowater", "desc": "The same with the water hidden: the shaped ground alone"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": true},
   {"op": "zoom", "size": 8.0, "phase": "look", "for": "valley_forest_{value}_*_z8"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "valley_forest_{value}_*_z8"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "stage", "landform": "valley", "phase": "look", "for": "valley_forest_{value}_stage_z8"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "valley_forest_{value}_stage_z8"},
   {"op": "capture", "name": "valley_forest_{value}_stage_z8", "desc": "Zoom 8 on the stage on the inner bank"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "crossing", "landform": "valley", "phase": "look", "for": "valley_forest_{value}_feature_z8"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "valley_forest_{value}_feature_z8"},
   {"op": "capture", "name": "valley_forest_{value}_feature_z8", "desc": "Zoom 8 on the crossing, else the river's middle, else the dry floor"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "steepest", "landform": "valley", "phase": "look", "for": "valley_forest_{value}_bluff_z8"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "valley_forest_{value}_bluff_z8"},
   {"op": "capture", "name": "valley_forest_{value}_bluff_z8", "desc": "Zoom 8 on the steepest ground: the bluff's rock face when the seed drew one, else the steepest of the cosine slope"},
   {"op": "title"},
   {"op": "wait", "s": 1.0}
  ]},

  {"op": "saved", "folder": "_p5j_valley_grassland_meadow_summer_s1_3"},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 3, "landform": "valley", "phase": "build"},
  {"op": "wait_ready", "settle": 1.5, "phase": "build"},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p5j_valley_grassland_meadow_summer_s1_3", "replace": true, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "report", "landform": "valley"},
  {"op": "hide_ui"},
  {"op": "home", "phase": "look", "for": "valley_grassland_3_home*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "valley_grassland_3_home*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "valley_grassland_3_home"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "valley_grassland_3_home"},
  {"op": "capture", "name": "valley_grassland_3_home", "desc": "Grassland meadow, 150 ft, Valley, seed 3 (the forest's seed 3 drawn in open grass), the home camera with the grid"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "valley_grassland_3_home"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": false, "phase": "look", "for": "valley_grassland_3_home_nowater"},
  {"op": "wait", "s": 0.5, "phase": "look", "for": "valley_grassland_3_home_nowater"},
  {"op": "capture", "name": "valley_grassland_3_home_nowater", "desc": "The same with the water hidden"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": true},
  {"op": "zoom", "size": 8.0, "phase": "look", "for": "valley_grassland_3_*_z8"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "valley_grassland_3_*_z8"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "stage", "landform": "valley", "phase": "look", "for": "valley_grassland_3_stage_z8"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "valley_grassland_3_stage_z8"},
  {"op": "capture", "name": "valley_grassland_3_stage_z8", "desc": "Zoom 8 on the stage"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "crossing", "landform": "valley", "phase": "look", "for": "valley_grassland_3_feature_z8"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "valley_grassland_3_feature_z8"},
  {"op": "capture", "name": "valley_grassland_3_feature_z8", "desc": "Zoom 8 on the crossing, else the river"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "steepest", "landform": "valley", "phase": "look", "for": "valley_grassland_3_bluff_z8"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "valley_grassland_3_bluff_z8"},
  {"op": "capture", "name": "valley_grassland_3_bluff_z8", "desc": "Zoom 8 on the bluff's rock face in open grass"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},

  {"op": "play", "folder": "_p5j_valley_temperate_forest_summer_s1_3", "phase": "look", "for": "valley_forest_3_play_*"},
  {"op": "wait", "s": 3.0, "phase": "look", "for": "valley_forest_3_play_*"},
  {"op": "wait_ready", "settle": 2.0, "phase": "look", "for": "valley_forest_3_play_*"},
  {"op": "hide_ui", "phase": "look", "for": "valley_forest_3_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540], "phase": "look", "for": "valley_forest_3_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "tokens", "points": [[-9.7, 2.0], [-4.9, 5.3]], "phase": "look", "for": "valley_forest_3_play_*"},
  {"op": "wait", "s": 3.0, "phase": "look", "for": "valley_forest_3_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "report", "phase": "look", "for": "valley_forest_3_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "valley_forest_3_play_*"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "valley_forest_3_play_*"},
  {"op": "home", "phase": "look", "for": "valley_forest_3_play_home_grid"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "valley_forest_3_play_home_grid"},
  {"op": "capture", "name": "valley_forest_3_play_home_grid", "desc": "Seed 3 in play, home zoom, grid on: a token on the stage and one in the river at the crossing"},
  {"op": "title", "phase": "look", "for": "valley_forest_3_play_*"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "valley_forest_3_play_*"},

  {"op": "index", "title": "P5-7 judgment set: Valley", "intro": "Produced by tools/render_jobs/jobs/phase5_valley.json at 1920x1080. New 150 ft Valley maps through the driver's new_map op, saved as _p5j_valley_<biome>_<seed>: temperate forest seeds 3, 2 and 1234 and grassland meadow seed 3. Since P5-7 the starting cover's glade is the valley floor (the glade's density within the floor's half-width of the axis, the groves back by the rim) in place of a round glade on the stage, and the crossing stands only where the river is wet. Per level: home with the grid, home with the water hidden, zoom 8 on the stage, zoom 8 on the crossing, the river or the dry floor; then seed 3 played with tokens. The recipe's report per level is in log.txt."}
 ]
}
