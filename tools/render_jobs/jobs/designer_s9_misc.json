{
 "out_dir": "render_jobs/designer-s9_misc",
 "timeout_s": 600,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "wait_title"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "open", "library": "core", "biome": "temperate_forest"},
  {"op": "wait_ready", "settle": 3.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/tree_fade.gd", "factor": 0},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "debounce", "seconds": 0.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1600, 900]},
  {"op": "wait", "s": 1.0},

  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "lock_all", "on": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer.gd", "action": "select", "rule": "oak"},
  {"op": "wait", "s": 0.5},
  {"op": "capture", "name": "a_locked_all", "desc": "Lock all: the slots' header says 18 of 18 locked (not saved); the oak rule's lock words say it is locked"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "query", "rule": "oak", "field": "order", "value": "id"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "state"},
  {"op": "capture", "name": "b_stale_lock", "desc": "the oak query changed after the lock: its chip carries the warning mark, the inspector says the lock is ignored and offers Lock again; the header counts one stale"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "lock_all", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "focus", "rule": "oak"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "c_show_only_oak", "desc": "Show only this: every other rule's plants hidden, the oaks alone on the proving ground (Show only this pressed in the inspector)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "focus", "rule": ""},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "search", "text": "zzz"},
  {"op": "wait", "s": 0.5},
  {"op": "capture", "name": "d_picker_empty", "desc": "a search that finds nothing: what to relax (drop the search) and Request asset"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1280, 800]},
  {"op": "wait", "s": 1.0},
  {"op": "settle"},
  {"op": "capture", "name": "e_picker_empty_1280", "desc": "the same at 1280x800"},
  {"op": "call", "script": "res://tools/render_jobs/probes/designer_s9.gd", "action": "search", "text": ""},
  {"op": "title"}, {"op": "wait", "s": 1.0}
 ]
}
