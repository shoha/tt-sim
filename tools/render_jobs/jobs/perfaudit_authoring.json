{
 "out_dir": "render_jobs/perfaudit_authoring",
 "timeout_s": 2400,
 "hang_s": 120,
 "remove_override": true,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "start"},
  {"op": "expand", "values": ["320", "100", "200"], "template": [
   {"op": "title"},
   {"op": "wait", "s": 1.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "author", "biome": "temperate_forest_summer_s1", "size": "{value}", "seed": 1234},
   {"op": "wait_ready", "settle": 1.5},
   {"op": "no_autosave"},
   {"op": "hide_ui"},
   {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
   {"op": "wind", "freeze": true},
   {"op": "look_at", "at": [0, 0]},
   {"op": "zoom", "size": 26},
   {"op": "vsync_off"},
   {"op": "settle"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "mem", "tag": "{value}_open"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "idle_{value}"},
   {"op": "wait", "s": 2.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "micro", "reps": 5, "tag": "{value}"},
   {"op": "wait", "s": 0.5},

   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "sculpt_raise_{value}"},
   {"op": "stroke", "mode": "sculpt", "tile": "raise", "radius": 4.0, "speed": 4.0, "points": [[-10, -6], [10, -6]], "keep_active": true},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "sculpt_smooth_{value}"},
   {"op": "stroke", "mode": "sculpt", "tile": "smooth", "radius": 4.0, "speed": 4.0, "points": [[-10, -6], [10, -6]], "keep_active": true},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},

   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "paint_cobble_first_{value}"},
   {"op": "stroke", "mode": "surface", "surface": "cobblestone", "radius": 3.0, "speed": 4.0, "points": [[-10, -1], [10, -1]], "keep_active": true},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "paint_cobble_warm_{value}"},
   {"op": "stroke", "mode": "surface", "surface": "cobblestone", "radius": 3.0, "speed": 4.0, "points": [[-10, 1], [10, 1]], "keep_active": true},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "paint_gravel_{value}"},
   {"op": "stroke", "mode": "surface", "surface": "gravel", "radius": 3.0, "speed": 4.0, "points": [[-10, 2.5], [10, 2.5]], "keep_active": true},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},

   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "biome_add_{value}"},
   {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "radius": 4.0, "speed": 4.0, "points": [[-10, 5], [10, 5]], "keep_active": true},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "biome_add2_{value}"},
   {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "radius": 4.0, "speed": 4.0, "points": [[10, 5.5], [-10, 5.5]], "keep_active": true},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "biome_clear_{value}"},
   {"op": "stroke", "mode": "clear", "radius": 4.0, "speed": 4.0, "points": [[-10, 5], [10, 5]], "keep_active": true},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},

   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "river_{value}"},
   {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.8, "speed": 4.0, "points": [[-12, 10], [12, 10]], "keep_active": true},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "river2_{value}"},
   {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 4.0, "points": [[13, -5], [13, 5]], "keep_active": true},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},

   {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"bridge\")"},
   {"op": "bridge_kind", "kind": "plank"},
   {"op": "eval", "expr": "_authoring_controller.panel.close()"},
   {"op": "hide_ui"},
   {"op": "gesture", "points": [[0, 7.2], [0, 9.0]], "speed": 3.0, "release": false},
   {"op": "gesture", "points": [[0, 9.0], [0.2, 12.8]], "speed": 3.0, "press": false, "release": false},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "bridge_release_{value}"},
   {"op": "input", "events": [{"type": "release", "at": [0.2, 12.8]}]},
   {"op": "wait", "s": 1.0},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "timing"},

   {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "wall_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "place", "kind": "stone", "from": [-11, -11], "to": [-3, -11]},
   {"op": "wait", "s": 1.0},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
   {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [1, -12], "to": [12, -12], "preset": 2, "seed": 3},
   {"op": "settle", "timeout": 30},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "dress_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.0},
   {"op": "wait", "s": 1.5},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "eval", "expr": "_authoring_controller.panel.close()"},

   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "undo_redo_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "undo", "count": 4},
   {"op": "wait", "s": 1.0},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "rebake_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rebake"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "mem", "tag": "{value}_edited"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "micro", "reps": 5, "tag": "{value}_edited"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "begin", "name": "idle_end_{value}"},
   {"op": "wait", "s": 2.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "rec", "mode": "end"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/perfaudit_authoring.gd", "action": "table"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "end"}
 ]
}
