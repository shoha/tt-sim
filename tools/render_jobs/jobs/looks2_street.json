{
 "out_dir": "render_jobs/looks2_street",
 "timeout_s": 400,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 250, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 0.9},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.0},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "corridor"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "report"},
  {"op": "hide_ui"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 60.0},
  {"op": "settle"},
  {"op": "capture", "name": "street_home", "desc": "hamlet (left) and market town (right), home zoom"},
  {"op": "look_at", "at": [18, 0]},
  {"op": "zoom", "size": 24.0},
  {"op": "settle"},
  {"op": "capture", "name": "market_close", "desc": "market town close"},
  {"op": "look_at", "at": [-18, 0]},
  {"op": "zoom", "size": 24.0},
  {"op": "settle"},
  {"op": "capture", "name": "hamlet_close", "desc": "farming hamlet close"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "aim", "prop": "hand_cart", "min_scale": 1.3, "index": 0, "zoom": 9.0},
  {"op": "settle"},
  {"op": "capture", "name": "hero_cart", "desc": "first hero hand cart (the first cart when there are no heroes)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "aim", "prop": "well", "index": 0, "zoom": 9.0},
  {"op": "settle"},
  {"op": "capture", "name": "hero_well", "desc": "first well"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "aim", "prop": "lamp_post", "index": 1, "zoom": 6.0},
  {"op": "settle"},
  {"op": "capture", "name": "lamp_close", "desc": "second lamp post close"}
 ]
}
