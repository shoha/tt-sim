{
 "out_dir": "render_jobs/building_ui2",
 "timeout_s": 420,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [1200, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "hints", "reset": true},
  {"op": "look_at", "at": [4, 0]},
  {"op": "zoom", "size": 16.0},
  {"op": "stroke", "mode": "water", "shape": "pond", "depth": "deep", "radius": 8.0, "speed": 2.5, "points": [[9, 0], [9, 1]], "hold": 0.6},
  {"op": "wait", "s": 1.0},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"structure\")"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "01_palette", "desc": "The Building pane: chips with counts, Clear and the small-tiles switch above 80 px tiles; the hint bar with key caps along the bottom"},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "hover", "ref": "core:cottage"},
  {"op": "wait", "s": 0.6},
  {"op": "capture", "name": "02_hover_card", "desc": "The pointer on a tile: a card beside it with a bigger picture, the name, family, a few tags and the starting size"},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "hover"},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "chip", "id": "home", "on": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "chip", "id": "stone", "on": true},
  {"op": "wait", "s": 0.5},
  {"op": "capture", "name": "03_chips", "desc": "Home and Stone on: counts of the other chips follow, the tally sits on Clear"},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "chip", "id": "clear"},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "small", "on": true},
  {"op": "wait", "s": 0.5},
  {"op": "capture", "name": "04_small_tiles", "desc": "Small tiles: 48 px pictures, more of the list on one screen"},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "small", "on": false},
  {"op": "input", "events": [{"type": "move", "at": [2, 0]}]},
  {"op": "wait", "s": 0.8},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "note"},
  {"op": "capture", "name": "05_moved_note", "desc": "The ghost at the pond's edge: it eased onto dry ground and an amber note says what it moved off; the lines are amber"},
  {"op": "input", "events": [{"type": "move", "at": [9, 0]}]},
  {"op": "wait", "s": 0.8},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "note"},
  {"op": "capture", "name": "06_blocked_note", "desc": "The ghost in the middle of the pond: nothing in reach is dry, the lot is red and the reason sits under the name and size"},
  {"op": "input", "events": [{"type": "move", "at": [0, -4]}, {"type": "press", "at": [0, -4]}, {"type": "move", "at": [2, -6]}, {"type": "move", "at": [8, -10]}, {"type": "move", "at": [12, -14]}]},
  {"op": "wait", "s": 0.6},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "note"},
  {"op": "capture", "name": "07_size_stop", "desc": "A drag past the largest size: the lot stops at the recipe's range and the note states the biggest size in feet"},
  {"op": "input", "events": [{"type": "press", "at": [12, -14], "button": "right"}, {"type": "release", "at": [12, -14], "button": "right"}, {"type": "release", "at": [12, -14]}]},
  {"op": "wait", "s": 0.4},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "lay", "ref": "core:cottage", "at": [-8, -6], "size": [6, 4]},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "flush"},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "bar", "press": "done"},
  {"op": "input", "events": [{"type": "move", "at": [-8, -6]}]},
  {"op": "wait", "s": 0.4},
  {"op": "input", "events": [{"type": "press", "at": [-8, -6]}, {"type": "release", "at": [-8, -6]}]},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "report"},
  {"op": "capture", "name": "08_selected", "desc": "The cottage selected: the bar with buttons, steppers, the Decorate row and Style tiles; the hint bar now names the selection's keys"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "bar", "press": "done"},
  {"op": "input", "events": [{"type": "move", "at": [-12, 8]}]},
  {"op": "wait", "s": 0.5},
  {"op": "input", "events": [{"type": "press", "at": [-12, 8]}, {"type": "release", "at": [-12, 8]}]},
  {"op": "wait", "s": 1.5},
  {"op": "input", "events": [{"type": "move", "at": [-6, 12]}]},
  {"op": "wait", "s": 0.6},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "hints"},
  {"op": "capture", "name": "09_hint_faded", "desc": "After one click laid a building the Click key has left the bar; the keys not yet done stay"},
  {"op": "call", "script": "res://tools/render_jobs/probes/building_ui2.gd", "action": "hints", "reset": true}
 ]
}
