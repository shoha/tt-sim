{
  "out_dir": "render_jobs/hitches2_cold",
  "timeout_s": 180,
  "hang_s": 90,
  "remove_override": true,
  "steps": [
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 300, "seed": 1234},
    {"op": "wait_ready", "settle": 1.5},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
    {"op": "wind", "freeze": true},
    {"op": "look_at", "at": [0, 0]},
    {"op": "zoom", "size": 60.0},
    {"op": "vsync_off"},
    {"op": "settle"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "cold"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "place1_after_cold_probe"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "place", "count": 1, "seed": 100},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "split"},
    {"op": "title"}
  ]
}
