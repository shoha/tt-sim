{
  "out_dir": "render_jobs/structures-dressing_perf",
  "timeout_s": 300,
  "hang_s": 120,
  "remove_override": true,
  "steps": [
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 300, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
    {"op": "look_at", "at": [0, 0]},
    {"op": "zoom", "size": 60.0},
    {"op": "vsync_off"},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "dressing", "on": false},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "many", "count": 20},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "off_a"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "off_a"},
    {"op": "wait", "s": 6.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "dressing", "on": true},
    {"op": "wait", "s": 3.0},
    {"op": "capture", "name": "05_twenty_dressed", "desc": "Twenty structures with yards, the perf scene"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "on_a"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "on_a"},
    {"op": "wait", "s": 6.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "dressing", "on": false},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "off_b"},
    {"op": "wait", "s": 6.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "dressing", "on": true},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "on_b"},
    {"op": "wait", "s": 6.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
    {"op": "title"}
  ]
}
