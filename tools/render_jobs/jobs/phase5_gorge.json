   {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "gorge_forest_{value}_home"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": false, "phase": "look", "for": "gorge_forest_{value}_home_nowater"},
   {"op": "wait", "s": 0.5, "phase": "look", "for": "gorge_forest_{value}_home_nowater"},
