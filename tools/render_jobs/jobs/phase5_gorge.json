  {"op": "hide_ui", "phase": "look", "for": "gorge_forest_7_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540], "phase": "look", "for": "gorge_forest_7_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "tokens", "points": [[-4.1, 8.9], [0.5, 2.0]], "phase": "look", "for": "gorge_forest_7_play_*"},
  {"op": "wait", "s": 3.0, "phase": "look", "for": "gorge_forest_7_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "report", "phase": "look", "for": "gorge_forest_7_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "gorge_forest_7_play_*"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "gorge_forest_7_play_*"},
  {"op": "home", "phase": "look", "for": "gorge_forest_7_play_home_grid"},
