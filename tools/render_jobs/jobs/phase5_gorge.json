   {"op": "wait", "s": 1.5, "phase": "look", "for": "gorge_forest_{value}_stage_z8"},
   {"op": "capture", "name": "gorge_forest_{value}_stage_z8", "desc": "Zoom 8 on the stage on the near rim"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "crossing", "landform": "gorge", "phase": "look", "for": "gorge_forest_{value}_feature_z8"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "gorge_forest_{value}_feature_z8"},
   {"op": "capture", "name": "gorge_forest_{value}_feature_z8", "desc": "Zoom 8 on the arch with the stream under it, else the stream's middle, else the dry floor with its wash"},
