{
 "out_dir": "render_jobs/firefeat_variants",
 "timeout_s": 1200,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "expand", "values": ["1920x1080", "1280x720"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "{value}"},
   {"op": "wait", "s": 1.0},
   {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 200, "seed": 1234},
   {"op": "wait_ready", "settle": 1.0},
   {"op": "no_autosave"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "day_home", "label": ""},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
   {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "points": [[9, -28], [9, 28]], "speed": 5.0, "radius": 9.0, "flow": 2.0},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "points": [[19, 28], [19, -28]], "speed": 5.0, "radius": 9.0, "flow": 2.0},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "points": [[28, -28], [28, 28]], "speed": 5.0, "radius": 9.0, "flow": 2.0},
   {"op": "wait_ready", "settle": 1.0},

   {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"fire\")"},
   {"op": "home"},
   {"op": "wait", "s": 1.0},
   {"op": "input", "events": [{"type": "move", "at": [5, 5]}]},
   {"op": "wait", "s": 1.0},
   {"op": "input", "events": [{"type": "key", "key": "tab"}, {"type": "key", "key": "tab", "pressed": false}]},
   {"op": "wait", "s": 1.0},
   {"op": "eval", "expr": "_authoring_controller.panel.close()"},
   {"op": "hide_ui"},
   {"op": "eval", "expr": "_authoring_controller.brush.set_radius(2.5)"},
   {"op": "eval", "expr": "_authoring_controller.brush.mode.set(\"intensity\", 255)"},
   {"op": "look_at", "at": [3, 0]},
   {"op": "zoom", "size": 22.0},
   {"op": "wait", "s": 1.5},
   {"op": "look_at", "at": [3, 0]},
   {"op": "wait", "s": 0.5},

   {"op": "gesture", "points": [[22, 14], [17, 10], [12, 8], [7, 7.5], [2, 5], [-3, 1], [-7, -4], [-10, -10], [-16, -14]], "speed": 6.0, "release": false},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"A\"), _authoring_controller.brush.redraw(), _authoring_controller.brush.mode.lay_light()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "A  day"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_A", "desc": "{value}: variant A mid-drag, meadow into forest past the pine: river-alpha persimmon wash, bold persimmon edge on an ember glow, amber chevrons on ink"},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"B\"), _authoring_controller.brush.redraw()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "B  day"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_B", "desc": "{value}: variant B, the same drag: solid persimmon chevron bands, the ground clear between"},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"C\"), _authoring_controller.brush.redraw()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "C  day"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_C", "desc": "{value}: variant C, the same drag: an edge-weighted glowing tube, clear along the centre"},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"D\"), _authoring_controller.brush.redraw()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "D  day"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_D", "desc": "{value}: variant D (F5c), the same drag: glow fill at high coverage"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
   {"op": "input", "events": [{"type": "release", "at": [-16, -14]}]},
   {"op": "wait_ready", "settle": 1.0},
   {"op": "wait", "s": 2.0},

   {"op": "look_at", "at": [1.5, 4.5]},
   {"op": "zoom", "size": 8.0},
   {"op": "wait", "s": 2.0},
   {"op": "look_at", "at": [1.5, 4.5]},
   {"op": "wait", "s": 0.5},
   {"op": "gesture", "points": [[4.5, 6.2], [2, 5], [0, 3.4]], "speed": 3.0, "ctrl": true, "release": false},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_erase_drag", "desc": "{value}: mid-drag of a Ctrl line over the blaze at zoom 8: the lake interior, the salmon edge at the lay's weight with its salmon glow, round ends, chip Put out fire N ft"},
   {"op": "input", "events": [{"type": "release", "at": [0, 3.4], "ctrl": true}, {"type": "key", "key": "ctrl", "pressed": false}]},
   {"op": "wait_ready", "settle": 1.0},

   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "night_home", "label": ""},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
   {"op": "look_at", "at": [14, -12]},
   {"op": "zoom", "size": 22.0},
   {"op": "wait", "s": 2.0},
   {"op": "look_at", "at": [14, -12]},
   {"op": "wait", "s": 0.5},
   {"op": "gesture", "points": [[30, -6], [24, -10], [18, -12], [12, -14], [6, -16], [0, -19]], "speed": 6.0, "release": false},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"A\"), _authoring_controller.brush.redraw(), _authoring_controller.brush.mode.lay_light()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "A  night"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_night_A", "desc": "{value}: variant A at night, the laid line burning to the left"},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"B\"), _authoring_controller.brush.redraw()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "B  night"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_night_B", "desc": "{value}: variant B at night"},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"C\"), _authoring_controller.brush.redraw()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "C  night"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_night_C", "desc": "{value}: variant C at night"},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"D\"), _authoring_controller.brush.redraw()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "D  night"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_night_D", "desc": "{value}: variant D (F5c) at night"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
   {"op": "input", "events": [{"type": "key", "key": "escape"}, {"type": "key", "key": "escape", "pressed": false}, {"type": "release", "at": [0, -19]}]},
   {"op": "wait", "s": 0.5},

   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "sunset_home", "label": ""},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
   {"op": "look_at", "at": [14, -12]},
   {"op": "zoom", "size": 22.0},
   {"op": "wait", "s": 2.0},
   {"op": "look_at", "at": [14, -12]},
   {"op": "wait", "s": 0.5},
   {"op": "gesture", "points": [[30, -6], [24, -10], [18, -12], [12, -14], [6, -16], [0, -19]], "speed": 6.0, "release": false},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"A\"), _authoring_controller.brush.redraw(), _authoring_controller.brush.mode.lay_light()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "A  dusk"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_dusk_A", "desc": "{value}: variant A under outdoor_sunset at dusk"},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"B\"), _authoring_controller.brush.redraw()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "B  dusk"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_dusk_B", "desc": "{value}: variant B at dusk"},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"C\"), _authoring_controller.brush.redraw()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "C  dusk"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_dusk_C", "desc": "{value}: variant C at dusk"},
   {"op": "eval", "expr": "[_authoring_controller.brush.mode.set(\"lay_variant\", \"D\"), _authoring_controller.brush.redraw()]"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "D  dusk"},
   {"op": "wait", "s": 0.3},
   {"op": "capture", "name": "{value}_line_drag_dusk_D", "desc": "{value}: variant D (F5c) at dusk"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
   {"op": "input", "events": [{"type": "key", "key": "escape"}, {"type": "key", "key": "escape", "pressed": false}, {"type": "release", "at": [0, -19]}]},
   {"op": "wait", "s": 0.5},
   {"op": "title"},
   {"op": "wait", "s": 1.0}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/events_pane.gd", "action": "window", "size": "1920x1080"},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/firefeat_variants", "out": "sheet_variants_720", "columns": 4, "names": ["1280x720_line_drag_A", "1280x720_line_drag_B", "1280x720_line_drag_C", "1280x720_line_drag_D", "1280x720_line_drag_night_A", "1280x720_line_drag_night_B", "1280x720_line_drag_night_C", "1280x720_line_drag_night_D", "1280x720_line_drag_dusk_A", "1280x720_line_drag_dusk_B", "1280x720_line_drag_dusk_C", "1280x720_line_drag_dusk_D"], "tile": [640, 360]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/firefeat_variants", "out": "sheet_variants_1080", "columns": 2, "names": ["1920x1080_line_drag_A", "1920x1080_line_drag_B", "1920x1080_line_drag_C", "1920x1080_line_drag_D"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/firefeat_variants", "out": "sheet_variants_pine", "columns": 4, "names": ["1920x1080_line_drag_A", "1920x1080_line_drag_B", "1920x1080_line_drag_C", "1920x1080_line_drag_D"], "crop": [0.2, 0.1, 0.5, 0.6], "tile": [640, 576]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/firefeat_variants", "out": "sheet_erase", "columns": 2, "names": ["1920x1080_erase_drag", "1280x720_erase_drag"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/firefeat_variants", "out": "sheet_water", "columns": 2, "names": ["user://render_jobs/firefeat_line/water_before/water_pane", "water_after/water_pane", "user://render_jobs/firefeat_line/water_before/river_drag", "water_after/river_drag"], "tile": [960, 540]},
  {"op": "wait", "s": 1.0}
 ]
}
