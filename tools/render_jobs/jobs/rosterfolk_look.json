{
 "out_dir": "render_jobs/rosterfolk_look",
 "timeout_s": 600,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-16, -16], "to": [-16, 16], "preset": 3, "seed": 21},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 0.9},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar_token.gd", "action": "save", "folder": "_avatartoken_rosterfolk", "replace": true},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "play", "folder": "_avatartoken_rosterfolk"},
  {"op": "wait", "s": 3.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/rosterfolk.gd", "action": "row", "at": [-5.0, -2.0], "spacing": 1.8, "per_row": 8, "row_gap": 2.4},
  {"op": "wait", "s": 3.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/rosterfolk.gd", "action": "report"},
  {"op": "home"},
  {"op": "look_at", "at": [-1.0, -0.8]},
  {"op": "settle"},
  {"op": "capture", "name": "home", "desc": "Home zoom: the 16 Folk tokens in two rows on the meadow, the hamlet street to the left"},
  {"op": "zoom", "size": 5.0},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "look", "at": [3.1, -2.0], "height": 0.8},
  {"op": "settle"},
  {"op": "capture", "name": "close_men", "desc": "Close zoom (5 m view height): the woodsman and the scout of the front row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "look", "at": [3.1, 0.4], "height": 0.8},
  {"op": "settle"},
  {"op": "capture", "name": "close_women", "desc": "Close zoom: the first women of the back row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar_token.gd", "action": "cleanup"},
  {"op": "title"},
  {"op": "index", "title": "rosterfolk_look", "intro": "Folk token pack look"}
 ]
}
