{
  "out_dir": "render_jobs/structures_many_perf",
  "timeout_s": 420,
  "hang_s": 120,
  "remove_override": true,
  "steps": [
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 300, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
    {"op": "look_at", "at": [0, 0]},
    {"op": "zoom", "size": 60.0},
    {"op": "vsync_off"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "idle"},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "base"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "base_a"},
    {"op": "wait", "s": 8.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "many", "count": 32},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "thirty_two"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "thirty_two_a"},
    {"op": "wait", "s": 8.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "many", "count": 44},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "forty_four"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "forty_four_a"},
    {"op": "wait", "s": 8.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "base_b"},
    {"op": "wait", "s": 8.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "title"}
  ]
}
