{
 "out_dir": "render_jobs/p6_perf",
 "timeout_s": 1200,
 "hang_s": 90,
 "remove_override": true,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "play start"},

  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "play", "folder": "_p6_perf_exits"},
  {"op": "wait", "s": 2.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "title"},
  {"op": "wait", "s": 1.5},
  {"op": "expand", "values": ["_p6_perf_short", "_p6_perf_exits", "_p6_perf_short", "_p6_perf_exits", "_p6_perf_short", "_p6_perf_exits"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "play", "folder": "{value}"},
   {"op": "wait", "s": 2.0},
   {"op": "wait_ready", "settle": 2.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "mem", "name": "{value} play", "ws": true},
   {"op": "title"},
   {"op": "wait", "s": 1.5}
  ]},

  {"op": "play", "folder": "_p6_perf_short"},
  {"op": "wait", "s": 2.0},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "exits_build", "runs": 3},
  {"op": "title"},
  {"op": "wait", "s": 1.5},

  {"op": "play", "folder": "_p6_perf_exits"},
  {"op": "wait", "s": 2.0},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "exits_build", "runs": 3},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "info"},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "backdrop_bench", "runs": 5000},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "vsync_off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "transparent", "zip": "user://p6_old_skirt.zip"},
  {"op": "wait", "s": 3.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "opaque"},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "before frames"},

  {"op": "home"},
  {"op": "wait", "s": 2.0},
  {"op": "capture", "name": "play_home", "scale": 0.5, "desc": "_p6_perf_exits in play at home"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "home"},
  {"op": "expand", "values": ["1", "2"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "opaque"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "home opaque #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
   {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "transparent", "zip": "user://p6_old_skirt.zip"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "home transparent #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "opaque"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "skirt", "visible": false},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "home skirt hidden"},
  {"op": "wait", "s": 5.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "skirt", "visible": true},

  {"op": "zoom", "size": 20.0},
  {"op": "wait", "s": 2.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "look", "exit": 0, "out": 6.0},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "play_z20_exit", "scale": 0.5, "desc": "Zoom 20 panned to exit 0 (the waist river past the near edge)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "z20 exit"},
  {"op": "expand", "values": ["1", "2"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "opaque"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "z20 exit opaque #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
   {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "transparent", "zip": "user://p6_old_skirt.zip"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "z20 exit transparent #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "opaque"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "skirt", "visible": false},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "z20 exit skirt hidden"},
  {"op": "wait", "s": 5.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "skirt", "visible": true},
  {"op": "expand", "values": ["1", "2"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "show", "part": "ribbon", "visible": true},
   {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "show", "part": "channel", "visible": true},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "z20 exit, patch and ribbon shown #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
   {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "show", "part": "ribbon", "visible": false},
   {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "show", "part": "channel", "visible": false},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "z20 exit, patch and ribbon hidden #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "show", "part": "ribbon", "visible": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "show", "part": "channel", "visible": true},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "z20 exit, ribbon alone hidden"},
  {"op": "wait", "s": 5.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "show", "part": "ribbon", "visible": true},
  {"op": "expand", "values": ["1", "2"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "backdrop", "on": true},
   {"op": "wait", "s": 1.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "z20 exit, backdrop sync on #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
   {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "backdrop", "on": false},
   {"op": "wait", "s": 1.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "z20 exit, backdrop sync off #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "backdrop", "on": true},

  {"op": "look_at", "at": [-28.9, 0]},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "play_z20_edge", "scale": 0.5, "desc": "Zoom 20 panned to the left edge (no exit)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "z20 edge"},
  {"op": "expand", "values": ["1", "2"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "opaque"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "z20 edge opaque #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
   {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "transparent", "zip": "user://p6_old_skirt.zip"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "z20 edge transparent #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "opaque"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "skirt", "visible": false},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "z20 edge skirt hidden"},
  {"op": "wait", "s": 5.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "skirt", "visible": true},
  {"op": "title"},
  {"op": "wait", "s": 1.5},

  {"op": "dress", "folder": "_p6_perf_exits"},
  {"op": "wait_ready", "settle": 1.5},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "vsync_off"},
  {"op": "home"},
  {"op": "zoom"},
  {"op": "wait", "s": 3.0},
  {"op": "capture", "name": "author_zoomout", "scale": 0.5, "desc": "_p6_perf_exits in authoring at full zoom-out"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "authoring zoom-out"},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "transparent", "zip": "user://p6_old_skirt.zip"},
  {"op": "wait", "s": 3.0},
  {"op": "expand", "values": ["1", "2"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "opaque"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "zoom-out opaque #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
   {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "transparent", "zip": "user://p6_old_skirt.zip"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "zoom-out transparent #{value}"},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/p6_perf.gd", "action": "shader", "mode": "opaque"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "skirt", "visible": false},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "zoom-out skirt hidden"},
  {"op": "wait", "s": 5.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "skirt", "visible": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "play end"},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
