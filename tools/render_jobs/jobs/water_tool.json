{
  "out_dir": "render_jobs/p44_water_tool",
  "timeout_s": 1800,
  "hang_s": 90,
  "steps": [
    {"op": "expand_biomes", "biomes": ["temperate_forest_summer_s1", "grassland_meadow_summer_s1", "rocky_badlands_summer_s1"], "template": [
      {"op": "new_map", "biome": "{biome}", "size": 150, "seed": 1234},
      {"op": "wait_ready", "settle": 1.0},
      {"op": "no_autosave"},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "tilt", "slope": 0.02},
      {"op": "wait_ready", "settle": 1.0},
      {"op": "home"},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_a_before", "desc": "{name}: a new 150 ft map, tilted 2 % west to east"},
      {"op": "zoom", "size": 18.0},
      {"op": "wait", "s": 1.5},
      {"op": "look_at", "at": [0, 1]},
      {"op": "wait", "s": 0.5},
      {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.8, "speed": 5.0, "curve": true, "points": [[-19, 5], [-15, 9], [-10, 7], [-6, 2], [-1, -1], [4, 1], [9, 5], [14, 4], [21, -3]], "release": false},
      {"op": "capture", "name": "{biome}_b_drawing", "desc": "{name}, zoom 18: drawing a waist-deep river (still pressed): the ribbon at its width, chevrons downstream, the readout"},
      {"op": "record", "on": true, "name": "{biome}_river_release"},
      {"op": "release"},
      {"op": "wait_ready", "settle": 0.5},
      {"op": "record", "on": false},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "check"},
      {"op": "capture", "name": "{biome}_c_river", "desc": "{name}, zoom 18: the river carved on release"},
      {"op": "stroke", "mode": "water", "shape": "river", "depth": "ankle", "radius": 1.0, "speed": 4.0, "points": [[-8, -18], [-6, -14], [-2, -12], [-2, -8]], "release": false},
      {"op": "cancel"},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "check"},
      {"op": "record", "on": true, "name": "{biome}_stream"},
      {"op": "stroke", "mode": "water", "shape": "river", "depth": "ankle", "radius": 0.55, "speed": 4.0, "curve": true, "points": [[-4, -20], [-6, -15], [-3, -10], [-1, -5], [0, -1.5]]},
      {"op": "wait_ready", "settle": 0.5},
      {"op": "record", "on": false},
      {"op": "record", "on": true, "name": "{biome}_ponds"},
      {"op": "stroke", "mode": "water", "shape": "pond", "depth": "deep", "radius": 3.2, "speed": 3.0, "points": [[-13, -11], [-11.5, -10.5]], "hold": 1.0},
      {"op": "wait_ready", "settle": 0.3},
      {"op": "stroke", "mode": "water", "shape": "pond", "depth": "waist", "radius": 2.6, "speed": 3.0, "points": [[9, -12], [12, -13]], "hold": 0.4},
      {"op": "wait_ready", "settle": 0.3},
      {"op": "stroke", "mode": "water", "shape": "pond", "depth": "waist", "radius": 2.6, "speed": 3.0, "points": [[11.5, -12.5], [14, -10], [16, -7.5]]},
      {"op": "wait_ready", "settle": 1.0},
      {"op": "record", "on": false},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "check"},
      {"op": "hide_ui"},
      {"op": "home"},
      {"op": "wait", "s": 1.5},
      {"op": "capture", "name": "{biome}_d_home", "desc": "{name}, home view: a waist-deep river, an ankle stream joining it, a deep pool, a pond painted in two strokes"},
      {"op": "zoom", "size": 9.0},
      {"op": "wait", "s": 1.5},
      {"op": "look_at", "at": [-0.5, -3]},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_e_confluence", "desc": "{name}, zoom 9: the ankle stream joins the river (confluence)"},
      {"op": "look_at", "at": [-18, 6]},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_f_head", "desc": "{name}, zoom 9: the river's upstream end, a rounded head"},
      {"op": "look_at", "at": [-12, -10.5]},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_g_pool", "desc": "{name}, zoom 9: the deep pool"},
      {"op": "look_at", "at": [12.5, -10.5]},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_h_pond", "desc": "{name}, zoom 9: the pond painted in two strokes (the second from inside it)"},
      {"op": "zoom", "size": 14.0},
      {"op": "wait", "s": 1.5},
      {"op": "look_at", "at": [-2, -2]},
      {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
      {"op": "wait", "s": 1.5},
      {"op": "capture", "name": "{biome}_i_grid", "desc": "{name}, zoom 14, grid on: squares on the water surface"},
      {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
      {"op": "zoom", "size": 12.0},
      {"op": "wait", "s": 1.5},
      {"op": "look_at", "at": [9, 3]},
      {"op": "hide_ui", "hide": false},
      {"op": "wait", "s": 1.0},
      {"op": "stroke", "mode": "water", "ctrl": true, "radius": 0.8, "speed": 2.0, "points": [[8.5, 4.5], [9.5, 5.2]], "release": false},
      {"op": "capture", "name": "{biome}_j_erasing", "desc": "{name}, zoom 12: Ctrl held: the reach the eraser touches shows red"},
      {"op": "record", "on": true, "name": "{biome}_erase"},
      {"op": "release"},
      {"op": "wait_ready", "settle": 0.5},
      {"op": "record", "on": false},
      {"op": "capture", "name": "{biome}_k_erased", "desc": "{name}, zoom 12: that reach erased whole; its channel stays carved"},
      {"op": "eval", "expr": "_authoring_controller.undo()"},
      {"op": "wait_ready", "settle": 1.0},
      {"op": "capture", "name": "{biome}_l_undone", "desc": "{name}, zoom 12: the erase undone"},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "check"},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p44_{biome}"},
      {"op": "title"},
      {"op": "wait", "s": 1.0},
      {"op": "play", "folder": "_p44_{biome}"},
      {"op": "wait", "s": 8.0},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "tokens", "points": [[-6.5, 2.5], [-1.5, -0.8], [-12.5, -10.8], [-11, -10.2], [-3, -10]]},
      {"op": "wait", "s": 3.0},
      {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "report"},
      {"op": "zoom", "size": 10.0},
      {"op": "wait", "s": 2.0},
      {"op": "look_at", "at": [-4, 0]},
      {"op": "wait", "s": 1.5},
      {"op": "capture", "name": "{biome}_m_wading", "desc": "{name}, play, zoom 10: tokens wading the waist-deep river"},
      {"op": "look_at", "at": [-11.5, -10]},
      {"op": "wait", "s": 1.5},
      {"op": "capture", "name": "{biome}_n_floating", "desc": "{name}, play, zoom 10: tokens floating in the deep pool"},
      {"op": "title"},
      {"op": "wait", "s": 1.0}
    ]},
    {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "cleanup"},
    {"op": "index", "title": "The Water tool (P4-4)", "intro": "Per biome, a new 150 ft map tilted 2 %, built with the real Water tool at human speed: a winding waist-deep river drawn west to east (captured while drawing), a cancelled stroke, an ankle stream joining it, a deep pool, a pond painted in two strokes; home view, close-ups (confluence, the river's head, the pool, the pond), the grid, an erase of one reach with Ctrl (the preview, the result, its undo), then the level saved as a _p44_ test level and played with tokens wading and floating. The test levels are deleted at the end."}
  ]
}
