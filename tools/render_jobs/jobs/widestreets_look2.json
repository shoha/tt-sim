{
 "out_dir": "render_jobs/widestreets_look2",
 "timeout_s": 900,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_widestreets_look2", "load": "play"},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 320, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-40, 28], "to": [10, 28], "preset": 11, "seed": 14, "setback": "tool", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-2, -32], "to": [32, 2], "preset": 11, "seed": 21, "setback": "tool", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "modern_town", "wealth": 0.7, "density": 1.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "modern_town", "wealth": 0.8, "density": 1.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_widestreets_look2", "replace": true, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "corridor", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/paint_check.gd", "points": [[-15, 28], [-15, 31], [-15, 34.5], [-15, 21.5], [15, -15], [16.8, -16.8], [19.6, -19.6], [10.4, -10.4]], "phase": "build"},
  {"op": "play", "folder": "_widestreets_look2", "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [-15, 28], "preset": 0, "yaw": 90},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [-13.5, 30.6], "preset": 1, "yaw": 90},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [-15, 34.5], "preset": 2, "yaw": 0},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [-13, 21.5], "preset": 3, "yaw": 180},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [15, -15], "preset": 0, "yaw": 45},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [16.8, -16.8], "preset": 1, "yaw": 225},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [19.6, -19.6], "preset": 2, "yaw": 0},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "spawn", "at": [10.4, -10.4], "preset": 3, "yaw": 90},
  {"op": "hide_ui"},
  {"op": "look_at", "at": [-4, 0]},
  {"op": "zoom", "size": 70.0},
  {"op": "settle"},
  {"op": "capture", "name": "a_village", "desc": "the Modern town: one street along x at z 28 (x -40..10, built on both sides) and one along the view diagonal (-2,-32) to (32,2), Street tool setback 8.4: road 8.6 m between 4.1 m pavements; tokens on each road and pavement"},
  {"op": "zoom", "size": 30.0},
  {"op": "look_at", "at": [-15, 28]},
  {"op": "settle"},
  {"op": "capture", "name": "b_xstreet_home", "desc": "the x street at home zoom (size 30): its near (+z) row stands between the camera and the road; tokens on the centre line (-15,28), the near lane (-13.5,30.6), the near pavement (-15,34.5) and the far pavement (-13,21.5): does the occlusion fade show them"},
  {"op": "look_at", "at": [15, -15]},
  {"op": "settle"},
  {"op": "capture", "name": "c_diag_home", "desc": "the diagonal street at home zoom (size 30), running toward and away from the camera; tokens on the centre line (15,-15), a lane (16.8,-16.8) and both pavements"},
  {"op": "zoom", "size": 12.0},
  {"op": "look_at", "at": [-14, 28]},
  {"op": "settle"},
  {"op": "capture", "name": "d_xstreet_close", "desc": "close (size 12): the x street's cross-section at x -14, tokens on the road and both pavements"},
  {"op": "look_at", "at": [15, -15]},
  {"op": "settle"},
  {"op": "capture", "name": "e_diag_close", "desc": "close (size 12): the diagonal street at its middle, tokens on the road and both pavements"},
  {"op": "zoom", "size": 20.0},
  {"op": "look_at", "at": [-38, 28]},
  {"op": "settle"},
  {"op": "capture", "name": "f_street_end", "desc": "the west end of the x street: corner lots (corner crown), the road's end"},
  {"op": "index", "title": "widestreets look 2", "intro": "Wide Modern streets after the save fix (render jobs saved the map before a Dress's scatter regeneration landed): an x street and a view-diagonal street, tokens on roads and pavements"}
 ]
}
