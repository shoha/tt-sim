{
 "out_dir": "render_jobs/procgen_bridge_look",
 "timeout_s": 900,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "cleanup"},
  {"op": "call", "script": "res://tools/render_jobs/probes/procgen_switch.gd", "enabled": false},

  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 20.0},
  {"op": "wait", "s": 1.5},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.8, "speed": 4.0, "curve": true, "points": [[-21, 5], [-14, 6], [-7, 4], [0, 1], [7, 0], [14, 1], [21, -2]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "plank", "from": [-7, 2.5], "to": [-7, 5.5]},
  {"op": "call", "script": "res://tools/render_jobs/probes/procgen_switch.gd", "enabled": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "plank", "from": [7, -1.5], "to": [7, 1.5]},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "report"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "home"},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "home", "desc": "Home zoom: the code-built plank bridge (left, c1) and the procgen one (right, c2) over the same river"},
  {"op": "zoom", "size": 8.0},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "look", "at": "found:c1_mid"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "code_z8", "desc": "Zoom 8: the code-built bridge (c1)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "look", "at": "found:c2_mid"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "procgen_z8", "desc": "Zoom 8: the procgen bridge (c2)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "procgen_z8_grid", "desc": "Zoom 8, grid on: the grid runs across the procgen deck"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
  {"op": "zoom", "size": 3.0},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "look", "at": "found:c2_a"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "procgen_end_z3", "desc": "Zoom 3: the procgen bridge's end, sill and posts at the bank"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "save", "folder": "_p4b1_procgen"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "play", "folder": "_p4b1_procgen"},
  {"op": "wait", "s": 3.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "report"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "tokens", "points": ["found:c1_mid", "found:c1_b", "found:c2_mid", "found:c2_a"]},
  {"op": "wait", "s": 3.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "points", "points": ["found:c1_mid", "found:c2_mid", "found:c2_a"]},
  {"op": "zoom", "size": 10.0},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "look", "at": "found:c2_mid"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "play_procgen_tokens", "desc": "In play, zoom 10: tokens on the procgen deck and at its end"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "cleanup"},
  {"op": "call", "script": "res://tools/render_jobs/probes/procgen_switch.gd", "enabled": false}
 ]
}
