{
 "out_dir": "render_jobs/looks2_hero",
 "timeout_s": 300,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 250, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-36, 0], "to": [36, 0], "preset": 3, "seed": 31, "side": 1},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "market_town", "wealth": 0.7, "density": 1.0},
  {"op": "settle"},
  {"op": "hide_ui"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 60.0},
  {"op": "settle"},
  {"op": "capture", "name": "hero_street_home", "desc": "market town street running across the view, home zoom"},
  {"op": "look_at", "at": [-18, 0]},
  {"op": "zoom", "size": 22.0},
  {"op": "settle"},
  {"op": "capture", "name": "hero_street_west", "desc": "west half, closer"},
  {"op": "look_at", "at": [18, 0]},
  {"op": "settle"},
  {"op": "capture", "name": "hero_street_east", "desc": "east half, closer"}
 ]
}
