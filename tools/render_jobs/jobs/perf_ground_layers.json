{
  "out_dir": "render_jobs/perf_ground_layers",
  "timeout_s": 900,
  "remove_override": true,
  "steps": [
    {"op": "new_map", "biome": "", "size": 200, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "home"},
    {"op": "vsync_off"},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "shader", "version": "old"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "shader", "version": "new"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "bare"},
    {"op": "capture", "name": "01_flat", "desc": "Bare 200 ft grass map, home (0 layers on screen)"},
    {"op": "expand_ab", "configs": ["std", "old", "new", "std", "old", "new"], "label": "flat", "s": 4.0},

    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "layers", "mode": "4"},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "02_layers4", "desc": "Four biome grounds in quadrants (4 layers on screen)"},
    {"op": "expand_ab", "configs": ["std", "new", "std", "new"], "label": "4 layers", "s": 4.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "paint", "mode": "strips8"},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "03_strips8", "desc": "Eight painted surfaces in 3 m strips (8 layers on screen)"},
    {"op": "expand_ab", "configs": ["std", "new", "std", "new"], "label": "8 strips", "s": 4.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "paint", "mode": "mix8"},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "04_mix8", "desc": "Eight painted surfaces in a 1 m checker at half weight over the four biome grounds (worst case)"},
    {"op": "expand_ab", "configs": ["std", "new", "std", "new"], "label": "8 mix", "s": 4.0},

    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "", "size": 200, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "terraces", "rings": 6},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "home"},
    {"op": "vsync_off"},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_perf.gd", "action": "fraction"},
    {"op": "capture", "name": "05_terraces", "desc": "Six concentric 1.524 m tiers filling the view: cliff faces through the side projections"},
    {"op": "expand_ab", "configs": ["std", "old", "new", "std", "old", "new"], "label": "terraces", "s": 4.0},
    {"op": "index", "title": "Ground shader cost with the P3-4 layer table", "intro": "Pinned viewport, vsync off, in-run interleaved; std = StandardMaterial3D with the base surface's textures, old = the ground shader before P3-4 (base only), new = the current shader; see log.txt"},
    {"op": "title"}
  ]
}
