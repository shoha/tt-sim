{
 "out_dir": "render_jobs/fire_field_look",
 "timeout_s": 300,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "dress", "folder": "_firefeat_look"},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info"},
  {"op": "expand", "values": ["day_home", "day_z8", "day_z20", "dusk_home", "dusk_z8", "dusk_z20", "dusk_z30", "day_z30"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "NEW  flames + ember glow", "phase": "look", "for": "{value}_new"},
   {"op": "wait", "s": 2.0, "phase": "look", "for": "{value}_new"},
   {"op": "capture", "name": "{value}_new", "desc": "{value}: the field's look"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
  {"op": "expand", "values": ["day_home", "day_z8", "day_z20", "dusk_home", "dusk_z8", "dusk_z20"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_field_look", "out": "sheet_{value}", "columns": 2, "names": ["user://render_jobs/firefeat_look/{value}_A", "{value}_new"], "tile": [960, 540]}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_field_look", "out": "sheet_z30", "columns": 2, "names": ["day_z30_new", "dusk_z30_new"], "tile": [960, 540]},
  {"op": "index", "title": "Fire field look (card F4a)", "intro": "Produced by tools/render_jobs/jobs/firefeat_look.json on the saved _firefeat_look level (firefeat_build: a 200 ft temperate forest, seed 1234, fire laid with the real Fire tool over about a third of the map, a blaze line across it). Sheets sheet_<day|dusk>_<view>.png: column A is the F3 probe's frame of F1's placeholder (render_jobs/firefeat_look/<view>_A.png, same views and sun), column NEW this build. sheet_z30: past the LOD zoom, day and dusk."},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
