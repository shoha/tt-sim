{
 "out_dir": "render_jobs/fire_lights_smoke",
 "timeout_s": 480,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "dress", "folder": "_firefeat_look"},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info"},
  {"op": "wait", "s": 6.0},
  {"op": "expand", "values": ["dusk_home", "dusk_z8", "dusk_z20", "dusk_zs", "night_home", "day_home", "day_zs"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "ROUND 4", "phase": "look", "for": "{value}_r4"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": false, "phase": "look", "for": "{value}_r4"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_r4"},
   {"op": "capture", "name": "{value}_r4", "desc": "{value}: round 4's field, the lights and smoke hidden"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": "user://render_jobs/fire_lights_smoke_round1/{value}_ls.png", "text": "ROUND 1  lights and smoke", "phase": "look", "for": "{value}_r1"},
   {"op": "wait", "s": 0.3, "phase": "look", "for": "{value}_r1"},
   {"op": "capture", "name": "{value}_r1", "desc": "{value}: round 1 of this card (its kept capture, replayed)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": "", "phase": "look", "for": "{value}_r1"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "NEW  lights and smoke", "phase": "look", "for": "{value}_ls"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "{value}_ls"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_ls"},
   {"op": "capture", "name": "{value}_ls", "desc": "{value}: the field with its lights and smoke (card F4b-1 round 2)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info", "phase": "look", "for": "{value}_ls"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "dusk_zs", "label": "NEW  smoke motion", "phase": "look", "for": "smoke_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "smoke_*"},
  {"op": "wait", "s": 2.5, "phase": "look", "for": "smoke_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "burst", "dir": "user://render_jobs/fire_lights_smoke", "name": "smoke", "count": 8, "every": 1.6, "phase": "look", "for": "smoke_*"},
  {"op": "wait", "s": 14.0, "phase": "look", "for": "smoke_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "dark_home", "label": "PROBE DARK  lights off", "phase": "look", "for": "dark_home_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "dark_home_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": false, "phase": "look", "for": "dark_home_off"},
  {"op": "wait", "s": 4.0, "phase": "look", "for": "dark_home_off"},
  {"op": "capture", "name": "dark_home_off", "desc": "the harness's dark night (ambient and sky energy cut), the fire's lights off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": true, "phase": "look", "for": "dark_home_on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "PROBE DARK  lights on", "phase": "look", "for": "dark_home_on"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "dark_home_on"},
  {"op": "capture", "name": "dark_home_on", "desc": "the harness's dark night (ambient and sky energy cut), the fire's lights on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "dark_home", "label": "PROBE DARK  flames hidden, lights off", "phase": "look", "for": "dark_t*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "flames", "show": false, "phase": "look", "for": "dark_t*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": false, "phase": "look", "for": "dark_t*"},
  {"op": "wait", "s": 2.0, "phase": "look", "for": "dark_t0"},
  {"op": "capture", "name": "dark_t0", "desc": "dark night, flames and smoke hidden, lights off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": true, "phase": "look", "for": "dark_t*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "lights", "energy": 8.0, "range": 7.0, "rise": 1.6, "decay": 1.0, "phase": "look", "for": "dark_t1"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "DARK  round 1 lights: energy 8, range 7, rise 1.6, decay 1", "phase": "look", "for": "dark_t1"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "dark_t1"},
  {"op": "capture", "name": "dark_t1", "desc": "dark night, flames hidden, round 1's lights"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "lights", "energy": 8.0, "range": 12.0, "rise": 2.24, "decay": 0.5, "phase": "look", "for": "dark_t2"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "DARK  round 2 lights: energy 8, range 12, rise 2.2, decay 0.5", "phase": "look", "for": "dark_t2"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "dark_t2"},
  {"op": "capture", "name": "dark_t2", "desc": "dark night, flames hidden, round 2's lights (as shipped)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "lights", "energy": 12.0, "range": 14.0, "rise": 2.4, "decay": 0.4, "phase": "look", "for": "dark_t3"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "DARK  energy 12, range 14, rise 2.4, decay 0.4", "phase": "look", "for": "dark_t3"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "dark_t3"},
  {"op": "capture", "name": "dark_t3", "desc": "dark night, flames hidden, a low strong light"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "flames", "show": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "day_home"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
  {"op": "expand", "values": ["dusk_home", "dusk_z8", "dusk_z20", "dusk_zs", "night_home", "day_home", "day_zs"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_{value}", "columns": 3, "names": ["{value}_r4", "{value}_r1", "{value}_ls"], "tile": [960, 540]}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_motion", "columns": 4, "names": ["smoke_0", "smoke_1", "smoke_2", "smoke_3", "smoke_4", "smoke_5", "smoke_6", "smoke_7"], "tile": [480, 270]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_dark", "columns": 2, "names": ["dark_home_off", "dark_home_on"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_dark_tune", "columns": 2, "names": ["dark_t0", "dark_t1", "dark_t2", "dark_t3"], "tile": [960, 540]},
  {"op": "index", "title": "Fire lights and smoke (card F4b-1, round 2)", "intro": "Produced by tools/render_jobs/jobs/firefeat_look.json on the saved _firefeat_look level (firefeat_build: a 200 ft temperate forest, seed 1234, fire laid with the real Fire tool: three straight passes, a shorter fourth and a curved blaze line, plus an author-laid fire south of them). Sheets sheet_<day|dusk|night>_<view>.png: ROUND 4 (<key>_r4, the field with its lights and smoke hidden, the accepted round 4 look), ROUND 1 (<key>_r1, this card's first round, its kept capture in render_jobs/fire_lights_smoke_round1 replayed) and NEW (<key>_ls, with the lights and smoke). The lights show only while the sun is low (dusk 19:00, night 23:00; off at 14:00). The zs view is zoom 12 framing the largest smoke column. sheet_motion: eight frames grabbed by the probe's burst 1.6 s apart at dusk in that view (smoke_times.txt has their engine times). sheet_dark: the harness's dark night (the probe's dark key: a flat dim ambient, sky reflections off, the sky's energy a tenth and the sun off; the game's own night is unchanged) at home, the fire's lights off and on. sheet_dark_tune: that dark night at home with the flames and smoke hidden: the lights off, round 1's tuning, round 2's (as shipped) and a stronger one, set by the probe."},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
