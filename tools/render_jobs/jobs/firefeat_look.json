{
 "out_dir": "render_jobs/fire_field_look",
 "timeout_s": 420,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "dress", "folder": "_firefeat_look"},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info"},
  {"op": "expand", "values": ["day_home", "day_z8", "day_z20", "day_ahome", "day_az20", "day_z30", "dusk_z30", "dusk_home", "dusk_z20", "dusk_ahome", "dusk_az20", "dusk_z8"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "NEW  round 4", "phase": "look", "for": "{value}_r4"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_r4"},
   {"op": "capture", "name": "{value}_r4", "desc": "{value}: the field's look, round 4"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "NEW  motion   |   dusk, zoom 8", "phase": "look", "for": "motion4_*"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "motion4_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "burst", "dir": "user://render_jobs/fire_field_look", "name": "motion4", "count": 8, "every": 0.1, "phase": "look", "for": "motion4_*"},
  {"op": "wait", "s": 4.0, "phase": "look", "for": "motion4_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "param", "target": "flames", "name": "debug_view", "value": 2, "phase": "look", "for": "dusk_z8_cut4"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "hard depth cut   |   dusk, zoom 8", "phase": "look", "for": "dusk_z8_cut4"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "dusk_z8_cut4"},
  {"op": "capture", "name": "dusk_z8_cut4", "desc": "dusk zoom 8 with the flames cut hard at the scene's depth (as the depth test drew them; the seam probe)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "param", "target": "flames", "name": "debug_view", "value": 0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "scatter", "visible": false, "phase": "look", "for": "*_bare4"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "flames", "show": false, "phase": "look", "for": "*_bare4"},
  {"op": "expand", "values": ["dusk_z8", "dusk_ahome"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "ground alone (no scatter, no flames)", "phase": "look", "for": "{value}_bare4"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_bare4"},
   {"op": "capture", "name": "{value}_bare4", "desc": "{value}: the ground alone, scatter and flames hidden (the bed, and the source of the straight edges)"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "flames", "show": true, "phase": "look", "for": "*_bare4"},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "scatter", "visible": true, "phase": "look", "for": "*_bare4"},
  {"op": "expand", "values": ["day_home", "day_z8", "day_z20", "dusk_home", "dusk_z8", "dusk_z20", "dusk_z30", "day_z30", "day_ahome", "dusk_ahome", "day_az20", "dusk_az20"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": "user://render_jobs/fire_field_look/{value}_r3.png", "text": "ROUND 3   |   {value}", "phase": "look", "for": "{value}_r3l"},
   {"op": "wait", "s": 0.3, "phase": "look", "for": "{value}_r3l"},
   {"op": "capture", "name": "{value}_r3l", "desc": "{value}: round 3's frame, re-labelled"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": ""},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
  {"op": "expand", "values": ["day_home", "day_z8", "day_z20", "dusk_home", "dusk_z8", "dusk_z20"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_field_look", "out": "sheet_{value}", "columns": 3, "names": ["{value}_r2l", "{value}_r3l", "{value}_r4"], "tile": [960, 540]}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_field_look", "out": "sheet_z30", "columns": 3, "names": ["day_z30_r2l", "day_z30_r3l", "day_z30_r4", "dusk_z30_r2l", "dusk_z30_r3l", "dusk_z30_r4"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_field_look", "out": "sheet_author_day", "columns": 2, "names": ["day_ahome_r3l", "day_ahome_r4", "day_az20_r3l", "day_az20_r4"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_field_look", "out": "sheet_author_dusk", "columns": 2, "names": ["dusk_ahome_r3l", "dusk_ahome_r4", "dusk_az20_r3l", "dusk_az20_r4"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_field_look", "out": "sheet_seam", "columns": 2, "names": ["dusk_z8_r4", "dusk_z8_cut4"], "tile": [960, 540], "crop": [0.25, 0.25, 0.5, 0.5]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_field_look", "out": "sheet_bare", "columns": 2, "names": ["dusk_z8_r4", "dusk_z8_bare4", "dusk_ahome_r4", "dusk_ahome_bare4"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_field_look", "out": "sheet_motion", "columns": 4, "names": ["motion4_0", "motion4_1", "motion4_2", "motion4_3", "motion4_4", "motion4_5", "motion4_6", "motion4_7"], "tile": [480, 324], "crop": [0.3, 0.3, 0.4, 0.45]},
  {"op": "index", "title": "Fire field look (card F4a, round 4)", "intro": "Produced by tools/render_jobs/jobs/firefeat_look.json on the saved _firefeat_look level (firefeat_build: a 200 ft temperate forest, seed 1234, fire laid with the real Fire tool: three straight passes, a shorter fourth and a curved blaze line, plus an author-laid fire south of them, a blob and a curving line). Sheets sheet_<day|dusk>_<view>.png: ROUND 2 (<key>_r2l), ROUND 3 (<key>_r3, re-labelled as <key>_r3l), NEW (<key>_r4). sheet_z30: rounds 2, 3 and new past the LOD zoom, day over dusk. sheet_author_<day|dusk>: the author-laid fire at the home zoom over zoom 20, round 3 (framed further south) beside new. sheet_motion: eight frames grabbed by the probe's burst at dusk, zoom 8 (the middle of the frame); their engine times are in motion4_times.txt. sheet_seam: dusk zoom 8 (the middle) beside the same with the flames cut hard at the scene's depth, as the depth test drew them. sheet_bare: dusk zoom 8 and the author fire at home zoom, each beside the ground alone (scatter and flames hidden)."},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
