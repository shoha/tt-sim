{
 "out_dir": "render_jobs/fire_lights_smoke",
 "timeout_s": 480,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "dress", "folder": "_firefeat_look"},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info"},
  {"op": "wait", "s": 6.0},
  {"op": "expand", "values": ["sunset_zs", "night_zs", "day_zs", "sunset_home", "sunset_z20"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "A  one plume", "phase": "look", "for": "{value}_?"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "{value}_?"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "param", "target": "smoke", "name": "structure", "value": 0.0, "phase": "look", "for": "{value}_a"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_a"},
   {"op": "capture", "name": "{value}_a", "desc": "{value}: structure A, one plume a column (card F4b-1 round 4)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "param", "target": "smoke", "name": "structure", "value": 1.0, "phase": "look", "for": "{value}_b"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "B  merged billows", "phase": "look", "for": "{value}_b"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_b"},
   {"op": "capture", "name": "{value}_b", "desc": "{value}: structure B, merged billows (card F4b-1 round 4)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": "user://render_jobs/fire_lights_smoke_round3/{value}_ls.png", "text": "ROUND 3  its kept frame", "phase": "look", "for": "{value}_r3"},
   {"op": "wait", "s": 0.3, "phase": "look", "for": "{value}_r3"},
   {"op": "capture", "name": "{value}_r3", "desc": "{value}: round 3 of this card (its kept capture, replayed)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": "", "phase": "look", "for": "{value}_r3"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info", "phase": "look", "for": "{value}_b"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "sunset_zs", "label": "A  smoke motion", "phase": "look", "for": "smoke_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "smoke_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "param", "target": "smoke", "name": "structure", "value": 0.0, "phase": "look", "for": "smoke_a"},
  {"op": "wait", "s": 2.5, "phase": "look", "for": "smoke_a"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "burst", "dir": "user://render_jobs/fire_lights_smoke", "name": "smokeA", "count": 8, "every": 1.6, "phase": "look", "for": "smoke_a"},
  {"op": "wait", "s": 14.0, "phase": "look", "for": "smoke_a"},
  {"op": "capture", "name": "smoke_a", "desc": "the motion strip's last state, structure A"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "param", "target": "smoke", "name": "structure", "value": 1.0, "phase": "look", "for": "smoke_b"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "B  smoke motion   |   sunset, zoom 12 on the smoke", "phase": "look", "for": "smoke_b"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "smoke_b"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "burst", "dir": "user://render_jobs/fire_lights_smoke", "name": "smokeB", "count": 8, "every": 1.6, "phase": "look", "for": "smoke_b"},
  {"op": "wait", "s": 14.0, "phase": "look", "for": "smoke_b"},
  {"op": "capture", "name": "smoke_b", "desc": "the motion strip's last state, structure B"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "param", "target": "smoke", "name": "structure", "value": 0.0},
  {"op": "expand", "values": ["night_home", "night_zs", "sunset_home"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "ROUND 4", "phase": "look", "for": "{value}_r4"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": false, "phase": "look", "for": "{value}_r4"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_r4"},
   {"op": "capture", "name": "{value}_r4", "desc": "{value}: round 4's field, the lights and smoke hidden"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "NEW  lights and smoke", "phase": "look", "for": "{value}_ls"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "{value}_ls"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_ls"},
   {"op": "capture", "name": "{value}_ls", "desc": "{value}: the field with its lights and smoke (card F4b-1 round 4)"}
  ]},
  {"op": "expand", "values": ["home", "z8"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "night_{value}", "label": "PROBE  lights on, flames and smoke hidden", "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "smoke", "show": false, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "flames", "show": false, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": false, "phase": "look", "for": "lp_{value}"},
   {"op": "wait", "s": 4.0, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "grab", "tag": "off", "freeze": true, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": true, "phase": "look", "for": "lp_{value}"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "grab", "tag": "on", "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "diff", "a": "off", "b": "on", "out": "user://render_jobs/fire_lights_smoke/lp_{value}_diff", "gain": 4.0, "near": [-2.2, 0.7], "rings": [2.0, 4.0, 8.0, 11.0], "phase": "look", "for": "lp_{value}"},
   {"op": "capture", "name": "lp_{value}", "desc": "outdoor_night, the lights on (held at their energy), the flames and smoke hidden"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "grab", "tag": "on", "freeze": false, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "flames", "show": true, "phase": "look", "for": "lp_{value}"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "day_home"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
  {"op": "expand", "values": ["sunset_zs", "night_zs", "day_zs", "sunset_home", "sunset_z20"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_{value}", "columns": 3, "names": ["{value}_r3", "{value}_a", "{value}_b"], "tile": [960, 540]}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_motion_a", "columns": 4, "names": ["smokeA_0", "smokeA_1", "smokeA_2", "smokeA_3", "smokeA_4", "smokeA_5", "smokeA_6", "smokeA_7"], "tile": [720, 405]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_motion_b", "columns": 4, "names": ["smokeB_0", "smokeB_1", "smokeB_2", "smokeB_3", "smokeB_4", "smokeB_5", "smokeB_6", "smokeB_7"], "tile": [720, 405]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_lights", "columns": 2, "names": ["night_home_r4", "night_home_ls", "night_zs_r4", "night_zs_ls", "sunset_home_r4", "sunset_home_ls"], "tile": [960, 540]},
  {"op": "index", "title": "Fire lights and smoke (card F4b-1, round 4)", "intro": "Produced by tools/render_jobs/jobs/firefeat_look.json on the saved _firefeat_look level (firefeat_build: a 200 ft temperate forest, seed 1234, fire laid with the real Fire tool: three straight passes, a shorter fourth and a curved blaze line, plus an author-laid fire south of them). Sheets sheet_<sunset|night|day>_<view>.png compare the smoke's two structures: ROUND 3 (<key>_r3, this card's third round, its kept capture in render_jobs/fire_lights_smoke_round3 replayed), A (<key>_a, one plume a column) and B (<key>_b, merged billows), switched by the smoke shader's structure uniform. Sunset is the game's outdoor_sunset preset with the sun at 19:00, night the outdoor_night preset with the sun at 23:00, day the level's own sky at 14:00; the lights show only while the sun is low. The zs view is zoom 12 framing the largest smoke column. sheet_motion_a and sheet_motion_b: eight frames grabbed by the probe's burst 1.6 s apart at sunset in that view (smokeA_times.txt, smokeB_times.txt). sheet_lights: ROUND 4 (lights and smoke hidden) against NEW (both shown, structure A) at night home, night zs and sunset home. lp_home and lp_z8: outdoor_night with the flames and smoke hidden and the lights held at their energy; lp_<view>_diff.png is (lights on - lights off) x 4 and lp_<view>_diff.txt the colours at level ground 2, 4, 8 and 11 m from the home blaze's light with its attenuation there."},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
