{
 "out_dir": "render_jobs/fire_lights_smoke",
 "timeout_s": 480,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "dress", "folder": "_firefeat_look"},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info"},
  {"op": "wait", "s": 6.0},
  {"op": "expand", "values": ["sunset_zs", "night_zs", "day_zs", "sunset_home", "night_home", "sunset_z20"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "NEW", "phase": "look", "for": "{value}_*"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "{value}_*"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_new"},
   {"op": "capture", "name": "{value}_new", "desc": "{value}: the lights and smoke (card F4b-1 round 5)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "smoke", "show": false, "phase": "look", "for": "{value}_ns"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "NO SMOKE  the same view", "phase": "look", "for": "{value}_ns"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "{value}_ns"},
   {"op": "capture", "name": "{value}_ns", "desc": "{value}: the smoke hidden, for colour probes against what is behind it"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "{value}_ns"}
  ]},
  {"op": "expand", "values": ["sunset_zs", "night_zs", "day_zs", "sunset_home", "sunset_z20"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": "user://render_jobs/fire_lights_smoke_round4/{value}_a.png", "text": "ROUND 4  its kept frame", "phase": "look", "for": "{value}_old"},
   {"op": "wait", "s": 0.3, "phase": "look", "for": "{value}_old"},
   {"op": "capture", "name": "{value}_old", "desc": "{value}: round 4 of this card (its kept capture, replayed)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": "", "phase": "look", "for": "{value}_old"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": "user://render_jobs/fire_lights_smoke_round4/night_home_ls.png", "text": "ROUND 4  its kept frame", "phase": "look", "for": "night_home_old"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "night_home_old"},
  {"op": "capture", "name": "night_home_old", "desc": "night_home: round 4 of this card (its kept capture, replayed)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": "", "phase": "look", "for": "night_home_old"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "sunset_zs", "label": "NEW  smoke motion", "phase": "look", "for": "smoke_motion"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "smoke_motion"},
  {"op": "wait", "s": 2.5, "phase": "look", "for": "smoke_motion"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "burst", "dir": "user://render_jobs/fire_lights_smoke", "name": "smoke5", "count": 8, "every": 1.6, "phase": "look", "for": "smoke_motion"},
  {"op": "wait", "s": 14.0, "phase": "look", "for": "smoke_motion"},
  {"op": "capture", "name": "smoke_motion", "desc": "the motion strip's last state"},
  {"op": "expand", "values": ["night_home", "night_zs", "sunset_home"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "NO LIGHTS", "phase": "look", "for": "{value}_nl"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "{value}_nl"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": false, "phase": "look", "for": "{value}_nl"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_nl"},
   {"op": "capture", "name": "{value}_nl", "desc": "{value}: the smoke shown, the lights hidden"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": true, "phase": "look", "for": "{value}_nl"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "sunset_zs", "label": "PROBE  the smoke off and on over the flames", "phase": "look", "for": "fp_zs"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "fp_zs"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "smoke", "show": false, "phase": "look", "for": "fp_zs"},
  {"op": "wait", "s": 2.5, "phase": "look", "for": "fp_zs"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "grab", "tag": "smoke_off", "phase": "look", "for": "fp_zs"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "smoke", "show": true, "phase": "look", "for": "fp_zs"},
  {"op": "wait", "s": 0.1, "phase": "look", "for": "fp_zs"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "grab", "tag": "smoke_on", "phase": "look", "for": "fp_zs"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "diff", "a": "smoke_off", "b": "smoke_on", "out": "user://render_jobs/fire_lights_smoke/fp_zs_diff", "gain": 2.0, "near": [0.0, 0.0], "rings": [], "points": [["flame_a", 0.47, 0.78], ["flame_b", 0.52, 0.74], ["flame_c", 0.5, 0.85], ["flame_d", 0.44, 0.7]], "phase": "look", "for": "fp_zs"},
  {"op": "capture", "name": "fp_zs", "desc": "sunset zs, the smoke shown (the probe's diff holds the flames' colours with it off and on)"},
  {"op": "expand", "values": ["home", "z8"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "night_{value}", "label": "PROBE  lights on, flames and smoke hidden", "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "smoke", "show": false, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "flames", "show": false, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": false, "phase": "look", "for": "lp_{value}"},
   {"op": "wait", "s": 4.0, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "grab", "tag": "off", "freeze": true, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": true, "phase": "look", "for": "lp_{value}"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "grab", "tag": "on", "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "diff", "a": "off", "b": "on", "out": "user://render_jobs/fire_lights_smoke/lp_{value}_diff", "gain": 4.0, "near": [-2.2, 0.7], "rings": [2.0, 4.0, 8.0, 11.0, 13.0, 16.0], "phase": "look", "for": "lp_{value}"},
   {"op": "capture", "name": "lp_{value}", "desc": "outdoor_night, the lights on (held at their energy), the flames and smoke hidden"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "grab", "tag": "on", "freeze": false, "phase": "look", "for": "lp_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "flames", "show": true, "phase": "look", "for": "lp_{value}"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "day_home"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
  {"op": "expand", "values": ["sunset_zs", "night_zs", "day_zs", "sunset_home", "night_home", "sunset_z20"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_{value}", "columns": 2, "names": ["{value}_old", "{value}_new"], "tile": [960, 540]}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_motion", "columns": 4, "names": ["smoke5_0", "smoke5_1", "smoke5_2", "smoke5_3", "smoke5_4", "smoke5_5", "smoke5_6", "smoke5_7"], "tile": [720, 405]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_lights", "columns": 2, "names": ["night_home_nl", "night_home_new", "night_zs_nl", "night_zs_new", "sunset_home_nl", "sunset_home_new"], "tile": [960, 540]},
  {"op": "index", "title": "Fire lights and smoke (card F4b-1, round 5)", "intro": "Produced by tools/render_jobs/jobs/firefeat_look.json on the saved _firefeat_look level (firefeat_build: a 200 ft temperate forest, seed 1234, fire laid with the real Fire tool: three straight passes, a shorter fourth and a curved blaze line, plus an author-laid fire south of them). Sheets sheet_<sunset|night|day>_<view>.png put ROUND 4 (<key>_old, this card's fourth round, its kept capture in render_jobs/fire_lights_smoke_round4 replayed) beside NEW (<key>_new); <key>_ns is the same view with the smoke hidden, for colour probes of the smoke against what is behind it. Sunset is the game's outdoor_sunset preset with the sun at 19:00, night the outdoor_night preset with the sun at 23:00, day the level's own sky at 14:00; the lights show only while the sun is low. The zs view is zoom 12 framing the largest smoke column. sheet_motion: eight frames grabbed by the probe's burst 1.6 s apart at sunset in that view (smoke5_times.txt). sheet_lights: NO LIGHTS (<key>_nl, the lights hidden, the smoke shown) against NEW at night home, night zs and sunset home. fp_zs_diff.txt: the flames' colours at sunset zs with the smoke off and on. lp_home and lp_z8: outdoor_night with the flames and smoke hidden and the lights held at their energy; lp_<view>_diff.png is (lights on - lights off) x 4 and lp_<view>_diff.txt the colours at level ground 2, 4, 8, 11, 13 and 16 m from the home blaze's light with its attenuation there."},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
