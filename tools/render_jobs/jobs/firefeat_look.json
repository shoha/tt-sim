{
 "out_dir": "render_jobs/fire_lights_smoke",
 "timeout_s": 480,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "dress", "folder": "_firefeat_look"},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info"},
  {"op": "wait", "s": 6.0},
  {"op": "expand", "values": ["sunset_home", "sunset_z8", "sunset_z20", "sunset_zs", "night_home", "night_zs", "day_home", "day_zs"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "ROUND 4", "phase": "look", "for": "{value}_r4"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": false, "phase": "look", "for": "{value}_r4"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_r4"},
   {"op": "capture", "name": "{value}_r4", "desc": "{value}: round 4's field, the lights and smoke hidden"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": "user://render_jobs/fire_lights_smoke_round2/replay/{value}.png", "text": "ROUND 2  its kept frame (the level's own sky)", "phase": "look", "for": "{value}_r2"},
   {"op": "wait", "s": 0.3, "phase": "look", "for": "{value}_r2"},
   {"op": "capture", "name": "{value}_r2", "desc": "{value}: round 2 of this card (its kept capture, replayed; taken under the level's own sky, not the preset)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "replay", "path": "", "phase": "look", "for": "{value}_r2"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "{value}", "label": "NEW  lights and smoke", "phase": "look", "for": "{value}_ls"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "{value}_ls"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "{value}_ls"},
   {"op": "capture", "name": "{value}_ls", "desc": "{value}: the field with its lights and smoke (card F4b-1 round 3)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info", "phase": "look", "for": "{value}_ls"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "sunset_zs", "label": "NEW  smoke motion", "phase": "look", "for": "smoke_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "smoke_*"},
  {"op": "wait", "s": 2.5, "phase": "look", "for": "smoke_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "burst", "dir": "user://render_jobs/fire_lights_smoke", "name": "smoke", "count": 8, "every": 1.6, "phase": "look", "for": "smoke_*"},
  {"op": "wait", "s": 14.0, "phase": "look", "for": "smoke_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "dark_home", "label": "PROBE DARK  lights off", "phase": "look", "for": "dark_home_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "dark_home_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": false, "phase": "look", "for": "dark_home_off"},
  {"op": "wait", "s": 4.0, "phase": "look", "for": "dark_home_off"},
  {"op": "capture", "name": "dark_home_off", "desc": "the harness's dark night (ambient and sky energy cut, the sun hidden; a diagnostic), the fire's lights off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": true, "phase": "look", "for": "dark_home_on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "PROBE DARK  lights on", "phase": "look", "for": "dark_home_on"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "dark_home_on"},
  {"op": "capture", "name": "dark_home_on", "desc": "the harness's dark night (a diagnostic), the fire's lights on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "night_z8", "label": "NIGHT  lights off", "phase": "look", "for": "night_t*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "show": true, "phase": "look", "for": "night_t*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": false, "phase": "look", "for": "night_t0"},
  {"op": "wait", "s": 3.0, "phase": "look", "for": "night_t0"},
  {"op": "capture", "name": "night_t0", "desc": "outdoor_night, zoom 8 on the blaze, the fire's lights off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "extras", "what": "lights", "show": true, "phase": "look", "for": "night_t*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "NIGHT  lights as shipped", "phase": "look", "for": "night_t1"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "night_t1"},
  {"op": "capture", "name": "night_t1", "desc": "outdoor_night, zoom 8 on the blaze, the lights as shipped"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "lights", "energy": 8.0, "range": 12.0, "rise": 2.24, "decay": 0.5, "phase": "look", "for": "night_t2"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "NIGHT  round 2's lights: energy 8, range 12, rise 2.2, decay 0.5", "phase": "look", "for": "night_t2"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "night_t2"},
  {"op": "capture", "name": "night_t2", "desc": "outdoor_night, zoom 8 on the blaze, round 2's lights"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "lights", "energy": 20.0, "range": 12.0, "rise": 2.4, "decay": 0.5, "phase": "look", "for": "night_t3"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": "NIGHT  energy 20, range 12, rise 2.4, decay 0.5", "phase": "look", "for": "night_t3"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "night_t3"},
  {"op": "capture", "name": "night_t3", "desc": "outdoor_night, zoom 8 on the blaze, stronger lights than shipped"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "shot", "key": "day_home"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "label", "text": ""},
  {"op": "expand", "values": ["sunset_home", "sunset_z8", "sunset_z20", "sunset_zs", "night_home", "night_zs", "day_home", "day_zs"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_{value}", "columns": 3, "names": ["{value}_r4", "{value}_r2", "{value}_ls"], "tile": [960, 540]}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_motion", "columns": 4, "names": ["smoke_0", "smoke_1", "smoke_2", "smoke_3", "smoke_4", "smoke_5", "smoke_6", "smoke_7"], "tile": [720, 405]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_dark", "columns": 2, "names": ["dark_home_off", "dark_home_on"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/fire_lights_smoke", "out": "sheet_night_tune", "columns": 2, "names": ["night_t0", "night_t1", "night_t2", "night_t3"], "tile": [960, 540]},
  {"op": "index", "title": "Fire lights and smoke (card F4b-1, round 3)", "intro": "Produced by tools/render_jobs/jobs/firefeat_look.json on the saved _firefeat_look level (firefeat_build: a 200 ft temperate forest, seed 1234, fire laid with the real Fire tool: three straight passes, a shorter fourth and a curved blaze line, plus an author-laid fire south of them). Sheets sheet_<sunset|night|day>_<view>.png: ROUND 4 (<key>_r4, the field with its lights and smoke hidden, the accepted round 4 look), ROUND 2 (<key>_r2, this card's second round, its kept capture in render_jobs/fire_lights_smoke_round2 replayed: taken under the level's own sky at the dusk or night hour, not the presets; its sunset frames are its dusk ones and night_zs its dusk_zs) and NEW (<key>_ls, with the lights and smoke). Sunset is the game's outdoor_sunset preset with the sun at 19:00, night the outdoor_night preset with the sun at 23:00, day the level's own sky at 14:00; the lights show only while the sun is low. The zs view is zoom 12 framing the largest smoke column. sheet_motion: eight frames grabbed by the probe's burst 1.6 s apart at sunset in that view (smoke_times.txt has their engine times). sheet_dark: the harness's dark night (the probe's dark key: a flat dim ambient, sky reflections off, the sky's energy a tenth and the sun off; a diagnostic only) at home, the fire's lights off and on. sheet_night_tune: outdoor_night at zoom 8 on the blaze: the lights off, as shipped (energy 14), round 2's (energy 8) and a stronger one, set by the probe."},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
