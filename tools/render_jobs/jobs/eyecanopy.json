{
 "out_dir": "render_jobs/eyecanopy",
 "timeout_s": 900,
 "hang_s": 150,
 "saved": {"folder": "_camera_ek_wild", "load": "play"},
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_camera_ek_wild", "load": "play"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "new", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 3, "landform": "valley", "phase": "build"},
  {"op": "wait_ready", "settle": 1.5, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_camera_ek_wild", "replace": true, "phase": "build"},
  {"op": "play", "folder": "_camera_ek_wild", "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 26.0},
  {"op": "settle"},
  {"op": "capture", "name": "ek_orbit_before"},

  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "tree", "at": [10, 10], "d": 0.5, "pitch": 0, "fade": false},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "ek_t05_off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "tree", "d": 0.5, "pitch": 0, "fade": true},
  {"op": "wait", "s": 0.6},
  {"op": "capture", "name": "ek_t05_on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "tree", "d": 1.5, "pitch": 0, "fade": false},
  {"op": "wait", "s": 0.6},
  {"op": "capture", "name": "ek_t15_off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "tree", "d": 1.5, "pitch": 0, "fade": true},
  {"op": "wait", "s": 0.6},
  {"op": "capture", "name": "ek_t15_on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "tree", "d": 3.0, "pitch": 0, "fade": false},
  {"op": "wait", "s": 0.6},
  {"op": "capture", "name": "ek_t30_off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "tree", "d": 3.0, "pitch": 0, "fade": true},
  {"op": "wait", "s": 0.6},
  {"op": "capture", "name": "ek_t30_on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "tree", "d": 1.5, "pitch": -35, "fade": false},
  {"op": "wait", "s": 0.6},
  {"op": "capture", "name": "ek_t15u_off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "tree", "d": 1.5, "pitch": -35, "fade": true},
  {"op": "wait", "s": 0.6},
  {"op": "capture", "name": "ek_t15u_on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "report"},

  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "ghost", "at": [10, 10], "ahead": 6, "behind": 1.5, "width": 8, "off": 0, "fade": false},
  {"op": "wait", "s": 3.0},
  {"op": "capture", "name": "ek_gn_off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "ghost", "ahead": 6, "behind": 1.5, "width": 8, "off": 0, "fade": true},
  {"op": "wait", "s": 3.0},
  {"op": "capture", "name": "ek_gn_on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "ghost", "ahead": 6, "behind": 1.5, "width": 8, "off": 22, "occl": true, "fade": true},
  {"op": "wait", "s": 3.0},
  {"op": "capture", "name": "ek_oc_off22"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "ghost", "at": [-35, -30], "toward": [40, -30], "ahead": 66, "behind": 4, "width": 20, "off": 0, "fade": false},
  {"op": "wait", "s": 3.0},
  {"op": "capture", "name": "ek_gf_off"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "ghost", "toward": [40, -30], "ahead": 66, "behind": 4, "width": 20, "off": 0, "fade": true},
  {"op": "wait", "s": 3.0},
  {"op": "capture", "name": "ek_gf_on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_canopy.gd", "action": "clear"},

  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
  {"op": "settle"},
  {"op": "capture", "name": "ek_orbit_after", "desc": "orbit view after the eye, ghost and canopy as ever"},
  {"op": "wind", "freeze": false},
  {"op": "wait", "s": 0.5}
 ]
}
