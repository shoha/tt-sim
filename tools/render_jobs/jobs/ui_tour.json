{
 "out_dir": "render_jobs/ui_tour",
 "timeout_s": 480,
 "hang_s": 90,
 "steps": [
  {"op": "wait_title"},
  {"op": "wait", "s": 1.0},

  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 100, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "save", "folder": "_ui_tour_room", "name": "Mossy Hollow", "replace": true},
  {"op": "title"},
  {"op": "wait", "s": 1.0},

  {"op": "expand", "values": ["1280x720", "1920x1080"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": "{value}"},
   {"op": "wait", "s": 2.0},
   {"op": "capture", "name": "{value}_title", "desc": "{value}: the title screen with the test map Mossy Hollow in the level list"},

   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "settings", "section": "Audio"},
   {"op": "wait", "s": 1.2},
   {"op": "capture", "name": "{value}_settings_audio", "desc": "{value}: Settings over the title, Audio"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "settings", "section": "Graphics"},
   {"op": "wait", "s": 0.8},
   {"op": "capture", "name": "{value}_settings_graphics", "desc": "{value}: Settings, Graphics (Advanced closed)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "settings", "section": "Grid"},
   {"op": "wait", "s": 0.8},
   {"op": "capture", "name": "{value}_settings_grid", "desc": "{value}: Settings, Grid"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "settings", "section": "Controls"},
   {"op": "wait", "s": 0.8},
   {"op": "capture", "name": "{value}_settings_controls", "desc": "{value}: Settings, Controls"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "settings", "section": "Network"},
   {"op": "wait", "s": 0.8},
   {"op": "capture", "name": "{value}_settings_network", "desc": "{value}: Settings, Network"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "settings", "section": "Updates"},
   {"op": "wait", "s": 0.8},
   {"op": "capture", "name": "{value}_settings_updates", "desc": "{value}: Settings, Updates (hidden in Steam builds)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "close_settings"},
   {"op": "wait", "s": 1.0},

   {"op": "eval", "expr": "request_authoring(null, \"title\")"},
   {"op": "wait", "s": 1.2},
   {"op": "capture", "name": "{value}_new_map", "desc": "{value}: the new-map dialog over the title, as it opens"},
   {"op": "eval", "expr": "get(\"_new_map_dialog\")._on_cancel_pressed()"},
   {"op": "wait", "s": 0.8},

   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "host_lobby", "folder": "_ui_tour_room"},
   {"op": "wait", "s": 2.0},
   {"op": "capture", "name": "{value}_host_lobby", "desc": "{value}: the host lobby after hosting (no Steam lobby is made: a sample code and three sample players)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "close_host_lobby"},
   {"op": "wait", "s": 0.5},

   {"op": "eval", "expr": "change_state(2)"},
   {"op": "wait", "s": 2.0},
   {"op": "capture", "name": "{value}_join", "desc": "{value}: the join screen (client lobby) before a code is entered"},
   {"op": "title"},
   {"op": "wait", "s": 1.0},

   {"op": "dress", "folder": "_ui_tour_room"},
   {"op": "wait_ready", "settle": 1.5},
   {"op": "no_autosave"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "drawer", "which": "authoring", "pane": "biome"},
   {"op": "wait", "s": 1.0},
   {"op": "capture", "name": "{value}_authoring_drawer", "desc": "{value}: authoring on the test map, the tool drawer open on Biome"},
   {"op": "title"},
   {"op": "wait", "s": 1.0},

   {"op": "play", "folder": "_ui_tour_room"},
   {"op": "wait", "s": 3.0},
   {"op": "wait_ready", "settle": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "drawer", "which": "visuals", "pane": "sun"},
   {"op": "wait", "s": 1.0},
   {"op": "capture", "name": "{value}_play_drawer", "desc": "{value}: the play HUD on the test map with the Visuals drawer open on Sun"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "drawer", "which": "visuals", "open": false},
   {"op": "wait", "s": 0.8},

   {"op": "eval", "expr": "push_state(4)"},
   {"op": "wait", "s": 1.2},
   {"op": "capture", "name": "{value}_pause", "desc": "{value}: the pause menu over play"},
   {"op": "eval", "expr": "pop_state()"},
   {"op": "wait", "s": 0.8},

   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "danger"},
   {"op": "wait", "s": 1.2},
   {"op": "capture", "name": "{value}_danger", "desc": "{value}: a danger confirmation over play (Remove token)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "dismiss"},
   {"op": "wait", "s": 0.8},

   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "toasts"},
   {"op": "wait", "s": 0.8},
   {"op": "capture", "name": "{value}_toasts", "desc": "{value}: one toast of each kind over play (success, info, warning, error)"},
   {"op": "wait", "s": 4.0},

   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "browser"},
   {"op": "wait", "s": 1.5},
   {"op": "capture", "name": "{value}_asset_browser", "desc": "{value}: the Add Token asset browser over play, first tab"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "browser", "open": false},
   {"op": "wait", "s": 0.8},

   {"op": "call", "script": "res://tools/render_jobs/probes/avatar_builder.gd", "action": "open", "preset": 1},
   {"op": "wait", "s": 2.5},
   {"op": "capture", "name": "{value}_avatar_builder", "desc": "{value}: the avatar builder over play on a preset, Pose pane"},
   {"op": "call", "script": "res://tools/render_jobs/probes/avatar_builder.gd", "action": "close"},
   {"op": "wait", "s": 1.0},
   {"op": "title"},
   {"op": "wait", "s": 1.0}
  ]},

  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": "1720x720"},
  {"op": "wait", "s": 2.0},
  {"op": "capture", "name": "ultrawide_1720x720_title", "desc": "Probe: the title at 1720x720 (2.39:1); log.txt says whether the window took that size on this screen"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": "1920x1080"},
  {"op": "wait", "s": 1.0},

  {"op": "index", "title": "UI tour", "intro": "Produced by tools/render_jobs/jobs/ui_tour.json with probes/ui_primitives.gd: every top screen at 1280x720 and 1920x1080 window sizes (names start with the size), for the tt-sim-ui-critic agent (docs/UI_TASTE.md). A 100 ft temperate forest map is saved as the test level _ui_tour_room (shown as Mossy Hollow) for authoring, play and the host lobby, and deleted at the end. The host lobby is shown without hosting, with a sample code and players. Last, one ultrawide probe capture."},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "cleanup"}
 ]
}
