{
 "out_dir": "render_jobs/street_split",
 "timeout_s": 240,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "street", "from": [-15, -8], "to": [13, -8], "preset": 1},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "street", "from": [-15, 8], "to": [13, 8], "preset": 3},
  {"op": "wait", "s": 4.0},
  {"op": "look_at", "at": [0, 4]},
  {"op": "zoom", "size": 28.0},
  {"op": "wait", "s": 2.0},
  {"op": "capture", "name": "01_streets_before", "desc": "A terrace street (back) and a village street (front), as generated Wall rows"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "split"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "split"},
  {"op": "wait", "s": 4.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "flush"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "report"},
  {"op": "wait", "s": 2.0},
  {"op": "capture", "name": "02_streets_after", "desc": "The same two streets split into Structure records: a building each, from the core library"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
  {"op": "title"}
 ]
}
