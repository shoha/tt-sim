{
 "out_dir": "render_jobs/settlement_look_c",
 "timeout_s": 500,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 250, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/terrain_shapes.gd", "action": "hill", "at": [0, 0], "height": 6.0, "radius": 28.0},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 0.8},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 0.9},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "corridor"},
  {"op": "hide_ui"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 60.0},
  {"op": "settle"},
  {"op": "capture", "name": "01_home", "desc": "Farming hamlet (left) and market town (right), forest, home zoom"},
  {"op": "look_at", "at": [18, 0]},
  {"op": "zoom", "size": 24.0},
  {"op": "settle"},
  {"op": "capture", "name": "02_market_close", "desc": "Market town street, forest, close"},
  {"op": "look_at", "at": [-18, 0]},
  {"op": "settle"},
  {"op": "capture", "name": "03_hamlet_close", "desc": "Farming hamlet street, forest, close"},
  {"op": "look_at", "at": [18, 0]},
  {"op": "zoom", "size": 30.0},
  {"op": "settle"},
  {"op": "capture", "name": "04_hill_street", "desc": "Market street over a hill (20 degree slopes)"},
  {"op": "look_at", "at": [18, -8]},
  {"op": "zoom", "size": 12.0},
  {"op": "settle"},
  {"op": "capture", "name": "05_hill_close", "desc": "Hillside street, props on the slope, very close"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "report"},
  {"op": "index", "title": "Settlement look C", "intro": "Clearance, scale, colour and slopes"}
 ]
}
