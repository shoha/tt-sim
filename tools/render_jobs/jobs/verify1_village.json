{
 "out_dir": "render_jobs/verify1_village",
 "timeout_s": 900,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_verify1_village"},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 250, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_verify1_village", "replace": true, "phase": "build"},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"village\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/verify1_village.gd", "action": "list"},
  {"op": "view", "yaw": 0, "pitch": 80, "zoom": 22.0},
  {"op": "look_at", "at": [18, 0]},
  {"op": "settle"},
  {"op": "look_at", "at": {"rule": "street_lamps", "as": "lamp"}},
  {"op": "zoom", "size": 14.0},
  {"op": "look_at", "at": {"rule": "street_lamps", "as": "lamp"}},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/verify1_village.gd", "tag": "lamp_nothing_picked"},
  {"op": "input", "events": [{"type": "move", "at": {"rule": "street_lamps", "as": "lamp"}}, {"type": "move", "at": {"rule": "street_lamps", "as": "lamp"}}, {"type": "press", "at": {"rule": "street_lamps", "as": "lamp"}}, {"type": "release", "at": {"rule": "street_lamps", "as": "lamp"}}, {"type": "move", "at": [30, 0]}]},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/verify1_village.gd", "tag": "lamp_picked_unpinned"},
  {"op": "capture", "name": "a_lamp_picked", "desc": "a street lamp picked, not yet moved or turned: ring and pills (expect no Back)"},
  {"op": "input", "events": [{"type": "key", "key": "q", "pressed": true}, {"type": "key", "key": "q", "pressed": false}]},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/verify1_village.gd", "tag": "lamp_after_turn_q"},
  {"op": "capture", "name": "b_lamp_pinned_back", "desc": "the lamp turned a notch with Q (pinned): Back should appear beside Remove"},
  {"op": "input", "events": [{"type": "move", "at": {"control": "PieceBack"}}, {"type": "move", "at": {"control": "PieceBack"}}, {"type": "press", "at": {"control": "PieceBack"}}, {"type": "release", "at": {"control": "PieceBack"}}]},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/verify1_village.gd", "tag": "lamp_after_back_click"},
  {"op": "capture", "name": "c_lamp_after_back", "desc": "after a real click on Back: the lamp is home again; Back should be gone"},
  {"op": "input", "events": [{"type": "move", "at": {"rule": "street_lamps", "as": "lamp"}}, {"type": "press", "at": {"rule": "street_lamps", "as": "lamp"}}, {"type": "move", "at": {"rule": "street_lamps", "as": "lamp", "dx": 5}}, {"type": "move", "at": {"rule": "street_lamps", "as": "lamp", "dx": 10}}, {"type": "move", "at": {"rule": "street_lamps", "as": "lamp", "dx": 10}}]},
  {"op": "settle"},
  {"op": "capture", "name": "d_lamp_off_street", "desc": "the lamp carried 10 m east, past the street's reach (behind the east facades): refusal ring expected"},
  {"op": "input", "events": [{"type": "release", "at": {"rule": "street_lamps", "as": "lamp", "dx": 10}}]},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/verify1_village.gd", "tag": "lamp_after_off_street_release"},
  {"op": "capture", "name": "e_lamp_off_street_toast", "desc": "released off the street: the lamp is back, toast Keep it on its street expected"},
  {"op": "input", "events": [{"type": "move", "at": {"rule": "street_lamps", "as": "lamp"}}, {"type": "press", "at": {"rule": "street_lamps", "as": "lamp"}}, {"type": "move", "at": {"rule": "street_lamps", "as": "lamp", "dz": -3}}, {"type": "move", "at": {"rule": "street_lamps", "as": "lamp", "dz": -6}}, {"type": "move", "at": {"rule": "street_lamps", "as": "lamp", "dz": -6}}, {"type": "release", "at": {"rule": "street_lamps", "as": "lamp", "dz": -6}}]},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/verify1_village.gd", "tag": "lamp_moved_along_street"},
  {"op": "capture", "name": "f_lamp_moved_along", "desc": "the lamp dragged 6 m along its street (allowed): moved, pinned; Back expected beside it"},
  {"op": "look_at", "at": {"piece": "barrel", "as": "barrel"}},
  {"op": "settle"},
  {"op": "input", "events": [{"type": "move", "at": {"piece": "barrel", "as": "barrel"}}, {"type": "move", "at": {"piece": "barrel", "as": "barrel"}}, {"type": "press", "at": {"piece": "barrel", "as": "barrel"}}, {"type": "release", "at": {"piece": "barrel", "as": "barrel"}}, {"type": "move", "at": [30, 0]}, {"type": "key", "key": "q", "pressed": true}, {"type": "key", "key": "q", "pressed": false}]},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/verify1_village.gd", "tag": "barrel_after_turn_q"},
  {"op": "capture", "name": "g_barrel_pinned", "desc": "a lot piece (barrel) turned a notch: Swap / Back / Remove expected"},
  {"op": "index", "title": "verify1 village", "intro": "Back button and street pieces"}
 ]
}
