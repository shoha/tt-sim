{
 "out_dir": "render_jobs/p4d_perf",
 "timeout_s": 900,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "build start"},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [0, -3]},
  {"op": "zoom", "size": 20.0},
  {"op": "wait", "s": 1.5},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.8, "speed": 4.0, "curve": true, "points": [[-21, 5], [-14, 6], [-7, 4], [0, 1], [7, 0], [14, 1], [21, -2]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "stroke", "mode": "water", "shape": "pond", "depth": "deep", "radius": 3.2, "speed": 2.5, "points": [[-6, -12.5], [1, -12.5]], "hold": 0.6},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "stroke", "mode": "surface", "surface": "dirt_road_packed", "points": [[-7.5, 17], [-7.2, 11], [-7, 4], [-7, -3], [-7.8, -8]], "radius": 1.1, "speed": 2.5, "keep_active": true},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p4d_perf_water", "replace": true},

  {"op": "vsync_off"},
  {"op": "hide_ui"},
  {"op": "record", "on": true, "name": "idle"},
  {"op": "wait", "s": 4.0},
  {"op": "record", "on": false},

  {"op": "bridge_kind", "kind": "arch"},
  {"op": "look_at", "at": [-7, 4]},
  {"op": "zoom", "size": 10.0},
  {"op": "wait", "s": 1.5},
  {"op": "record", "on": true, "name": "arch_drag"},
  {"op": "gesture", "points": [[-7, 0.2], [-6.9, 7.8]], "speed": 3.0, "release": false},
  {"op": "record", "on": false},
  {"op": "record", "on": true, "name": "arch_release"},
  {"op": "input", "events": [{"type": "release", "at": [-6.9, 7.8]}]},
  {"op": "wait", "s": 1.5},
  {"op": "record", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "timing"},

  {"op": "bridge_kind", "kind": "ford"},
  {"op": "look_at", "at": [14, 1]},
  {"op": "wait", "s": 1.0},
  {"op": "record", "on": true, "name": "ford_drag"},
  {"op": "gesture", "points": [[14, -2.5], [14.2, 4.5]], "speed": 3.0, "release": false},
  {"op": "record", "on": false},
  {"op": "record", "on": true, "name": "ford_release"},
  {"op": "input", "events": [{"type": "release", "at": [14.2, 4.5]}]},
  {"op": "wait", "s": 1.5},
  {"op": "record", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "timing"},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},

  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "plank", "from": [-14, 2], "to": [-14, 10]},
  {"op": "wait", "s": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "timing"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "stones", "from": [7.4, -3.6], "to": [6.8, 3.4]},
  {"op": "wait", "s": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "timing"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "arch", "from": [-10.5, -12.5], "to": [5.5, -12.5]},
  {"op": "wait", "s": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "timing"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "place", "kind": "ford", "from": [0, -3], "to": [0, 5]},
  {"op": "wait", "s": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "timing"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "list"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "report"},

  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "bench", "kind": "plank", "from": [-18, 1.5], "to": [-18, 9.5], "runs": 20},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "bench", "kind": "arch", "from": [-18, 1.5], "to": [-18, 9.5], "runs": 20},

  {"op": "look_at", "at": [-7, 4]},
  {"op": "zoom", "size": 10.0},
  {"op": "wait", "s": 1.5},
  {"op": "record", "on": true, "name": "sculpt_by_arch"},
  {"op": "stroke", "mode": "sculpt", "tile": "raise", "radius": 2.2, "speed": 2.0, "hold": 1.0, "points": [[-8.5, 7.4], [-5.5, 7.4]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "record", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "timing"},
  {"op": "eval", "expr": "_authoring_controller.undo()"},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "list"},
  {"op": "call", "script": "res://tools/render_jobs/probes/crossing.gd", "action": "report"},
  {"op": "home"},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "perf_map_home", "desc": "The performance map: waist river, deep pond, path, six crossings (an arch where the path meets the river, a ford, a plank bridge, stepping stones, a pier arch along the pond, a second ford)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p4d_perf_cross", "replace": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "build end"},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
