  {"op": "stroke", "mode": "fire", "tile": "flames", "points": [[-25, 4], [25, 4]], "speed": 4.0, "radius": 4.0},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "stroke", "mode": "fire", "tile": "flames", "points": [[11, 10.5], [-11, 10.5]], "speed": 4.0, "radius": 4.0},
