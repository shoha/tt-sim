{
 "out_dir": "render_jobs/settlement_look",
 "timeout_s": 400,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "", "size": 250, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "select", "id": 2},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 0.8},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 0.8},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 60.0},
  {"op": "settle"},
  {"op": "capture", "name": "01_bar_home", "desc": "Both dressed, the Street tool bar of the market street visible, home camera"},
  {"op": "hide_ui"},
  {"op": "look_at", "at": [-18, 0]},
  {"op": "zoom", "size": 26.0},
  {"op": "settle"},
  {"op": "capture", "name": "02_farming_close", "desc": "Farming hamlet, calm"},
  {"op": "look_at", "at": [18, 0]},
  {"op": "settle"},
  {"op": "capture", "name": "03_market_close", "desc": "Market town, calm"},
  {"op": "look_at", "at": [18, 4]},
  {"op": "zoom", "size": 11.0},
  {"op": "settle"},
  {"op": "capture", "name": "04_market_detail", "desc": "Market town, very close"},
  {"op": "wind", "freeze": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "storm", "clock": 3.0},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "05_storm_a", "desc": "Market town in a storm"},
  {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "storm", "clock": 4.1},
  {"op": "wait", "s": 0.5},
  {"op": "capture", "name": "06_storm_b", "desc": "Market town in a storm, a moment later"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "report"},
  {"op": "index", "title": "Settlement look", "intro": "Farming hamlet and market town"}
 ]
}
