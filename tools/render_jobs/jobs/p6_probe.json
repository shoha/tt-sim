{
 "out_dir": "render_jobs/p6_probe",
 "timeout_s": 600,
 "hang_s": 90,
 "saved": {"folder": "_p6_probe", "load": "dress"},
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [0, 8], "phase": "build"},
  {"op": "zoom", "size": 24.0, "phase": "build"},
  {"op": "wait", "s": 1.5, "phase": "build"},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 4.0, "points": [[0, -10], [0, 22.8]], "phase": "build"},
  {"op": "wait_ready", "settle": 0.5, "phase": "build"},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()", "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "check", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p6_probe", "replace": true, "phase": "build"},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "info"},
  {"op": "expand", "values": ["now", "dip", "real_p0", "real", "real_depth", "real_prepass", "real_dither", "real_dissolve", "real_tint", "dip_tint", "dip_dither", "simple", "simple_dither"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "state", "name": "{value}", "from": [0, 20], "to": [0, 72], "phase": "look", "for": "edge_{value}*"},
   {"op": "home", "phase": "look", "for": "edge_{value},edge_{value}_fog"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "edge_{value},edge_{value}_fog"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "look", "at": [0, 26], "phase": "look", "for": "edge_{value},edge_{value}_fog"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "edge_{value},edge_{value}_fog"},
   {"op": "capture", "name": "edge_{value}", "desc": "State {value}: home zoom panned to where the river leaves the map"},
   {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "fog", "on": true, "density": 0.012, "phase": "look", "for": "edge_{value}_fog"},
   {"op": "wait", "s": 0.5, "phase": "look", "for": "edge_{value}_fog"},
   {"op": "capture", "name": "edge_{value}_fog", "desc": "State {value}: the same with depth fog on"},
   {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "fog", "on": false},
   {"op": "zoom", "size": 20.0, "phase": "look", "for": "edge_{value}_z20"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "edge_{value}_z20"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "look", "at": [0, 28], "phase": "look", "for": "edge_{value}_z20"},
   {"op": "wait", "s": 0.8, "phase": "look", "for": "edge_{value}_z20"},
   {"op": "capture", "name": "edge_{value}_z20", "desc": "State {value}: zoom 20 on the edge"},
   {"op": "zoom", "size": 8.0, "phase": "look", "for": "edge_{value}_z8"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "edge_{value}_z8"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "look", "at": [0, 24.5], "phase": "look", "for": "edge_{value}_z8"},
   {"op": "wait", "s": 0.8, "phase": "look", "for": "edge_{value}_z8"},
   {"op": "capture", "name": "edge_{value}_z8", "desc": "State {value}: zoom 8 on the river's mouth at the edge (seam, banks, foam)"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "state", "name": "real", "from": [0, 20], "to": [0, 72], "phase": "look", "for": "edge_real_noskirt_z8"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "skirt": false, "phase": "look", "for": "edge_real_noskirt_z8"},
  {"op": "zoom", "size": 8.0, "phase": "look", "for": "edge_real_noskirt_z8"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "edge_real_noskirt_z8"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "look", "at": [0, 24.5], "phase": "look", "for": "edge_real_noskirt_z8"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "edge_real_noskirt_z8"},
  {"op": "capture", "name": "edge_real_noskirt_z8", "desc": "Diagnostic: state real with the skirt hidden, zoom 8: where the ribbon lies and what it draws over the backdrop alone"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "skirt": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "info"},
  {"op": "zoom", "size": 20.0, "phase": "look", "for": "edge_gpu"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "edge_gpu"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "look", "at": [0, 28], "phase": "look", "for": "edge_gpu"},
  {"op": "vsync_off", "phase": "look", "for": "edge_gpu"},
  {"op": "expand", "values": ["1", "2"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "state", "name": "real", "from": [0, 20], "to": [0, 72], "phase": "look", "for": "edge_gpu"},
   {"op": "gpu", "name": "real ribbon on, skirt never #{value}", "s": 2.0, "phase": "look", "for": "edge_gpu"},
   {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "ribbon_visible", "visible": false, "phase": "look", "for": "edge_gpu"},
   {"op": "gpu", "name": "ribbon off, skirt never #{value}", "s": 2.0, "phase": "look", "for": "edge_gpu"},
   {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "skirt_depth", "mode": "dither", "phase": "look", "for": "edge_gpu"},
   {"op": "gpu", "name": "ribbon off, skirt dither #{value}", "s": 2.0, "phase": "look", "for": "edge_gpu"},
   {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "ribbon_visible", "visible": true, "phase": "look", "for": "edge_gpu"},
   {"op": "gpu", "name": "real ribbon on, skirt dither #{value}", "s": 2.0, "phase": "look", "for": "edge_gpu"},
   {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "skirt_depth", "mode": "tint", "phase": "look", "for": "edge_gpu"},
   {"op": "gpu", "name": "real ribbon on, skirt tint #{value}", "s": 2.0, "phase": "look", "for": "edge_gpu"},
   {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "ribbon_visible", "visible": false, "phase": "look", "for": "edge_gpu"},
   {"op": "gpu", "name": "ribbon off, skirt tint #{value}", "s": 2.0, "phase": "look", "for": "edge_gpu"},
   {"op": "call", "script": "res://tools/render_jobs/probes/skirt.gd", "action": "state", "name": "now", "from": [0, 20], "to": [0, 72], "phase": "look", "for": "edge_gpu"},
   {"op": "gpu", "name": "no dip, no ribbon, game skirt #{value}", "s": 2.0, "phase": "look", "for": "edge_gpu"}
  ]},
  {"op": "index", "title": "P6-0 water over the ground skirt", "intro": "Produced by tools/render_jobs/jobs/p6_probe.json at 1920x1080. A new 150 ft temperate forest map (seed 1234) with a straight waist river drawn from z = -10 through the near edge (z = 22.86), saved as _p6_probe; then probes/skirt.gd states: now (the game today), dip (the skirt rebuilt with 32 rings and the river's edge cross-section carried out along its course), real_p0 (dip + a water ribbon with the real water shader times the skirt's fade, at the skirt's render priority), real (the same one priority above the skirt), real_depth / real_prepass (the skirt shader hot-swapped to depth_draw_always / depth_prepass_alpha), real_dither / real_dissolve / real_tint (the skirt opaque, its fade as a per-pixel dither, world-space noise patches, or a colour fade to the backdrop), dip_tint / dip_dither (no ribbon), simple and simple_dither (a ribbon with no depth or screen reads). Each state at home zoom panned to the edge, the same with depth fog, at zoom 20 and at zoom 8 on the mouth; edge_real_noskirt_z8 shows the ribbon with the skirt hidden; GPU A/B (edge_gpu) in log.txt. Verdict in VERDICT.md."},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
