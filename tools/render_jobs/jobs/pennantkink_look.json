{
 "out_dir": "render_jobs/pennantkink_look",
 "timeout_s": 300,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 100, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "tile",
   "ornaments": ["banner"], "ref": "core:cottage", "width": 6.0, "depth": 4.0, "yaw": 50.0, "seed": 5, "decor": false},
  {"op": "wait", "s": 1.5},
  {"op": "thumbnail_prepare", "zoom": 20.0, "at": [0, 0]},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "aim_cloth",
   "fill": 0.4, "off_deg": 45.0, "preset": "calm", "clock": 0.0},
  {"op": "settle"},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "calm_t0", "desc": "pennant calm clock 0"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "aim_wind", "preset": "windy", "clock": 0.0},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "windy_t0", "desc": "pennant windy clock 0"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "aim_wind", "preset": "windy", "clock": 1.3},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "windy_t1", "desc": "pennant windy clock 1.3"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "aim_wind", "preset": "storm", "clock": 0.0},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "storm_t0", "desc": "pennant storm clock 0"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "aim_wind", "preset": "storm", "clock": 2.0},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "storm_t2", "desc": "pennant storm clock 2"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
  {"op": "title"}
 ]
}
