  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "hover", "at": [-0.5, 0.6], "radius": 5.0, "nth": 1},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "wild_mid_hover_p75", "desc": "valley, 6 m view, pitch 75, the pointer on one avatar pin: hovered (a tenth larger, whiter rim)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "hover", "clear": true},
