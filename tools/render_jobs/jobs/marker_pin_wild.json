   {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "hover", "clear": true},
   {"op": "wait", "s": 1.0},
   {"op": "capture", "name": "wild_crowd_p{value}", "desc": "valley, home zoom, pitch {value}: six tokens 0.6 m apart, no hover (lower pin in front)"},
   {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "hover", "at": [9.5, 2.0], "radius": 3.0, "nth": 2},
   {"op": "wait", "s": 1.0},
   {"op": "capture", "name": "wild_crowd_hover_p{value}", "desc": "valley, home zoom, pitch {value}: the pointer on the third pin of the crowd, drawn in front"},
   {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "click", "at": [9.5, 2.0], "radius": 3.0, "nth": 2},
   {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "hover", "clear": true}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "atlas", "path": "user://render_jobs/marker_pin_wild/atlas.png"},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "zoom", "which": "home"},
  {"op": "settle"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "settle"},
  {"op": "expand", "values": ["60", "75", "90"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": "{value}"},
   {"op": "settle"},
   {"op": "wait", "s": 1.0},
   {"op": "capture", "name": "wild_home_p{value}", "desc": "valley, home zoom, pitch {value}: folk, beasts, avatars, chunky models, a six-token crowd at right"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": 21.6},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "zoom", "which": "home"},
  {"op": "settle"},
  {"op": "wind", "freeze": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "clip", "name": "wild_o_toggle", "dir": "user://render_jobs/marker_pin_wild/wild_o_toggle", "seconds": 3.0, "fps": 30, "width": 960, "events": [{"at": 10, "do": "toggle"}, {"at": 55, "do": "toggle"}]},
  {"op": "wait", "s": 3.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/marker_pin_wild/wild_o_toggle", "names": ["wild_o_toggle_0008", "wild_o_toggle_0010", "wild_o_toggle_0012", "wild_o_toggle_0014", "wild_o_toggle_0016", "wild_o_toggle_0018", "wild_o_toggle_0020", "wild_o_toggle_0022", "wild_o_toggle_0024", "wild_o_toggle_0026", "wild_o_toggle_0028", "wild_o_toggle_0030"], "columns": 4, "tile": [480, 270], "out": "wild_o_toggle_sheet"},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/marker_pin_wild", "names": ["wild_crowd_p75", "wild_crowd_hover_p75", "wild_crowd_p90", "wild_crowd_hover_p90", "wild_home_p90", "wild_home_p90", "wild_home_p90", "wild_home_p75"], "crops": [[0.38, 0.28, 0.24, 0.32], [0.38, 0.28, 0.24, 0.32], [0.38, 0.28, 0.24, 0.32], [0.38, 0.28, 0.24, 0.32], [0.24, 0.1, 0.24, 0.32], [0.54, 0.05, 0.24, 0.32], [0.65, 0.4, 0.24, 0.32], [0.24, 0.1, 0.24, 0.32]], "columns": 4, "tile": [461, 346], "out": "wild_pin_crops"},
  {"op": "index", "title": "marker pin wild", "intro": "Camera rig card 4: the token pin, valley"},
  {"op": "title"},
  {"op": "wait", "s": 0.5}
 ]
}
