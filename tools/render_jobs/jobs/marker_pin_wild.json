   {"op": "wait", "s": 1.5},
   {"op": "capture", "name": "wild_closest_p{value}", "desc": "valley, closest zoom (2 m), pitch {value}: the pin above an avatar"}
  ]},
  {"op": "zoom", "size": 6.0},
  {"op": "settle"},
  {"op": "look_at", "at": [-0.5, 0.6]},
  {"op": "settle"},
  {"op": "expand", "values": ["60", "75", "90"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": "{value}"},
