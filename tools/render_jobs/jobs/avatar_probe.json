{
 "out_dir": "render_jobs/avatar_probe",
 "timeout_s": 720,
 "hang_s": 90,
 "saved": {"folder": "_avatarprobe_forest", "load": "play"},
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "place", "biome": "temperate_forest_summer_s1", "species": "oak", "at": [3.0, -1.5], "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "save", "folder": "_avatarprobe_forest", "replace": true, "phase": "build"},
  {"op": "title", "phase": "build"},
  {"op": "wait", "s": 1.0, "phase": "build"},
  {"op": "play", "folder": "_avatarprobe_forest", "phase": "build"},
  {"op": "wait", "s": 3.0, "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "hide_ui"},
  {"op": "home"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "info"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "bench", "runs": 20},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "tokens", "points": [[1.4, 1.6]]},
  {"op": "wait", "s": 2.0},

  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "spawn", "mode": "skinned", "count": 6, "at": [-1.2, 0.6], "spacing": 1.3, "phase": "look", "for": "look_*"},
  {"op": "home", "phase": "look", "for": "look_home*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "look_home*"},
  {"op": "capture", "name": "look_home", "desc": "Home zoom in play, default lighting: six skinned stand-in figures (two stances, base / stocky / slender, four palettes) beside a real token and a placed oak on the temperate forest ground; shader v2, the chosen values (atlas shadow colours, key mix 0.5, scene shadows ignored)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "params", "pass": "body", "params": {"shadow_from_atlas": 0.0, "key_mix": 0.0, "scene_shadow_push": 2.0}, "phase": "look", "for": "look_home_v1"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "look_home_v1"},
  {"op": "capture", "name": "look_home_v1", "desc": "The same with shader v1: scene sun only, computed cool shadow tint, cast shadows put the whole figure in shadow colour"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "params", "pass": "body", "params": {"shadow_from_atlas": 1.0, "key_mix": 0.5, "scene_shadow_push": 0.0, "rim_side": 0.0}},
  {"op": "zoom", "size": 4.0, "phase": "look", "for": "look_close*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "look_close*"},
  {"op": "look_at", "at": [-1.2, 0.6], "phase": "look", "for": "look_close*"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "look_close*"},
  {"op": "capture", "name": "look_close", "desc": "Zoom 4 on the figures, shader v2"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "params", "pass": "body", "params": {"shadow_from_atlas": 0.0, "key_mix": 0.0, "scene_shadow_push": 2.0}, "phase": "look", "for": "look_close_v1"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "look_close_v1"},
  {"op": "capture", "name": "look_close_v1", "desc": "Zoom 4, shader v1 (scene sun only, computed cool tint, full scene shadow)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "params", "pass": "body", "params": {"shadow_from_atlas": 1.0, "key_mix": 1.0, "scene_shadow_push": 0.0, "rim_side": 1.0}, "phase": "look", "for": "look_close_v3"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "params", "pass": "hull", "params": {"outline_px": 2.0}, "phase": "look", "for": "look_close_v3"},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "look_close_v3"},
  {"op": "capture", "name": "look_close_v3", "desc": "Zoom 4, shader v3: fixed view key light only (key mix 1), rim on every silhouette, 2 px outline"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "params", "pass": "body", "params": {"shadow_from_atlas": 1.0, "key_mix": 0.5, "scene_shadow_push": 0.6, "rim_side": 0.0}, "phase": "look", "for": "look_close_scene_shadow"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "params", "pass": "hull", "params": {"outline_px": 1.5}},
  {"op": "wait", "s": 0.3, "phase": "look", "for": "look_close_scene_shadow"},
  {"op": "capture", "name": "look_close_scene_shadow", "desc": "Zoom 4, shader v2 with scene cast shadows pushing the band by 0.6 (the soft-shadow filter's stipple lands on the colour blocks)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "params", "pass": "body", "params": {"shadow_from_atlas": 1.0, "key_mix": 0.5, "scene_shadow_push": 0.0, "rim_side": 0.0}},

  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "clear", "phase": "look", "for": "twin_*"},
  {"op": "zoom", "size": 3.0, "phase": "look", "for": "twin_*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "twin_*"},
  {"op": "look_at", "at": [-1.2, 0.6], "phase": "look", "for": "twin_*"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "twin_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/falls.gd", "action": "clock", "scale": 0.0, "phase": "look", "for": "twin_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "twin", "mode": "skinned", "at": [-1.2, 0.6], "stance": 0, "variant": 1, "palette": 0, "phase": "look", "for": "twin_*"},
  {"op": "capture", "name": "twin_skinned", "scale": 1.0, "desc": "Zoom 3, shader clock frozen: one stocky figure, skinned (stance 0), outline hull on"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "twin", "mode": "baked", "at": [-1.2, 0.6], "stance": 0, "variant": 1, "palette": 0, "phase": "look", "for": "twin_*"},
  {"op": "capture", "name": "twin_baked", "scale": 1.0, "desc": "The same figure baked to a static mesh: a pixel diff against twin_skinned (probes/avatar_diff.gd) says whether the hull and toon pass see the skinned vertices"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "twin", "mode": "skinned", "at": [-1.2, 0.6], "stance": 0, "variant": 1, "palette": 0, "phase": "look", "for": "twin_*"},
  {"op": "capture", "name": "twin_skinned_again", "scale": 1.0, "desc": "Skinned again: the noise floor for the diff"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "twin", "mode": "skinned", "at": [-1.2, 0.6], "stance": 0, "variant": 0, "palette": 0, "phase": "look", "for": "twin_*"},
  {"op": "capture", "name": "twin_uniform_skinned", "scale": 1.0, "desc": "The base figure (no bone scale) skinned, for a diff without non-uniform scale"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "twin", "mode": "baked", "at": [-1.2, 0.6], "stance": 0, "variant": 0, "palette": 0, "phase": "look", "for": "twin_*"},
  {"op": "capture", "name": "twin_uniform_baked", "scale": 1.0, "desc": "The base figure baked"},
  {"op": "call", "script": "res://tools/render_jobs/probes/falls.gd", "action": "clock", "scale": 1.0},

  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "clear", "phase": "look", "for": "token_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "adopt", "index": 0, "highlight": true, "phase": "look", "for": "token_*"},
  {"op": "zoom", "size": 6.0, "phase": "look", "for": "token_*"},
  {"op": "look_at", "at": [1.4, 1.6], "phase": "look", "for": "token_*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "token_*"},
  {"op": "capture", "name": "token_glow", "desc": "Zoom 6: a figure standing in a real token's place (its meshes hidden) with the selection glow"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "adopt", "index": 0, "hidden": true, "phase": "look", "for": "token_hidden"},
  {"op": "wait", "s": 0.5, "phase": "look", "for": "token_hidden"},
  {"op": "capture", "name": "token_hidden", "desc": "The same token hidden from players: the GM's semi-transparent view (BoardToken only fades StandardMaterial3D)"},

  {"op": "vsync_off", "phase": "look", "for": "perf"},
  {"op": "home", "phase": "look", "for": "perf"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "perf"},
  {"op": "expand", "phase": "look", "for": "perf", "values": ["r1_none_0", "r1_skinned_8", "r1_baked_8", "r1_skinned_30", "r1_baked_30", "r2_baked_30", "r2_skinned_30", "r2_baked_8", "r2_skinned_8", "r2_none_0", "r3_none_0", "r3_skinned_8", "r3_baked_8", "r3_skinned_30", "r3_baked_30"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "spawn", "config": "{value}", "at": [0, 0], "spacing": 1.5, "phase": "look", "for": "perf"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "perf"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "{value} home", "phase": "look", "for": "perf"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "perf"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop", "phase": "look", "for": "perf"}
  ]},
  {"op": "zoom", "size": 20.0, "phase": "look", "for": "perf"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "perf"},
  {"op": "expand", "phase": "look", "for": "perf", "values": ["r1_none_0", "r1_skinned_8", "r1_baked_8", "r1_skinned_30", "r1_baked_30", "r2_baked_30", "r2_skinned_30", "r2_baked_8", "r2_skinned_8", "r2_none_0", "r3_none_0", "r3_skinned_8", "r3_baked_8", "r3_skinned_30", "r3_baked_30"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "spawn", "config": "{value}", "at": [0, 0], "spacing": 1.5, "phase": "look", "for": "perf"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "perf"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "{value} z20", "phase": "look", "for": "perf"},
   {"op": "wait", "s": 2.5, "phase": "look", "for": "perf"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop", "phase": "look", "for": "perf"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "z20 baked 30", "phase": "look", "for": "perf"},

  {"op": "call", "script": "res://tools/render_jobs/probes/p6.gd", "action": "preset", "name": "outdoor_sunset", "phase": "look", "for": "sunset_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar.gd", "action": "spawn", "mode": "skinned", "count": 6, "at": [-1.2, 0.6], "spacing": 1.3, "phase": "look", "for": "sunset_*"},
  {"op": "home", "phase": "look", "for": "sunset_home"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "sunset_home"},
  {"op": "capture", "name": "sunset_home", "desc": "Home zoom under the outdoor_sunset preset"},
  {"op": "zoom", "size": 4.0, "phase": "look", "for": "sunset_close"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "sunset_close"},
  {"op": "look_at", "at": [-1.2, 0.6], "phase": "look", "for": "sunset_close"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "sunset_close"},
  {"op": "capture", "name": "sunset_close", "desc": "Zoom 4 under the outdoor_sunset preset"},

  {"op": "index", "title": "Avatar token probe", "intro": "Produced by tools/render_jobs/jobs/avatar_probe.json. A new 150 ft temperate forest map (seed 1234) with a placed oak, saved as _avatarprobe_forest and played; probes/avatar.gd places stand-in avatar figures (probes/avatar_figure.gd, about 1.4K triangles, 19 humanoid bones) drawn with the probe toon shader and outline hull, skinned or baked; frame times (perf.gd) for 0 / 8 / 30 figures skinned and baked at home and zoom 20 are in log.txt."},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
