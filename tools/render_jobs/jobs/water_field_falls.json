{
 "out_dir": "render_jobs/water_field_falls",
 "timeout_s": 900,
 "hang_s": 240,
 "steps": [
  {"op": "wait_title"},

  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 200, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 20.0},
  {"op": "wait", "s": 1.5},
  {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[-13, -14], [-3, -14], [-3, -10], [-13, -10]], "radius": 3.0, "speed": 3.0, "keep_active": true},
  {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[-11, -13.5], [-5, -13.5], [-5, -10.5], [-11, -10.5]], "radius": 2.4, "speed": 2.5, "keep_active": true},
  {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[4, -14], [14, -14], [14, -10], [4, -10]], "radius": 3.0, "speed": 3.0, "keep_active": true},
  {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[6, -13.5], [12, -13.5], [12, -10.5], [6, -10.5]], "radius": 2.4, "speed": 2.5, "keep_active": true},
  {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[-13, 6], [-3, 6], [-3, 10], [-13, 10]], "radius": 3.0, "speed": 3.0, "keep_active": true},
  {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[-21, -5], [-17, -5], [-17, -1], [-21, -1]], "radius": 2.0, "speed": 2.5, "keep_active": true},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.5, "speed": 4.0, "points": [[-8, -13.5], [-8, 0]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "ankle", "radius": 0.55, "speed": 3.0, "points": [[-8, 6.5], [-8, 18]]},
  {"op": "wait_ready", "settle": 0.5},
  {"op": "stroke", "mode": "water", "shape": "river", "depth": "waist", "radius": 1.0, "speed": 4.0, "points": [[-21.5, -6], [-11.5, -0.5]]},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_painter-water-field-painted_falls", "replace": true},
  {"op": "title"},
  {"op": "wait", "s": 2.0},

  {"op": "wait_title"},
  {"op": "play", "folder": "_painter-water-field-painted_falls"},
  {"op": "wait", "s": 3.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water_field.gd", "action": "hud"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/water_field.gd", "action": "painted", "on": true},
  {"op": "wait", "s": 6.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/water_field.gd", "action": "mood", "preset": "level"},
  {"op": "wait", "s": 3.0},

  {"op": "expand", "values": ["f1_o", "f1_t", "f3_t", "f5_o", "f1_z"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/water_field.gd", "action": "setup", "name": "{value}"},
   {"op": "settle"}, {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/falls.gd", "action": "clock", "scale": 0},
   {"op": "call", "script": "res://tools/render_jobs/probes/water_field.gd", "action": "mode", "mode": "field"},
   {"op": "capture", "name": "field_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water_field.gd", "action": "water", "visible": false},
   {"op": "capture", "name": "dry_{value}"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water_field.gd", "action": "water", "visible": true},
   {"op": "call", "script": "res://tools/render_jobs/probes/water_field.gd", "action": "mode", "mode": "field"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water_field.gd", "action": "measure", "dir": "user://render_jobs/water_field_falls", "name": "field_{value}", "dry": "dry_{value}", "label": "field"},
   {"op": "call", "script": "res://tools/render_jobs/probes/falls.gd", "action": "clock", "scale": 1}
  ]},

  {"op": "title"},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/water_field.gd", "action": "cleanup"},
  {"op": "wait", "s": 0.5}
 ]
}
