{
 "out_dir": "render_jobs/phase5_terraces",
 "timeout_s": 900,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "expand", "values": ["3", "1", "9"], "template": [
   {"op": "saved", "folder": "_p5j_terraces_temperate_forest_summer_s1_{value}"},
   {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": "{value}", "landform": "terraces", "phase": "build"},
   {"op": "wait_ready", "settle": 1.5, "phase": "build"},
   {"op": "no_autosave"},
   {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p5j_terraces_temperate_forest_summer_s1_{value}", "replace": true, "phase": "build"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "report", "landform": "terraces"},
   {"op": "hide_ui"},
   {"op": "home", "phase": "look", "for": "terraces_forest_{value}_home*"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "terraces_forest_{value}_home*"},
   {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "terraces_forest_{value}_home"},
   {"op": "wait", "s": 0.8, "phase": "look", "for": "terraces_forest_{value}_home"},
   {"op": "capture", "name": "terraces_forest_{value}_home", "desc": "Temperate forest, 150 ft, Terraces, seed {value}, the home camera with the grid: do the tiers read as steps with their rock faces, the river falling at each when drawn, the plank bridge on the top terrace"},
   {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "terraces_forest_{value}_home"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": false, "phase": "look", "for": "terraces_forest_{value}_home_nowater"},
   {"op": "wait", "s": 0.5, "phase": "look", "for": "terraces_forest_{value}_home_nowater"},
   {"op": "capture", "name": "terraces_forest_{value}_home_nowater", "desc": "The same with the water hidden: the tiers alone"},
   {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": true},
   {"op": "zoom", "size": 8.0, "phase": "look", "for": "terraces_forest_{value}_*_z8"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "terraces_forest_{value}_*_z8"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "stage", "landform": "terraces", "phase": "look", "for": "terraces_forest_{value}_stage_z8"},
   {"op": "wait", "s": 1.5, "phase": "look", "for": "terraces_forest_{value}_stage_z8"},
   {"op": "capture", "name": "terraces_forest_{value}_stage_z8", "desc": "Zoom 8 on the stage on the middle (or lower) terrace"},
   {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "crossing", "landform": "terraces", "phase": "look", "for": "terraces_forest_{value}_feature_z8"},
   {"op": "wait", "s": 1.0, "phase": "look", "for": "terraces_forest_{value}_feature_z8"},
   {"op": "capture", "name": "terraces_forest_{value}_feature_z8", "desc": "Zoom 8 on the plank bridge, else the river's middle, else the lowest ground near the centre (the step's foot)"},
   {"op": "title"},
   {"op": "wait", "s": 1.0}
  ]},

  {"op": "saved", "folder": "_p5j_terraces_boreal_taiga_summer_s1_3"},
  {"op": "new_map", "biome": "boreal_taiga_summer_s1", "size": 150, "seed": 3, "landform": "terraces", "phase": "build"},
  {"op": "wait_ready", "settle": 1.5, "phase": "build"},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_p5j_terraces_boreal_taiga_summer_s1_3", "replace": true, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "report", "landform": "terraces"},
  {"op": "hide_ui"},
  {"op": "home", "phase": "look", "for": "terraces_taiga_3_home*"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "terraces_taiga_3_home*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "terraces_taiga_3_home"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "terraces_taiga_3_home"},
  {"op": "capture", "name": "terraces_taiga_3_home", "desc": "Boreal taiga, 150 ft, Terraces, seed 3 (the forest's seed 3 under pines: three tiers, a river with two falls, a plank bridge), the home camera with the grid"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "terraces_taiga_3_home"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": false, "phase": "look", "for": "terraces_taiga_3_home_nowater"},
  {"op": "wait", "s": 0.5, "phase": "look", "for": "terraces_taiga_3_home_nowater"},
  {"op": "capture", "name": "terraces_taiga_3_home_nowater", "desc": "The same with the water hidden"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "water", "visible": true},
  {"op": "zoom", "size": 8.0, "phase": "look", "for": "terraces_taiga_3_*_z8"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "terraces_taiga_3_*_z8"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "stage", "landform": "terraces", "phase": "look", "for": "terraces_taiga_3_stage_z8"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "terraces_taiga_3_stage_z8"},
  {"op": "capture", "name": "terraces_taiga_3_stage_z8", "desc": "Zoom 8 on the stage"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "look", "at": "crossing", "landform": "terraces", "phase": "look", "for": "terraces_taiga_3_feature_z8"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "terraces_taiga_3_feature_z8"},
  {"op": "capture", "name": "terraces_taiga_3_feature_z8", "desc": "Zoom 8 on the plank bridge"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},

  {"op": "play", "folder": "_p5j_terraces_temperate_forest_summer_s1_3", "phase": "look", "for": "terraces_forest_3_play_*"},
  {"op": "wait", "s": 3.0, "phase": "look", "for": "terraces_forest_3_play_*"},
  {"op": "wait_ready", "settle": 2.0, "phase": "look", "for": "terraces_forest_3_play_*"},
  {"op": "hide_ui", "phase": "look", "for": "terraces_forest_3_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540], "phase": "look", "for": "terraces_forest_3_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "tokens", "points": [[-0.5, 0.0], [-6.5, -14.4]], "phase": "look", "for": "terraces_forest_3_play_*"},
  {"op": "wait", "s": 3.0, "phase": "look", "for": "terraces_forest_3_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "report", "phase": "look", "for": "terraces_forest_3_play_*"},
  {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g", "phase": "look", "for": "terraces_forest_3_play_*"},
  {"op": "wait", "s": 0.8, "phase": "look", "for": "terraces_forest_3_play_*"},
  {"op": "home", "phase": "look", "for": "terraces_forest_3_play_home_grid"},
  {"op": "wait", "s": 1.5, "phase": "look", "for": "terraces_forest_3_play_home_grid"},
  {"op": "capture", "name": "terraces_forest_3_play_home_grid", "desc": "Seed 3 in play, home zoom, grid on: a token on the stage and one on the plank bridge"},
  {"op": "title", "phase": "look", "for": "terraces_forest_3_play_*"},
  {"op": "wait", "s": 1.0, "phase": "look", "for": "terraces_forest_3_play_*"},

  {"op": "index", "title": "P5-4 judgment set: Terraces", "intro": "Produced by tools/render_jobs/jobs/phase5_terraces.json at 1920x1080. New 150 ft Terraces maps through the driver's new_map op, saved as _p5j_terraces_<biome>_<seed>: temperate forest seeds 3 (three tiers, a river with two falls, a plank bridge), 1 (two tiers, a river, no bridge) and 9 (two tiers, dry), and boreal taiga seed 3. Per level: home with the grid, home with the water hidden, zoom 8 on the stage and on the bridge, the river or the step; then seed 3 played with tokens. The recipe's report per level is in log.txt."}
 ]
}
