{
  "out_dir": "render_jobs/struct_perf_village",
  "timeout_s": 420,
  "hang_s": 120,
  "remove_override": true,
  "steps": [
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 320, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
    {"op": "look_at", "at": [0, 0]},
    {"op": "zoom", "size": 60.0},
    {"op": "vsync_off"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "idle"},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "base"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "mem", "name": "base"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "base_a"},
    {"op": "wait", "s": 5.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "village", "count": 30},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "v30"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "mem", "name": "v30"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "v30_a"},
    {"op": "wait", "s": 5.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
    {"op": "wait", "s": 2.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "village", "count": 100},
    {"op": "wait", "s": 3.0},
    {"op": "capture", "name": "01_v100", "desc": "One hundred structures, home zoom"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "v100"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "mem", "name": "v100"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "v100_a"},
    {"op": "wait", "s": 5.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "zoom", "size": 20.0},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "v100_zoom_in"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "v100_in"},
    {"op": "wait", "s": 5.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
    {"op": "wait", "s": 2.0},
    {"op": "zoom", "size": 60.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "base_b"},
    {"op": "wait", "s": 5.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
    {"op": "title"}
  ]
}
