{
  "out_dir": "render_jobs/p36_paint",
  "timeout_s": 480,
  "steps": [
    {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 4321},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "look_at", "at": [4, -3]},
    {"op": "zoom", "size": 20.0},
    {"op": "wait", "s": 1.0},

    {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[4, -10], [14, -10], [14, -6], [4, -6], [4, -2], [14, -2]], "radius": 3.5, "speed": 3.0, "keep_active": true},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[9, -9], [13, -9], [13, -6], [9, -6]], "radius": 2.2, "speed": 2.5, "keep_active": true},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "shift": true, "points": [[-2, -5], [3, -5], [-2, -5], [3, -5], [-2, -5], [3, -5]], "radius": 2.5, "speed": 2.0, "hold": 1.0, "keep_active": true},
    {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/height_profile.gd", "from": [-4, -5], "to": [6, -5], "n": 41},
    {"op": "capture", "name": "p00_shaped", "desc": "Grassland meadow 150 ft: two tiers and a ramp on tier 1's west face, before paint"},

    {"op": "record", "name": "track"},
    {"op": "stroke", "mode": "surface", "surface": "dirt_road_packed", "points": [[-18, 12], [-14, 9], [-11, 4], [-7, 0], [-4, -4], [0, -5], [3, -5], [6, -4], [8, -1.5]], "radius": 1.3, "speed": 2.5, "release": false},
    {"op": "record", "on": false},
    {"op": "capture", "name": "p01_track_during", "desc": "Dirt track, still pressed at its end on tier 1 (plants clear at release)"},
    {"op": "release"},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "capture", "name": "p02_track", "desc": "Dirt track from the low ground up the ramp onto tier 1, after release"},
    {"op": "call", "script": "res://tools/render_jobs/probes/paint_check.gd", "points": [[-11, 4], [-10, 3], [-9, 2], [-8, 1], [-7, 0], [-6, -1.3], [-5, -2.7], [-4, -4], [-2, -4.5], [0, -5], [3, -5], [6, -4]]},

    {"op": "record", "name": "courtyard"},
    {"op": "stroke", "mode": "surface", "surface": "flagstone", "points": [[9.5, -9.2], [12.5, -9.2], [12.5, -7.6], [9.5, -7.6], [9.5, -6], [12.5, -6]], "radius": 1.6, "speed": 2.0, "hold": 0.6, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "wait_ready", "settle": 1.0},

    {"op": "record", "name": "cobble"},
    {"op": "stroke", "mode": "surface", "surface": "cobblestone", "points": [[5, 10], [5, 5], [5, 0], [5, -2.5]], "radius": 1.1, "speed": 2.0, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "wait_ready", "settle": 1.0},

    {"op": "stroke", "mode": "surface", "surface": "cliff_basalt", "points": [[17.6, -12], [17.6, -3]], "radius": 1.3, "speed": 1.5, "hold": 0.4, "keep_active": true},
    {"op": "wait_ready", "settle": 1.0},

    {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
    {"op": "look_at", "at": [6, -2]},
    {"op": "zoom", "size": 18.0},
    {"op": "wait", "s": 1.2},
    {"op": "capture", "name": "p03_all", "desc": "Track, flagstone courtyard on tier 2, cobblestone path across tier 1's south edge, basalt east face"},
    {"op": "zoom", "size": 10.0},
    {"op": "wait", "s": 1.2},
    {"op": "look_at", "at": [5, 1]},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "p04_cobble_edge", "desc": "Zoom 10: the cobblestone path stops at the rock face and resumes on top"},
    {"op": "look_at", "at": [11, -7]},
    {"op": "wait", "s": 1.2},
    {"op": "capture", "name": "p05_courtyard", "desc": "Zoom 10: the flagstone courtyard on tier 2"},
    {"op": "look_at", "at": [16, -7]},
    {"op": "wait", "s": 1.2},
    {"op": "capture", "name": "p06_basalt", "desc": "Zoom 10: tier 1's east face restyled with basalt"},
    {"op": "eval", "expr": "_authoring_controller.undo()"},
    {"op": "wait", "s": 0.5},
    {"op": "capture", "name": "p06b_basalt_undone", "desc": "Zoom 10: the same face with the basalt stroke undone (the biome's own cliff)"},
    {"op": "eval", "expr": "_authoring_controller.redo()"},
    {"op": "wait", "s": 0.5},
    {"op": "look_at", "at": [-3, -3]},
    {"op": "wait", "s": 1.2},
    {"op": "capture", "name": "p07_ramp", "desc": "Zoom 10: the track climbing the ramp"},

    {"op": "look_at", "at": [-8, 3]},
    {"op": "zoom", "size": 16.0},
    {"op": "record", "name": "erase"},
    {"op": "stroke", "mode": "surface", "surface": "dirt_road_packed", "ctrl": true, "points": [[-15, 10], [-12, 6], [-10, 3]], "radius": 1.8, "speed": 2.0, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "capture", "name": "p08_erased", "desc": "Part of the track erased with Ctrl: grass and plants return"},

    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
    {"op": "look_at", "at": [6, -2]},
    {"op": "zoom", "size": 18.0},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "p09_grid", "desc": "The painted plateau with the grid on"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
    {"op": "home"},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "p10_home", "desc": "Home view"},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_params.gd", "params": {"paint_broad_strength": 0.0}},
    {"op": "wait", "s": 0.5},
    {"op": "capture", "name": "p11_home_no_fringe", "desc": "Home view, A/B: no trampled fringe around built paint (paint_broad_strength 0)"},
    {"op": "call", "script": "res://tools/render_jobs/probes/ground_params.gd", "params": {"paint_broad_strength": 0.35}},

    {"op": "eval", "expr": "_authoring_controller.history.undo_count()"},
    {"op": "eval", "expr": "_authoring_controller.document.surface_ids"},
    {"op": "eval", "expr": "_authoring_controller.undo()"},
    {"op": "eval", "expr": "_authoring_controller.document.surface_ids"},
    {"op": "eval", "expr": "_authoring_controller.redo()"},
    {"op": "eval", "expr": "_authoring_controller.session.is_dirty()"},

    {"op": "index", "title": "Paint tool look pass (P3-6)", "intro": "Human-speed strokes through the real Paint tool on a sculpted grassland meadow."},
    {"op": "title"}
  ]
}
