{
 "out_dir": "D:/dev/tt-sim/docs/plans/2026-10-20-native-scatter/cover",
 "timeout_s": 900,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "expand", "values": ["lead", "cover"], "template": [
   {"op": "new_map", "biome": "rocky_badlands_summer_s1", "size": 200, "seed": 1234},
   {"op": "wait_ready", "settle": 1.0},
   {"op": "no_autosave"},
   {"op": "hide_ui"},
   {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
   {"op": "call", "script": "res://tools/render_jobs/probes/prepare_biomes.gd", "all": true},
   {"op": "zoom", "size": 13.85},
   {"op": "wait", "s": 5.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/prepare_biomes.gd"},
   {"op": "call", "script": "res://tools/render_jobs/probes/brush_latency.gd", "action": "live", "mode": "on"},
   {"op": "call", "script": "res://tools/render_jobs/probes/brush_latency.gd", "action": "mode", "mode": "{value}", "landing": "{value}"},

   {"op": "look_at", "at": [-10, 0]},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/brush_latency.gd", "action": "watch", "name": "clip_{value}_dab", "dir": "D:/dev/tt-sim/docs/plans/2026-10-20-native-scatter/cover"},
   {"op": "call", "script": "res://tools/render_jobs/probes/brush_latency.gd", "action": "film", "name": "film_{value}_dab", "seconds": 2.5, "gap": 30, "dir": "D:/dev/tt-sim/docs/plans/2026-10-20-native-scatter/cover/film"},
   {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "radius": 3.5, "hold": 0.5, "points": [[-10, 0], [-10, 0]]},
   {"op": "wait", "s": 3.0},
   {"op": "wait_ready", "settle": 0.5},

   {"op": "look_at", "at": [12, 0]},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/brush_latency.gd", "action": "watch", "name": "clip_{value}_stroke", "dir": "D:/dev/tt-sim/docs/plans/2026-10-20-native-scatter/cover"},
   {"op": "call", "script": "res://tools/render_jobs/probes/brush_latency.gd", "action": "film", "name": "film_{value}_stroke", "seconds": 2.5, "gap": 30, "dir": "D:/dev/tt-sim/docs/plans/2026-10-20-native-scatter/cover/film"},
   {"op": "stroke", "mode": "paint", "biome": "grassland_meadow_summer_s1", "radius": 2.5, "speed": 6.0, "points": [[9, 0], [15, 0]]},
   {"op": "wait", "s": 3.0},
   {"op": "wait_ready", "settle": 0.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/brush_latency.gd", "action": "busy"},

   {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
   {"op": "title"},
   {"op": "wait", "s": 1.0}
  ]},
  {"op": "wait", "s": 0.5}
 ]
}
