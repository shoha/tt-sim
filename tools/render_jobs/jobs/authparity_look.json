{
 "out_dir": "render_jobs/authparity_look",
 "timeout_s": 600,
 "hang_s": 90,
 "saved": {"folder": "_authparity_token", "load": "play", "settle": 2.0},
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 300, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/authparity.gd", "action": "save", "folder": "_authparity_token", "token": [0, 0], "replace": true, "phase": "build"},
  {"op": "title", "phase": "build"},
  {"op": "wait", "s": 1.0, "phase": "build"},
  {"op": "dress", "folder": "_authparity_token", "phase": "build"},
  {"op": "wait", "s": 3.0, "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540], "phase": "build"},
  {"op": "look_at", "at": [0, 0], "phase": "build"},
  {"op": "zoom", "size": 8.0, "phase": "build"},
  {"op": "wait", "s": 1.5, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/authparity.gd", "action": "report", "phase": "build"},
  {"op": "capture", "name": "auth_token", "desc": "Authoring, zoom 8: the level's saved avatar token standing on the map", "phase": "build"},
  {"op": "stroke", "mode": "sculpt", "tile": "raise", "points": [[0.6, 0.4], [0.7, 0.4]], "radius": 5.0, "speed": 1.0, "hold": 2.0, "phase": "build"},
  {"op": "wait_ready", "settle": 1.5, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/authparity.gd", "action": "report", "phase": "build"},
  {"op": "capture", "name": "auth_raised", "desc": "Authoring, zoom 8: the ground raised under the token, which authoring set down on top of it", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/authparity.gd", "action": "save", "folder": "_authparity_token", "token": [0, 0], "y": 0.0, "replace": true, "phase": "build"},
  {"op": "title", "phase": "build"},
  {"op": "wait", "s": 1.0, "phase": "build"},
  {"op": "play", "folder": "_authparity_token", "phase": "build"},
  {"op": "wait", "s": 3.0, "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/authparity.gd", "action": "report"},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 8.0},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "play_token", "desc": "Play, zoom 8: the token saved at its old height (buried by the raise), set down on the raised ground by the play load"},
  {"op": "zoom"},
  {"op": "wait", "s": 2.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/authparity.gd", "action": "report"},
  {"op": "capture", "name": "play_whole", "desc": "Play, full zoom-out on the 300 ft map: the whole-map zoom and the shadow reach authoring has (MapViewFit)"},
  {"op": "index", "title": "Authoring parity", "intro": "A 300 ft grassland meadow saved with one avatar token as the _authparity_token test level; the token in authoring; a sculpt raise under it; the level saved again with the token at its old height, buried; then played: the play load sets it down on the raised ground, and the play camera zooms out to the whole map. Delete the level with authparity_cleanup."},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
