{
  "out_dir": "render_jobs/p35_sculpt",
  "timeout_s": 420,
  "steps": [
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 1234},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "home"},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "f00_start", "desc": "Temperate forest, 150 ft, as created"},

    {"op": "record", "name": "f_raise"},
    {"op": "stroke", "mode": "sculpt", "tile": "raise", "points": [[-13, -9], [-11, -8], [-12, -6]], "radius": 5.0, "speed": 2.0, "hold": 2.5, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "wait_ready", "settle": 0.5},
    {"op": "look_at", "at": [-12, -7]},
    {"op": "zoom", "size": 16.0},
    {"op": "wait", "s": 1.2},
    {"op": "capture", "name": "f01_hill", "desc": "Raise: one held stroke, 5 m brush"},

    {"op": "look_at", "at": [9, -4]},
    {"op": "zoom", "size": 18.0},
    {"op": "hover", "tile": "tier", "at": [5, -8], "radius": 3.5},
    {"op": "wait", "s": 0.6},
    {"op": "capture", "name": "f02_tier_hover", "desc": "Tier tile hovering flat ground: the readout says Tier 1 +5 ft"},
    {"op": "record", "name": "f_tier1"},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[5, -8], [14, -8], [14, -4], [5, -4], [5, 0], [14, 0]], "radius": 3.5, "speed": 3.0, "release": false},
    {"op": "record", "on": false},
    {"op": "capture", "name": "f03_tier1_during", "desc": "Tier 1 from the ground, still pressed"},
    {"op": "release"},
    {"op": "wait_ready", "settle": 0.5},
    {"op": "capture", "name": "f04_tier1", "desc": "Tier 1 after release (one zigzag stroke from the ground)"},
    {"op": "call", "script": "res://tools/render_jobs/probes/height_profile.gd", "from": [0, -6], "to": [4, -6], "n": 33},

    {"op": "hover", "tile": "tier", "at": [9.5, -4], "radius": 2.2},
    {"op": "wait", "s": 0.6},
    {"op": "capture", "name": "f05_tier2_hover", "desc": "Hovering inside the tier 1 top with a small brush: Tier 2 +10 ft"},
    {"op": "record", "name": "f_tier2"},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[8, -5], [11, -5], [11, -3], [8, -3]], "radius": 2.2, "speed": 2.5, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "wait_ready", "settle": 0.5},
    {"op": "capture", "name": "f06_tier2", "desc": "Tier 2 stroked from the first tier's top"},

    {"op": "hover", "tile": "tier", "at": [14, 1.5], "radius": 3.0},
    {"op": "wait", "s": 0.6},
    {"op": "capture", "name": "f07_extend_hover", "desc": "Hovering the tier 1 edge: the readout stays Tier 1 (extend)"},
    {"op": "record", "name": "f_extend"},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[14, 1.5], [16, 5], [18, 9]], "radius": 3.0, "speed": 3.0, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "wait_ready", "settle": 0.5},
    {"op": "look_at", "at": [11, 0]},
    {"op": "wait", "s": 1.0},
    {"op": "capture", "name": "f08_extended", "desc": "Tier 1 extended by a stroke from its edge"},

    {"op": "look_at", "at": [-8, 10]},
    {"op": "hover", "tile": "tier", "at": [-12, 10], "radius": 3.5, "ctrl": true},
    {"op": "wait", "s": 0.8},
    {"op": "capture", "name": "f09_cut_hover", "desc": "Ctrl over flat ground: Tier -1 -5 ft"},
    {"op": "record", "name": "f_cut"},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "ctrl": true, "points": [[-12, 10], [-5, 10], [-5, 13]], "radius": 3.5, "speed": 3.0, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "wait_ready", "settle": 0.5},
    {"op": "call", "script": "res://tools/render_jobs/probes/height_profile.gd", "from": [-16, 10], "to": [-1, 10], "n": 31},
    {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
    {"op": "look_at", "at": [-8, 11]},
    {"op": "zoom", "size": 12.0},
    {"op": "wait", "s": 1.2},
    {"op": "capture", "name": "f10_sunken", "desc": "A sunken tier cut with Ctrl, zoom 12"},
    {"op": "zoom", "size": 18.0},

    {"op": "look_at", "at": [4, -4]},
    {"op": "record", "name": "f_ramp"},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "shift": true, "points": [[2, -4], [7, -4], [2, -4], [7, -4], [2, -4]], "radius": 2.5, "speed": 2.0, "hold": 1.0, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "wait_ready", "settle": 0.5},
    {"op": "call", "script": "res://tools/render_jobs/probes/height_profile.gd", "from": [-2, -4], "to": [6, -4], "n": 33},
    {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
    {"op": "zoom", "size": 12.0},
    {"op": "wait", "s": 1.2},
    {"op": "capture", "name": "f11_ramp", "desc": "Shift (Smooth) back and forth across the tier's west face: a ramp, zoom 12"},
    {"op": "zoom", "size": 18.0},

    {"op": "look_at", "at": [-12, -5]},
    {"op": "record", "name": "f_flatten"},
    {"op": "stroke", "mode": "sculpt", "tile": "flatten", "points": [[-12, -3], [-9, -2], [-7, -4]], "radius": 3.0, "speed": 1.5, "hold": 1.0, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "wait_ready", "settle": 0.5},
    {"op": "capture", "name": "f12_flatten", "desc": "Flatten across the hill's flank: a shelf at the press height"},

    {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
    {"op": "home"},
    {"op": "look_at", "at": [0, 0]},
    {"op": "zoom", "size": 30.0},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "f13_overview", "desc": "Everything, zoom 30"},
    {"op": "call", "script": "res://tools/render_jobs/probes/terrain_shapes.gd", "action": "stats", "area": [0, -12, 20, 10]},
    {"op": "eval", "expr": "_authoring_controller.history.undo_count()"},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[10, 15], [12, 15]], "radius": 2.0, "speed": 2.0, "release": false},
    {"op": "call", "script": "res://tools/render_jobs/probes/height_profile.gd", "from": [11, 15], "to": [11, 15.1], "n": 2},
    {"op": "eval", "expr": "_game_map.get_brush_tool()._cancel_gesture()"},
    {"op": "call", "script": "res://tools/render_jobs/probes/height_profile.gd", "from": [11, 15], "to": [11, 15.1], "n": 2},
    {"op": "eval", "expr": "_authoring_controller.history.undo_count()"},
    {"op": "eval", "expr": "_authoring_controller.undo()"},
    {"op": "eval", "expr": "_authoring_controller.undo()"},
    {"op": "eval", "expr": "_authoring_controller.undo()"},
    {"op": "call", "script": "res://tools/render_jobs/probes/height_profile.gd", "from": [-9, 10], "to": [-8, 10], "n": 2},
    {"op": "eval", "expr": "_authoring_controller.redo()"},
    {"op": "eval", "expr": "_authoring_controller.redo()"},
    {"op": "eval", "expr": "_authoring_controller.redo()"},
    {"op": "call", "script": "res://tools/render_jobs/probes/height_profile.gd", "from": [-9, 10], "to": [-8, 10], "n": 2},
    {"op": "eval", "expr": "_authoring_controller.session.is_dirty()"},

    {"op": "title"},
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "rocky_badlands_summer_s1", "size": 150, "seed": 77},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "no_autosave"},
    {"op": "look_at", "at": [0, 0]},
    {"op": "zoom", "size": 20.0},
    {"op": "record", "name": "b_raise"},
    {"op": "stroke", "mode": "sculpt", "tile": "raise", "points": [[-13, -9], [-11, -8], [-12, -6]], "radius": 5.0, "speed": 2.0, "hold": 2.5, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "record", "name": "b_tier1"},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[5, -8], [14, -8], [14, -4], [5, -4], [5, 0], [14, 0]], "radius": 3.5, "speed": 3.0, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "record", "name": "b_tier2"},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[8, -5], [11, -5], [11, -3], [8, -3]], "radius": 2.2, "speed": 2.5, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "points": [[14, 1.5], [16, 5], [18, 9]], "radius": 3.0, "speed": 3.0, "keep_active": true},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "ctrl": true, "points": [[-12, 10], [-5, 10], [-5, 13]], "radius": 3.5, "speed": 3.0, "keep_active": true},
    {"op": "stroke", "mode": "sculpt", "tile": "tier", "shift": true, "points": [[2, -4], [7, -4], [2, -4], [7, -4], [2, -4]], "radius": 2.5, "speed": 2.0, "hold": 1.0, "keep_active": true},
    {"op": "record", "name": "b_flatten"},
    {"op": "stroke", "mode": "sculpt", "tile": "flatten", "points": [[-12, -3], [-9, -2], [-7, -4]], "radius": 3.0, "speed": 1.5, "hold": 1.0, "keep_active": true},
    {"op": "record", "on": false},
    {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
    {"op": "wait_ready", "settle": 1.0},
    {"op": "look_at", "at": [9, -3]},
    {"op": "zoom", "size": 16.0},
    {"op": "wait", "s": 1.2},
    {"op": "capture", "name": "b01_plateau", "desc": "Badlands: two-level plateau, extension, ramp on its west face"},
    {"op": "look_at", "at": [-9, 11]},
    {"op": "zoom", "size": 14.0},
    {"op": "wait", "s": 1.2},
    {"op": "capture", "name": "b02_sunken", "desc": "Badlands: the sunken tier (Ctrl)"},
    {"op": "look_at", "at": [-12, -6]},
    {"op": "wait", "s": 1.2},
    {"op": "capture", "name": "b03_hill_flatten", "desc": "Badlands: the raised hill with a flattened shelf"},
    {"op": "look_at", "at": [0, 0]},
    {"op": "zoom", "size": 30.0},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "b04_overview", "desc": "Badlands overview, zoom 30"},
    {"op": "call", "script": "res://tools/render_jobs/probes/grid_ground.gd", "action": "key_g"},
    {"op": "look_at", "at": [9, -3]},
    {"op": "zoom", "size": 16.0},
    {"op": "wait", "s": 1.5},
    {"op": "capture", "name": "b05_grid", "desc": "Badlands plateau with the grid: squares on every tier top"},
    {"op": "call", "script": "res://tools/render_jobs/probes/terrain_shapes.gd", "action": "stats", "area": [0, -12, 20, 10]},

    {"op": "index", "title": "Sculpt tool look pass (P3-5)", "intro": "Human-speed strokes through the real Sculpt tool."},
    {"op": "title"}
  ]
}
