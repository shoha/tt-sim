{
  "out_dir": "render_jobs/warmstruct_profile",
  "timeout_s": 240,
  "hang_s": 120,
  "remove_override": true,
  "steps": [
    {"op": "wait_title"},
    {"op": "wait", "s": 1.0},
    {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 300, "seed": 1234},
    {"op": "wait_ready", "settle": 1.5},
    {"op": "no_autosave"},
    {"op": "hide_ui"},
    {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
    {"op": "wind", "freeze": true},
    {"op": "look_at", "at": [0, 0]},
    {"op": "zoom", "size": 60.0},
    {"op": "vsync_off"},
    {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "idle"},
    {"op": "settle"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "idle_a"},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},

    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "open_structure_tool"},
    {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"structure\")"},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "warm_report"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "place1_cold"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "place", "count": 1, "seed": 100},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "warm_report"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
    {"op": "wait", "s": 1.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "begin", "name": "place1_warm"},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "place", "count": 1, "seed": 700},
    {"op": "wait", "s": 3.0},
    {"op": "call", "script": "res://tools/render_jobs/probes/hitches.gd", "action": "rec", "mode": "end"},
    {"op": "call", "script": "res://tools/render_jobs/probes/structures.gd", "action": "remove_all"},
    {"op": "wait", "s": 1.0},
    {"op": "title"}
  ]
}
