{
 "out_dir": "render_jobs/ground_opt_parity",
 "timeout_s": 1500,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "expand", "values": ["grassland", "road", "savanna", "taiga", "mixed"], "template": [
   {"op": "title"}, {"op": "wait", "s": 1.0},
   {"op": "dress", "folder": "_timing_head_{value}"},
   {"op": "wait_ready", "settle": 3.0}, {"op": "no_autosave"},
   {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false},
   {"op": "hide_ui"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "nocursor"},
   {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
   {"op": "home"}, {"op": "wait", "s": 2.3},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "report"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "state", "code": "new"},

   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "freeze"},
   {"op": "capture", "name": "{value}_home_new", "scale": 1.0, "desc": "{value} home, new code, clock frozen near 0"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "thaw"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "state", "code": "old_ground", "base": "D:/dev/tabletop/worktrees/tt-sim-gopt-base"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "freeze"},
   {"op": "capture", "name": "{value}_home_old", "scale": 1.0, "desc": "the same view with the 401bbf9e include"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "thaw"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "state", "code": "new"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "freeze"},
   {"op": "capture", "name": "{value}_home_new2", "scale": 1.0, "desc": "the new code again: the control"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "thaw"},

   {"op": "zoom", "size": 26.0}, {"op": "wait", "s": 2.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "freeze"},
   {"op": "capture", "name": "{value}_z26_new", "scale": 1.0, "desc": "{value} zoom 26, new code"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "thaw"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "state", "code": "old_ground", "base": "D:/dev/tabletop/worktrees/tt-sim-gopt-base"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "freeze"},
   {"op": "capture", "name": "{value}_z26_old", "scale": 1.0, "desc": "the same view with the 401bbf9e include"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "thaw"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "state", "code": "new"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "freeze"},
   {"op": "capture", "name": "{value}_z26_new2", "scale": 1.0, "desc": "the new code again: the control"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "thaw"},

   {"op": "zoom", "size": 45.0}, {"op": "wait", "s": 2.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "freeze"},
   {"op": "capture", "name": "{value}_z45_new", "scale": 1.0, "desc": "{value} zoom 45 (the skirt), new code"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "thaw"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "state", "code": "old_ground", "base": "D:/dev/tabletop/worktrees/tt-sim-gopt-base"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "freeze"},
   {"op": "capture", "name": "{value}_z45_old", "scale": 1.0, "desc": "the same view with the 401bbf9e include"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "thaw"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "state", "code": "new"},
   {"op": "wait", "s": 1.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "freeze"},
   {"op": "capture", "name": "{value}_z45_new2", "scale": 1.0, "desc": "the new code again: the control"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "thaw"},
   {"op": "wait", "s": 1.0},

   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "bake_bytes", "name": "{value} as loaded"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "restamp_none"},
   {"op": "wait", "s": 1.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "bake_bytes", "name": "{value} with no stamps"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "restamp"},
   {"op": "wait", "s": 1.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "bake_bytes", "name": "{value} restamped with kept materials"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "stamps_fresh"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "restamp"},
   {"op": "wait", "s": 1.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "bake_bytes", "name": "{value} restamped with fresh materials"},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "rerender"},
   {"op": "wait", "s": 1.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/ground_timing.gd", "action": "bake_bytes", "name": "{value} fresh, drawn again"}
  ]},
  {"op": "title"}, {"op": "wait", "s": 1.0}
 ]
}
