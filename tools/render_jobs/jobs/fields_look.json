{
 "out_dir": "render_jobs/fields_look",
 "timeout_s": 600,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 250, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 0.9},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "add", "id": 1, "at": [-35, -13], "radius": 7.5, "kind": "crops"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "add", "id": 1, "at": [-35, 8], "radius": 7.0, "kind": "crops"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "add", "id": 1, "at": [-18, 35], "radius": 7.5, "kind": "orchard"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "add", "id": 2, "at": [31, 3], "radius": 5.0, "kind": "garden"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "report"},
  {"op": "look_at", "at": [-6, 6]},
  {"op": "zoom", "size": 60.0},
  {"op": "settle"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"village\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "lay", "field": true},
  {"op": "input", "events": [{"type": "move", "at": [-60, -40]}]},
  {"op": "settle"},
  {"op": "capture", "name": "a_home_fields", "desc": "home zoom: the hamlet (west) with two crop fields and an orchard, the market (east) with a garden; Field picked in the pane"},
  {"op": "zoom", "size": 24.0},
  {"op": "look_at", "at": [-32, -3]},
  {"op": "settle"},
  {"op": "capture", "name": "b_close_crops", "desc": "close: the two crop fields beside the hamlet's west houses, rows and scarecrows"},
  {"op": "look_at", "at": [4, 24]},
  {"op": "zoom", "size": 34.0},
  {"op": "settle"},
  {"op": "capture", "name": "c_close_orchard_garden", "desc": "the hamlet's orchard at its north end; the market garden off to the east"},
  {"op": "zoom", "size": 22.0},
  {"op": "look_at", "at": [-26, -28]},
  {"op": "settle"},
  {"op": "input", "events": [{"type": "move", "at": [-24, -33]}]},
  {"op": "settle"},
  {"op": "capture", "name": "d_ghost_crops", "desc": "the ghost of a crop field past the hamlet's south-west houses, its hint and ochre tint"},
  {"op": "input", "events": [{"type": "move", "at": [-60, -40]}]},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "redress", "id": 1},
  {"op": "zoom", "size": 60.0},
  {"op": "look_at", "at": [-6, 6]},
  {"op": "settle"},
  {"op": "capture", "name": "e_home_redressed", "desc": "home zoom after a re-dress of the hamlet: the rows turn and the orchard's trees move (no sameness)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1280, 720]},
  {"op": "settle"},
  {"op": "zoom", "size": 22.0},
  {"op": "look_at", "at": [-30, -10]},
  {"op": "settle"},
  {"op": "gesture", "points": [[-35, -13], [-35, -13]]},
  {"op": "settle"},
  {"op": "capture", "name": "f_720_pane", "desc": "1280x720: a picked crop field, the pane's Lay row on Field, the kind row, the size row and Remove"},
  {"op": "index", "title": "fields look", "intro": "Villages phase 3 first slice: crop fields, an orchard and a garden laid with the Village tool"}
 ]
}
