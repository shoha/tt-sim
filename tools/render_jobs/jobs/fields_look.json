{
 "out_dir": "render_jobs/fields_look",
 "timeout_s": 600,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 320, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-14, -12], "to": [-14, 12], "preset": 3, "seed": 21},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [14, -12], "to": [14, 12], "preset": 2, "seed": 31},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 0.9},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "add", "id": 1, "at": [-21, -22], "radius": 6.0, "kind": "crops"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "add", "id": 1, "at": [-6, -22], "radius": 5.5, "kind": "crops"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "add", "id": 1, "at": [-14, 22], "radius": 6.0, "kind": "orchard"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "add", "id": 2, "at": [14, -19], "radius": 4.5, "kind": "garden"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "report"},
  {"op": "look_at", "at": [0, 3]},
  {"op": "zoom", "size": 60.0},
  {"op": "settle"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"village\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "lay", "field": true},
  {"op": "input", "events": [{"type": "move", "at": [-90, -60]}]},
  {"op": "settle"},
  {"op": "capture", "name": "a_home_fields", "desc": "home zoom: the hamlet (west) with two crop fields and an orchard, the market (east) with a garden; Crops picked in the pane"},
  {"op": "zoom", "size": 24.0},
  {"op": "settle"},
  {"op": "look_at", "at": [-13, -21]},
  {"op": "settle"},
  {"op": "capture", "name": "b_close_crops", "desc": "close: the two crop fields past the hamlet's south end, rows and scarecrows"},
  {"op": "look_at", "at": [-14, 21]},
  {"op": "settle"},
  {"op": "capture", "name": "c_close_orchard", "desc": "close: the hamlet's orchard past its north end"},
  {"op": "zoom", "size": 20.0},
  {"op": "settle"},
  {"op": "look_at", "at": [14, -18]},
  {"op": "settle"},
  {"op": "capture", "name": "c2_close_garden", "desc": "close: the market town's garden past its south end"},
  {"op": "zoom", "size": 22.0},
  {"op": "settle"},
  {"op": "look_at", "at": [-21, 3]},
  {"op": "settle"},
  {"op": "input", "events": [{"type": "move", "at": [-25, 4]}]},
  {"op": "settle"},
  {"op": "capture", "name": "d_ghost_crops", "desc": "the pointer just past the hamlet's west houses: a click's 8 m crop field would cover a house, so the ghost is refused (salmon pill 'Over a building')"},
  {"op": "look_at", "at": [2, 22]},
  {"op": "input", "events": [{"type": "move", "at": [2, 26]}]},
  {"op": "settle"},
  {"op": "capture", "name": "d2_ghost_open", "desc": "the ghost of a crop field on open ground between the villages' north ends, its hint and ochre tint"},
  {"op": "input", "events": [{"type": "move", "at": [-90, -60]}]},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "redress", "id": 1},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "report"},
  {"op": "look_at", "at": [0, 3]},
  {"op": "zoom", "size": 60.0},
  {"op": "settle"},
  {"op": "capture", "name": "e_home_redressed", "desc": "home zoom after a re-dress of the hamlet (a new seed): the rows turn and the orchard's trees move (no sameness)"},
  {"op": "zoom", "size": 24.0},
  {"op": "settle"},
  {"op": "look_at", "at": [-13, -21]},
  {"op": "settle"},
  {"op": "capture", "name": "g_close_crops_redressed", "desc": "the same close view as b after the re-dress: the fields' rows differ by seed"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1280, 720]},
  {"op": "settle"},
  {"op": "zoom", "size": 22.0},
  {"op": "settle"},
  {"op": "look_at", "at": [-17, -18]},
  {"op": "settle"},
  {"op": "gesture", "points": [[-21, -22], [-21, -22]]},
  {"op": "settle"},
  {"op": "capture", "name": "f_720_pane", "desc": "1280x720: a picked crop field; the pane's one Lay row (Plaza, Crops, Orchard, Garden pictures), the room line, the size row and Remove"},
  {"op": "call", "script": "res://tools/render_jobs/probes/fields.gd", "action": "pick", "id": 2},
  {"op": "look_at", "at": [20, -6]},
  {"op": "input", "events": [{"type": "move", "at": [24, -4]}]},
  {"op": "settle"},
  {"op": "capture", "name": "h_720_pane_market", "desc": "1280x720: the market town picked, laying its default Garden; Crops greyed and the caption line saying the market town keeps no crops"},
  {"op": "index", "title": "fields look", "intro": "Villages phase 3 first slice: crop fields, an orchard and a garden laid with the Village tool, on an 80 m (320 ft) map"}
 ]
}
