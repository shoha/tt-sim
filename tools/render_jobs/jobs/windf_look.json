{
 "out_dir": "render_jobs/windf_look",
 "timeout_s": 600,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/close_zoom.gd", "action": "fade", "on": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/ground_parity.gd", "action": "nocursor"},
  {"op": "hide_ui"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "pond", "points": [[9, 5], [13, 6]], "radius": 5.0, "depth": "deep"},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "stroke", "mode": "fire", "tile": "blaze", "points": [[-13, -6], [-2, -6]], "speed": 3.0, "radius": 3.0},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "stroke", "mode": "fire", "tile": "blaze", "points": [[-2, -3.5], [-13, -3.5]], "speed": 3.0, "radius": 3.0},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "eval", "expr": "_game_map.get_brush_tool().deactivate()"},
  {"op": "wait", "s": 4.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/fire.gd", "action": "info"},
  {"op": "expand", "values": ["calm", "windy", "storm"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "{value}", "clock": 0.0, "motion": 1.0, "sway": false},
   {"op": "call", "script": "res://tools/render_jobs/probes/windf.gd", "action": "dust", "at": [-1, 9], "age": 0.5, "height": 10},
   {"op": "home"},
   {"op": "wait", "s": 1.5},
   {"op": "capture", "name": "{value}_home", "desc": "{value} at home: smoke columns over the blaze (left), the pond (right), a tree's dust held 0.9 s in (middle, front)"},
   {"op": "zoom", "size": 8.0},
   {"op": "look_at", "at": [-7.5, -5]},
   {"op": "wait", "s": 1.5},
   {"op": "capture", "name": "{value}_fire", "desc": "{value}, zoom 8 on the blaze and its smoke columns, wind clock 0"},
   {"op": "look_at", "at": [11, 5.5]},
   {"op": "wait", "s": 1.5},
   {"op": "capture", "name": "{value}_water", "desc": "{value}, zoom 8 on the pond (chop)"},
   {"op": "look_at", "at": [2, 9]},
   {"op": "wait", "s": 1.0},
   {"op": "capture", "name": "{value}_dust", "desc": "{value}, zoom 8 on the dust, 0.9 s in"}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "storm", "clock": 3.0, "motion": 1.0, "sway": false},
  {"op": "zoom", "size": 8.0},
  {"op": "look_at", "at": [-7.5, -5]},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "storm3_fire", "desc": "storm, zoom 8 on the blaze, wind clock 3 s (a different place in the gust)"},
  {"op": "look_at", "at": [11, 5.5]},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "storm3_water", "desc": "storm, zoom 8 on the pond, wind clock 3 s"},
  {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "storm", "clock": 0.0, "motion": 0.0, "sway": false},
  {"op": "call", "script": "res://tools/render_jobs/probes/windf.gd", "action": "dust", "at": [-1, 9], "age": 0.5, "height": 10},
  {"op": "home"},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "still_home", "desc": "storm with Wind motion 0: everything as before the wind"},
  {"op": "zoom", "size": 8.0},
  {"op": "look_at", "at": [-7.5, -5]},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "still_fire", "desc": "storm, motion 0, zoom 8 on the blaze"},
  {"op": "look_at", "at": [11, 5.5]},
  {"op": "wait", "s": 1.5},
  {"op": "capture", "name": "still_water", "desc": "storm, motion 0, zoom 8 on the pond"},
  {"op": "look_at", "at": [2, 9]},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "still_dust", "desc": "storm, motion 0, zoom 8 on the dust"},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/windf_look", "out": "sheet_home", "columns": 2, "names": ["calm_home", "windy_home", "storm_home", "still_home"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/windf_look", "out": "sheet_fire", "columns": 3, "names": ["calm_fire", "windy_fire", "storm_fire", "storm3_fire", "still_fire"], "tile": [640, 360]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/windf_look", "out": "sheet_water", "columns": 3, "names": ["calm_water", "windy_water", "storm_water", "storm3_water", "still_water"], "tile": [640, 360]},
  {"op": "call", "script": "res://tools/render_jobs/probes/contact_sheet.gd", "dir": "user://render_jobs/windf_look", "out": "sheet_dust", "columns": 2, "names": ["calm_dust", "windy_dust", "storm_dust", "still_dust"], "tile": [960, 540]},
  {"op": "call", "script": "res://tools/render_jobs/probes/windf.gd", "action": "clear"},
  {"op": "call", "script": "res://tools/render_jobs/probes/wind.gd", "action": "set", "preset": "calm", "motion": 1.0, "unpin": true},
  {"op": "title"},
  {"op": "wait", "s": 1.0}
 ]
}
