{
 "out_dir": "render_jobs/p5_perf",
 "timeout_s": 900,
 "hang_s": 90,
 "remove_override": true,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "play start"},

  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "play", "folder": "_p5_perf_terraces"},
  {"op": "wait", "s": 2.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "title"},
  {"op": "wait", "s": 1.5},
  {"op": "expand", "values": ["_p5_perf_flat", "_p5_perf_terraces", "_p5_perf_flat", "_p5_perf_terraces", "_p5_perf_flat", "_p5_perf_terraces"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "play", "folder": "{value}"},
   {"op": "wait", "s": 2.0},
   {"op": "wait_ready", "settle": 2.0},
   {"op": "title"},
   {"op": "wait", "s": 1.5}
  ]},

  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "before frames"},
  {"op": "expand", "values": ["_p5_perf_flat", "_p5_perf_terraces", "_p5_perf_flat", "_p5_perf_terraces"], "template": [
   {"op": "play", "folder": "{value}"},
   {"op": "wait", "s": 2.0},
   {"op": "wait_ready", "settle": 2.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
   {"op": "vsync_off"},
   {"op": "home"},
   {"op": "wait", "s": 2.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "{value} home"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "{value} home"},
   {"op": "wait", "s": 8.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
   {"op": "zoom", "size": 20.0},
   {"op": "wait", "s": 2.5},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "info", "name": "{value} z20"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "start", "name": "{value} z20"},
   {"op": "wait", "s": 8.0},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "stop"},
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "mem", "name": "{value} play", "ws": true},
   {"op": "title"},
   {"op": "wait", "s": 1.5}
  ]},
  {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "gpu_state", "name": "play end"}
 ]
}
