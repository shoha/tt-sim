{
 "out_dir": "render_jobs/sound_check",
 "timeout_s": 180,
 "hang_s": 60,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "eval", "expr": "get_node(\"/root/LevelManager\").delete_level_folder(get_node(\"/root/LevelManager\").folder_path(\"_sound_check_\"))"},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 100, "seed": 4242},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 20.0},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "action": "listen"},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "label": "quiet before any edit"},
  {"op": "stroke", "mode": "paint", "biome": "temperate_forest_summer_s1", "points": [[-4, 6]], "radius": 4.0, "hold": 0.1},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "label": "biome dab (a tap)"},
  {"op": "stroke", "mode": "paint", "biome": "temperate_forest_summer_s1", "points": [[-5, 0], [5, 0]], "radius": 4.0, "speed": 4.0},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "label": "biome stroke 10 m"},
  {"op": "stroke", "mode": "surface", "surface": "dirt_road_packed", "points": [[-5, -6], [5, -6]], "radius": 4.0, "speed": 4.0},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "label": "paint stroke 10 m"},
  {"op": "eval", "expr": "_authoring_controller._on_place_selected(\"temperate_forest_summer_s1\", \"boulder\")"},
  {"op": "wait", "s": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "label": "Place tool picked"},
  {"op": "gesture", "points": [[10, 5]], "hold": 0.1},
  {"op": "wait", "s": 2.0},
  {"op": "eval", "expr": "_authoring_controller.history.undo_count()"},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "label": "place (a tap with the Place tool)"},
  {"op": "eval", "expr": "_authoring_controller.undo()"},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "label": "undo"},
  {"op": "eval", "expr": "_authoring_controller.redo()"},
  {"op": "wait", "s": 1.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "label": "redo"},
  {"op": "stroke", "mode": "water", "points": [[-6, 11], [6, 11]], "radius": 2.5, "speed": 4.0},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "label": "river 12 m"},
  {"op": "wait", "s": 2.0},
  {"op": "bridge_kind", "kind": "plank"},
  {"op": "wait", "s": 0.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "label": "river carved, Bridge tool picked"},
  {"op": "gesture", "points": [[0, 7], [0, 15]], "speed": 4.0},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "label": "bridge 8 m across the river"},
  {"op": "eval", "expr": "_authoring_controller.history.undo_count()"},
  {"op": "call", "script": "res://tools/render_jobs/probes/authoring_sound.gd", "action": "stop"},
  {"op": "capture", "name": "sound_check_end", "desc": "Authoring, zoom 20, after the job's edits: a forest dab, a forest stroke across the middle, a dirt road stroke, a boulder placed east (undone and redone), a river along z 11 and a plank bridge across it"},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "eval", "expr": "get_node(\"/root/LevelManager\").delete_level_folder(get_node(\"/root/LevelManager\").folder_path(\"_sound_check_\"))"},
  {"op": "index", "title": "Authoring sounds in the running game", "intro": "Produced by tools/render_jobs/jobs/sound_check.json (card brushland-sound). A new 100 ft meadow (seed 4242) in authoring, never saved: a Biome dab and a 10 m Biome stroke, a 10 m Paint stroke, a Place tap, undo and redo, a 12 m River and an 8 m plank Bridge across it. probes/authoring_sound.gd logs every sound AudioManager plays (name and take), every request and the SFX bus's peak per step. The _sound_check_ level is deleted at the start and the end in case a run ever saved one."},
  {"op": "wait", "s": 0.5}
 ]
}
