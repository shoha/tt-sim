{
 "out_dir": "render_jobs/building_ui",
 "timeout_s": 300,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [1200, 540]},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 16.0},
  {"op": "wait", "s": 1.5},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"structure\")"},
  {"op": "wait", "s": 1.0},
  {"op": "capture", "name": "01_palette", "desc": "The Building pane: short hint, search and Mix afresh on one row, cottages first, family captions with counts"},
  {"op": "eval", "expr": "_authoring_controller.panel.find_child(\"StructureSearch\", true, false).set_text(\"ruin\")"},
  {"op": "eval", "expr": "_authoring_controller.panel.find_child(\"StructureSearch\", true, false).text_changed.emit(\"ruin\")"},
  {"op": "wait", "s": 0.6},
  {"op": "capture", "name": "02_search", "desc": "The search 'ruin' leaves the Ruin family"},
  {"op": "eval", "expr": "_authoring_controller.panel.find_child(\"StructureSearch\", true, false).set_text(\"zzzz\")"},
  {"op": "eval", "expr": "_authoring_controller.panel.find_child(\"StructureSearch\", true, false).text_changed.emit(\"zzzz\")"},
  {"op": "wait", "s": 0.6},
  {"op": "capture", "name": "03_no_match", "desc": "A search nothing matches says so and keeps the search box"},
  {"op": "eval", "expr": "_authoring_controller.panel.find_child(\"StructureSearch\", true, false).set_text(\"\")"},
  {"op": "eval", "expr": "_authoring_controller.panel.find_child(\"StructureSearch\", true, false).text_changed.emit(\"\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "lay", "ref": "core:cottage", "at": [0, 0], "size": [6, 4]},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "flush"},
  {"op": "wait", "s": 2.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "bar", "press": "done"},
  {"op": "input", "events": [{"type": "move", "at": [0, 0]}]},
  {"op": "wait", "s": 0.4},
  {"op": "input", "events": [{"type": "press", "at": [0, 0]}, {"type": "release", "at": [0, 0]}]},
  {"op": "wait", "s": 0.8},
  {"op": "call", "script": "res://tools/render_jobs/probes/structure_select.gd", "action": "report"},
  {"op": "capture", "name": "04_selected", "desc": "A click selected the cottage: heading, style tiles, steppers, then the buttons in pairs"}
 ]
}
