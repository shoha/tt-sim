{
 "out_dir": "render_jobs/streetseam_base_wild",
 "timeout_s": 900,
 "hang_s": 120,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_camera_ss_wild", "load": "play"},
  {"op": "call", "script": "res://tools/render_jobs/probes/landform.gd", "action": "new", "biome": "temperate_forest_summer_s1", "size": 150, "seed": 3, "landform": "valley", "phase": "build"},
  {"op": "wait_ready", "settle": 1.5, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_camera_ss_wild", "replace": true, "phase": "build"},
  {"op": "play", "folder": "_camera_ss_wild", "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 26.0},
  {"op": "settle"},
  {"op": "capture", "name": "sw_home", "desc": "home view, size 26"},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "turn", "dir": 1},
  {"op": "settle"},
  {"op": "capture", "name": "sw_snap", "desc": "one eased snap turn"},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": 45},
  {"op": "settle"},
  {"op": "capture", "name": "sw_p45", "desc": "tilt to 45"},
  {"op": "call", "script": "res://tools/render_jobs/probes/camera_rig.gd", "action": "pitch", "deg": 90},
  {"op": "settle"},
  {"op": "capture", "name": "sw_p90", "desc": "top-down"},
  {"op": "home"},
  {"op": "settle"},
  {"op": "capture", "name": "sw_reset", "desc": "after the Home reset"},
  {"op": "zoom", "size": 8.0},
  {"op": "settle"},
  {"op": "capture", "name": "sw_close", "desc": "zoomed in to size 8"},
  {"op": "wind", "freeze": false},
  {"op": "wait", "s": 0.5}
 ]
}
