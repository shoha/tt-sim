{
 "out_dir": "render_jobs/villages4_look",
 "timeout_s": 600,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 250, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "market_town", "wealth": 0.7, "density": 1.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "plaza", "id": 1, "at": [31, 4], "radius": 6.5},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"village\")"},
  {"op": "zoom", "size": 20.0},
  {"op": "look_at", "at": [28, 6]},
  {"op": "settle"},
  {"op": "input", "events": [{"type": "move", "at": {"piece": "market_stall", "as": "stall"}}]},
  {"op": "settle"},
  {"op": "capture", "name": "a_hover_stall", "desc": "pointer over a market stall: chalk ring on the stall, the plaza ring faded, the pill and the hint bar chips (Drag Move piece, Q E Turn piece, R Re-roll, Del Remove)"},
  {"op": "input", "events": [{"type": "move", "at": {"piece": "market_stall", "as": "stall"}}, {"type": "press", "at": {"piece": "market_stall", "as": "stall"}}, {"type": "release", "at": {"piece": "market_stall", "as": "stall"}}]},
  {"op": "settle"},
  {"op": "capture", "name": "b_picked_stall", "desc": "clicked: gold ring, pane titled Market stall with Swap and Remove"},
  {"op": "input", "events": [{"type": "key", "key": "q", "pressed": true}, {"type": "key", "key": "q", "pressed": false}, {"type": "key", "key": "q", "pressed": true}, {"type": "key", "key": "q", "pressed": false}, {"type": "key", "key": "q", "pressed": true}, {"type": "key", "key": "q", "pressed": false}]},
  {"op": "settle"},
  {"op": "capture", "name": "c_turned_stall", "desc": "Q three times over the picked stall: turned 45 degrees, pinned (the pane offers Back to its spot)"},
  {"op": "input", "events": [{"type": "press_button", "name": "FurnishSwap"}]},
  {"op": "settle"},
  {"op": "capture", "name": "d_swapped", "desc": "the pane's Swap button pressed: the stall is now another prop of a plaza's edge"},
  {"op": "input", "events": [{"type": "move", "at": {"piece": "market_stall", "as": "stall"}}, {"type": "press", "at": {"piece": "market_stall", "as": "stall"}}, {"type": "move", "at": [29.5, 10.5]}, {"type": "move", "at": [31, 11.5]}, {"type": "move", "at": [33, 12.5]}, {"type": "move", "at": [33, 12.5]}]},
  {"op": "settle"},
  {"op": "capture", "name": "e_carry_ghost", "desc": "dragging it to open ground: a translucent copy of the piece at the pointer, gold ring, the place it left a calm ring, pill Release to put it here"},
  {"op": "input", "events": [{"type": "release", "at": [33, 12.5]}]},
  {"op": "settle"},
  {"op": "capture", "name": "f_dropped", "desc": "released: the piece stands where it was put"},
  {"op": "input", "events": [{"type": "move", "at": {"piece": "bench", "as": "bench"}}, {"type": "press", "at": {"piece": "bench", "as": "bench"}}, {"type": "move", "at": [26, 6]}, {"type": "move", "at": [23, 6]}, {"type": "move", "at": [21, 6]}, {"type": "move", "at": [21, 6]}]},
  {"op": "settle"},
  {"op": "capture", "name": "g_refused", "desc": "dragging a bench over a house: the ring in the refusal pink, the cross at the pointer, the ghost faint, the pill says why"},
  {"op": "input", "events": [{"type": "release", "at": [21, 6]}]},
  {"op": "settle"},
  {"op": "capture", "name": "h_after_refusal", "desc": "the frame after the refused release: nothing moved, the toast tells why"},
  {"op": "input", "events": [{"type": "move", "at": {"piece": "bench", "as": "bench"}}, {"type": "key", "key": "q", "pressed": true}, {"type": "key", "key": "q", "pressed": false}]},
  {"op": "wait", "s": 7.0},
  {"op": "capture", "name": "i_toast_cleared", "desc": "seven seconds and a successful turn later: the refusal toast has cleared"},
  {"op": "input", "events": [{"type": "move", "at": {"piece": "lamp_post", "as": "lamp"}}]},
  {"op": "settle"},
  {"op": "capture", "name": "j_hover_lamp", "desc": "pointer over a lamp post"},
  {"op": "input", "events": [{"type": "move", "at": {"piece": "barrel", "as": "barrel"}}, {"type": "key", "key": "delete", "pressed": true}, {"type": "key", "key": "delete", "pressed": false}]},
  {"op": "settle"},
  {"op": "capture", "name": "k_removed", "desc": "Delete over a barrel: it is gone and the pane offers Put back 1 removed piece"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1280, 720]},
  {"op": "settle"},
  {"op": "input", "events": [{"type": "move", "at": {"piece": "bench", "as": "bench"}}, {"type": "move", "at": {"piece": "bench", "as": "bench"}}, {"type": "press", "at": {"piece": "bench", "as": "bench"}}, {"type": "release", "at": {"piece": "bench", "as": "bench"}}]},
  {"op": "settle"},
  {"op": "capture", "name": "l_720_piece_pane", "desc": "1280x720: a picked piece, the piece box with Swap, Remove and the Put back button, whole pane in view"},
  {"op": "index", "title": "villages4 look", "intro": "Touchable furnishings in the Village tool"}
 ]
}
