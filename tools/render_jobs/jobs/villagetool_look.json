{
 "out_dir": "render_jobs/villagetool_look",
 "timeout_s": 600,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 250, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [18, -26], "to": [18, 26], "preset": 2, "seed": 31},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.3, "density": 0.9},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 2, "kit": "market_town", "wealth": 0.7, "density": 1.0},
  {"op": "look_at", "at": [0, 6]},
  {"op": "zoom", "size": 60.0},
  {"op": "settle"},
  {"op": "capture", "name": "a_two_streets", "desc": "two dressed streets, Wall tool, home zoom"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"village\")"},
  {"op": "settle"},
  {"op": "capture", "name": "b_village_tool", "desc": "the Village tool picked: its pane before any plaza"},
  {"op": "zoom", "size": 20.0},
  {"op": "settle"},
  {"op": "look_at", "at": [18, 28]},
  {"op": "settle"},
  {"op": "input", "events": [{"type": "move", "at": [18, 34]}]},
  {"op": "settle"},
  {"op": "capture", "name": "c_ghost", "desc": "pointer over bare ground past the market street: the ghost plaza and its hint"},
  {"op": "gesture", "points": [[18, 32], [20.5, 32], [23, 32]], "speed": 3.0},
  {"op": "settle"},
  {"op": "capture", "name": "d_market_plaza", "desc": "a drag opened a plaza of 5 m: paved, furnished, picked, its size in the pane"},
  {"op": "look_at", "at": [-18, 28]},
  {"op": "settle"},
  {"op": "gesture", "points": [[-18, 32], [-18, 32]]},
  {"op": "settle"},
  {"op": "capture", "name": "e_hamlet_click", "desc": "a click opened the default plaza for the hamlet"},
  {"op": "look_at", "at": [18, 28]},
  {"op": "settle"},
  {"op": "input", "events": [{"type": "move", "at": [23, 32]}]},
  {"op": "settle"},
  {"op": "capture", "name": "f_rim_hover", "desc": "pointer on the market plaza's rim: the ring brightens, handles show, hint says drag"},
  {"op": "gesture", "points": [[23, 32], [25, 32], [27, 32]], "speed": 3.0, "release": false},
  {"op": "capture", "name": "g_resize_drag", "desc": "dragging the rim out: the preview ring and the width readout, nothing repaved yet"},
  {"op": "gesture", "points": [[27, 32]], "press": false},
  {"op": "settle"},
  {"op": "capture", "name": "h_resized", "desc": "released: the plaza is 9 m, repaved, furnished again"},
  {"op": "eval", "expr": "_authoring_controller.panel.tool_pane(\"village\").kit_field.tiles.get_node(\"village_kit_harbour_town\").set_pressed(true)"},
  {"op": "settle"},
  {"op": "capture", "name": "i_kit_harbour", "desc": "the market village switched to Harbour town: road, doors, plaza and furnishings follow"},
  {"op": "zoom", "size": 60.0},
  {"op": "settle"},
  {"op": "look_at", "at": [0, 8]},
  {"op": "settle"},
  {"op": "capture", "name": "j_home", "desc": "both villages with their plazas at home zoom"},
  {"op": "call", "script": "res://tools/render_jobs/probes/ui_primitives.gd", "action": "window", "size": [1600, 900]},
  {"op": "settle"},
  {"op": "zoom", "size": 20.0},
  {"op": "settle"},
  {"op": "look_at", "at": [18, 28]},
  {"op": "settle"},
  {"op": "capture", "name": "k_1600_plaza", "desc": "1600x900: the harbour village's plaza and the pane"},
  {"op": "zoom", "size": 60.0},
  {"op": "settle"},
  {"op": "look_at", "at": [0, 8]},
  {"op": "settle"},
  {"op": "capture", "name": "l_1600_home", "desc": "1600x900: home zoom"},
  {"op": "index", "title": "villagetool look", "intro": "Village tool: plaza gestures, kit pick, pane"}
 ]
}
