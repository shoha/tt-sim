{
 "out_dir": "render_jobs/rosterbeasts_look",
 "timeout_s": 600,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar_token.gd", "action": "save", "folder": "_avatartoken_rosterbeasts", "replace": true},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "play", "folder": "_avatartoken_rosterbeasts"},
  {"op": "wait", "s": 3.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/rosterfolk.gd", "action": "row", "pack": "beasts", "at": [-8.0, -4.0], "spacing": 3.2, "per_row": 6, "row_gap": 3.2},
  {"op": "wait", "s": 3.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/rosterbeasts.gd", "action": "idle"},
  {"op": "wait", "s": 1.2},
  {"op": "call", "script": "res://tools/render_jobs/probes/rosterbeasts.gd", "action": "idle"},
  {"op": "wait", "s": 4.5},
  {"op": "call", "script": "res://tools/render_jobs/probes/rosterbeasts.gd", "action": "idle"},
  {"op": "home"},
  {"op": "look_at", "at": [0.0, -1.0]},
  {"op": "settle"},
  {"op": "capture", "name": "home", "desc": "Home zoom: the 17 beasts and farm animals in three rows on the meadow, true relative sizes"},
  {"op": "zoom", "size": 5.0},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "look", "at": [-5.0, -4.0], "height": 0.8},
  {"op": "settle"},
  {"op": "capture", "name": "close_front", "desc": "Close zoom (5 m view height): the front row, horse, white horse, donkey"},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "look", "at": [-5.0, -0.8], "height": 0.8},
  {"op": "settle"},
  {"op": "capture", "name": "close_middle", "desc": "Close zoom: the middle row, deer and the dogs side"},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "look", "at": [-5.0, 2.4], "height": 0.8},
  {"op": "settle"},
  {"op": "capture", "name": "close_back", "desc": "Close zoom: the back row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar_token.gd", "action": "cleanup"},
  {"op": "title"},
  {"op": "index", "title": "rosterbeasts_look", "intro": "Beasts and Farm Animals token pack look"}
 ]
}
