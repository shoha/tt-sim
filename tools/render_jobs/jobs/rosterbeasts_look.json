{
 "out_dir": "render_jobs/rosterbeasts_look",
 "timeout_s": 600,
 "hang_s": 90,
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "new_map", "biome": "grassland_meadow_summer_s1", "size": 150, "seed": 1234},
  {"op": "wait_ready", "settle": 1.0},
  {"op": "no_autosave"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "wind", "freeze": true},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar_token.gd", "action": "save", "folder": "_avatartoken_rosterbeasts", "replace": true},
  {"op": "title"},
  {"op": "wait", "s": 1.0},
  {"op": "play", "folder": "_avatartoken_rosterbeasts"},
  {"op": "wait", "s": 3.0},
  {"op": "wait_ready", "settle": 2.0},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "call", "script": "res://tools/render_jobs/probes/rosterfolk.gd", "action": "row", "pack": "beasts", "at": [-4.5, -1.5], "spacing": 2.2, "per_row": 4, "row_gap": 2.6},
  {"op": "wait", "s": 3.0},
  {"op": "call", "script": "res://tools/render_jobs/probes/rosterfolk.gd", "action": "report"},
  {"op": "home"},
  {"op": "look_at", "at": [-1.5, -0.3]},
  {"op": "settle"},
  {"op": "capture", "name": "home", "desc": "Home zoom: the beasts and farm animals in rows on the meadow, true relative sizes"},
  {"op": "zoom", "size": 5.0},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "look", "at": [-2.4, -1.5], "height": 0.8},
  {"op": "settle"},
  {"op": "capture", "name": "close_front", "desc": "Close zoom (5 m view height): the front row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/token_ghost.gd", "action": "look", "at": [-2.4, 1.1], "height": 0.8},
  {"op": "settle"},
  {"op": "capture", "name": "close_back", "desc": "Close zoom: the back row"},
  {"op": "call", "script": "res://tools/render_jobs/probes/avatar_token.gd", "action": "cleanup"},
  {"op": "title"},
  {"op": "index", "title": "rosterbeasts_look", "intro": "Beasts and Farm Animals token pack look"}
 ]
}
