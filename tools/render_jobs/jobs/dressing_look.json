{
  "out_dir": "render_jobs/dressing_look",
  "timeout_s": 900,
  "steps": [
    {"op": "expand_biomes", "biomes": ["temperate_forest_summer_s1", "alpine_meadow_summer_s1", "rocky_badlands_summer_s1"], "template": [
      {"op": "title"},
      {"op": "wait", "s": 1.0},
      {"op": "new_map", "biome": "{biome}", "size": 200, "seed": 1234},
      {"op": "wait_ready", "settle": 1.0},
      {"op": "no_autosave"},
      {"op": "hide_ui"},
      {"op": "call", "script": "res://tools/render_jobs/probes/terrain_shapes.gd", "action": "plateau", "at": [-6, -3], "size": [10, 8], "tiers": 2, "inset": 2.2, "lip": 0.25, "lip_width": 0.9},
      {"op": "call", "script": "res://tools/render_jobs/probes/terrain_shapes.gd", "action": "hill", "at": [9, -1], "height": 6.0, "radius": 7.0},
      {"op": "call", "script": "res://tools/render_jobs/probes/terrain_shapes.gd", "action": "hollow", "at": [0, 9], "radius": 3.5, "depth": 1.524},
      {"op": "wait_ready", "settle": 1.0},
      {"op": "call", "script": "res://tools/render_jobs/probes/terrain_shapes.gd", "action": "stats", "area": [-12, -8, 16, 13]},
      {"op": "home"},
      {"op": "wait", "s": 1.5},
      {"op": "capture", "name": "{biome}_1_home", "desc": "{name}: plateau (1 and 2 tiers, sharp faces, west), 6 m hill (east), sunken hollow (south); no painting; game camera home"},
      {"op": "look_at", "at": [-6, -3]},
      {"op": "zoom", "size": 7.0},
      {"op": "wait", "s": 1.5},
      {"op": "capture", "name": "{biome}_2_plateau", "desc": "{name}: the plateau at zoom 7"},
      {"op": "look_at", "at": [9, -1]},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_3_hill", "desc": "{name}: the 6 m hill at zoom 7"},
      {"op": "look_at", "at": [0, 8]},
      {"op": "wait", "s": 1.0},
      {"op": "capture", "name": "{biome}_4_hollow", "desc": "{name}: the sunken hollow at zoom 7"},
      {"op": "call", "script": "res://tools/render_jobs/probes/terrain_shapes.gd", "action": "path", "surface": "cobblestone", "points": [[-17, 10], [-9, 3], [-5, -2], [1, -5], [4, -12]], "width": 2.0, "soft": 0.6},
      {"op": "call", "script": "res://tools/render_jobs/probes/terrain_shapes.gd", "action": "area", "surface": "flagstone", "rect": [-3.5, -4, 3.5, 2], "soft": 0.5},
      {"op": "wait_ready", "settle": 1.0},
      {"op": "home"},
      {"op": "wait", "s": 1.5},
      {"op": "capture", "name": "{biome}_5_painted_home", "desc": "{name}: a cobblestone path over the plateau and a flagstone courtyard across its east face, game camera home"},
      {"op": "look_at", "at": [-4, -1]},
      {"op": "zoom", "size": 7.0},
      {"op": "wait", "s": 1.5},
      {"op": "capture", "name": "{biome}_6_painted_plateau", "desc": "{name}: path and courtyard over the automatic rock, zoom 7"}
    ]},
    {"op": "index", "title": "Automatic dressing (P3-4)", "intro": "New 200 ft maps (seed 1234) in three biomes, shaped by writing heights (terrain_shapes.gd), then painted surfaces written into the document."},
    {"op": "title"}
  ]
}
