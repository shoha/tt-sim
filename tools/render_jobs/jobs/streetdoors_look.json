{
 "out_dir": "render_jobs/streetdoors_look",
 "timeout_s": 900,
 "hang_s": 150,
 "saved": {"folder": "_camera_sd_street", "load": "play"},
 "steps": [
  {"op": "wait", "s": 1.0},
  {"op": "saved", "folder": "_camera_sd_street", "load": "play"},
  {"op": "new_map", "biome": "temperate_forest_summer_s1", "size": 250, "seed": 1234, "phase": "build"},
  {"op": "wait_ready", "settle": 1.0, "phase": "build"},
  {"op": "no_autosave", "phase": "build"},
  {"op": "eval", "expr": "_authoring_controller.panel._on_rail_item_pressed(\"wall\")", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/walls.gd", "action": "kind", "kind": "row", "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "street", "from": [-18, -26], "to": [-18, 26], "preset": 3, "seed": 21, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/settlements.gd", "action": "dress", "id": 1, "kit": "farming_hamlet", "wealth": 0.4, "density": 1.2, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/water.gd", "action": "save", "folder": "_camera_sd_street", "replace": true, "phase": "build"},
  {"op": "play", "folder": "_camera_sd_street", "phase": "build"},
  {"op": "wait_ready", "settle": 2.0, "phase": "build"},
  {"op": "call", "script": "res://tools/render_jobs/probes/env.gd", "mouse": [960, 540]},
  {"op": "hide_ui"},
  {"op": "wind", "freeze": true},
  {"op": "look_at", "at": [0, 0]},
  {"op": "zoom", "size": 26.0},
  {"op": "settle"},
  {"op": "capture", "name": "streetdoors_home", "desc": "orbit home view, the doors tiny"},
  {"op": "look_at", "at": [-18, -14]},
  {"op": "zoom", "size": 10.0},
  {"op": "settle"},
  {"op": "capture", "name": "streetdoors_orbit_close", "desc": "orbit view zoomed onto the street"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "enter", "at": [-18, -20], "yaw": 45, "pitch": 12, "fov": 60},
  {"op": "settle"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "skystate"},
  {"op": "capture", "name": "streetdoors_eye_y045", "desc": "eye, plank house door (yaw 45, pitch 12)"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 135, "pitch": 0}, {"op": "settle"}, {"op": "capture", "name": "streetdoors_eye_y135"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 225, "pitch": 0}, {"op": "settle"}, {"op": "capture", "name": "streetdoors_eye_y225", "desc": "eye, stone cottage"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "pose", "yaw": 315, "pitch": 0}, {"op": "settle"}, {"op": "capture", "name": "streetdoors_eye_y315", "desc": "eye, stone wall with a red door"},
  {"op": "call", "script": "res://tools/render_jobs/probes/eye_view.gd", "action": "leave"},
  {"op": "wind", "freeze": false},
  {"op": "title"},
  {"op": "wait", "s": 0.5}
 ]
}
