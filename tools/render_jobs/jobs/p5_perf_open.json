   {"op": "title"},
   {"op": "wait", "s": 1.5}
  ]},

  {"op": "expand", "values": ["flat", "valley", "gorge"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "author", "biome": "temperate_forest_summer_s1", "size": 100, "seed": 7, "landform": "{value}"},
