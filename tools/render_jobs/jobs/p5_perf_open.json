   {"op": "wait", "s": 1.0}
  ]},
  {"op": "expand", "values": ["flat", "valley", "gorge"], "template": [
   {"op": "call", "script": "res://tools/render_jobs/probes/perf.gd", "action": "author", "biome": "temperate_forest_summer_s1", "size": 200, "seed": 7, "landform": "{value}"},
