{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(godot *)",
      "Bash(gdformat *)",
      "Bash(gdlint *)",
      "PowerShell(Get-Process blender*, godot* -ErrorAction SilentlyContinue)",
      "mcp__tt-sim-validator__game_stop",
      "mcp__tt-sim-validator__game_state",
      "mcp__tt-sim-validator__game_screenshot",
      "mcp__tt-sim-validator__game_controls",
      "Task",
      "WebFetch",
      "WebSearch"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "subagentPromptCacheTtl": "1h",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(godot *)",
            "command": "bash /d/dev/tt-sim/.claude/hooks/godot_output.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.gd) gdformat \"$f\" ;; esac; } 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"git -C /d/dev/tt-sim worktree prune 2>/dev/null; for dir in /d/dev/tt-sim/.worktrees/*/; do [ -d \\\"$dir\\\" ] && ! git -C /d/dev/tt-sim worktree list --porcelain | grep -qF \\\"${dir%/}\\\" && rm -rf \\\"$dir\\\"; done 2>/dev/null; rmdir /d/dev/tt-sim/.worktrees 2>/dev/null; true\"",
            "async": true
          }
        ]
      }
    ]
  }
}
