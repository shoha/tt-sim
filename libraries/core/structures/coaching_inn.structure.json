      "type": "float"
    },
    {
      "default": 1,
      "label": "Textured masonry",
      "max": 1,
      "min": 0,
      "name": "textured",
      "tip": "1 carries the courses in a masonry texture instead of modelled blocks.",
      "type": "float"
    },
    {
      "default": 3.35,
      "label": "Wing depth",
      "max": 4,
      "min": 2.5,
      "name": "wing_depth",
      "tip": "How deep the wings are, wall to wall; the yard is what remains.",
      "type": "float"
    },
    {
      "default": 1,
      "label": "Chimneys",
      "max": 4,
      "min": 0,
      "name": "chimneys",
      "tip": "How many chimney stacks rise through each wing's roof.",
      "type": "float"
    },
    {
      "default": 0,
      "label": "Lit windows",
      "max": 1,
      "min": 0,
      "name": "lit",
      "tip": "The share of windows that glow warm, as if lit from within.",
      "type": "float"
    },
    {
      "default": 0.55,
      "label": "Wonk",
      "max": 1,
      "min": 0,
      "name": "wonk",
      "tip": "How hand-made the building looks: sagging roof, uneven tops, leaning walls.",
      "type": "float"
    },
    {
      "default": 0,
      "label": "Ragged eave",
      "max": 0.6,
      "min": 0,
      "name": "fringe",
      "tip": "How far pointed teeth reach down past the eaves, as thatch does; 0 for a clean edge.",
      "type": "float"
    }
