/* core.sheet: the painted look's tones for the core library (painter/sheet.gd reads it; the
   format and the rules are in docs/systems/painter.md).

   Started from the painter spike's glade_ttsim.sheet (branch painterspike): its summer, dusk,
   grimdark, winter and autumn colours, each tuned there for ONE sun the sheet chose. Here the
   level's sun chooses (time of day or the manual sun), so a mood holds keyframes by sun
   elevation in degrees and the resolver blends between them in OKLCH:
     high   a midday sun (a dusk or winter mood's own sun is lower: its `high` is where it was tuned)
     low    the sun near the horizon (golden hour)
     night  the sun below the horizon (moonlight; the level's sun still sets the direction)

   Roles: sun, sky (the zenith), horizon, ambient, haze (fog and far colour) light the scene;
   ground, leaf, bark, stone, path and the five roofs are the tones the painted surfaces and later
   cards paint with. Numbers: sun-energy and ambient-energy (the linear tonemap shows them as
   written).

   Defaults (painter/sheet.gd DEFAULT_ROLES, DEFAULT_NUMBERS): a declaration without `--` in a
   `:world` block is the default for every keyframe below it that does not set that name. The
   sheet's :world holds the summer day's; a mood's :world or a keyframe overrides it. */

:world {
  --meadow: oklch(0.70 0.150 138);
  --leaf: oklch(0.67 0.165 138);
  --bark: oklch(0.52 0.075 55);
  --stone: oklch(0.70 0.030 80);
  --path: oklch(0.80 0.060 80);
  --terracotta: oklch(0.55 0.135 33);
  --thatch: oklch(0.71 0.085 84);

  /* The ground's other tones and the plants' accents (the spike's last summer values). */
  floor: oklch(0.60 0.085 112);  shore: oklch(0.80 0.050 85);  grass: oklch(0.67 0.135 136);
  drift: oklch(0.86 0.100 112);  litter: oklch(0.70 0.070 100);
  flower-gold: oklch(0.84 0.150 90);  flower-rose: oklch(0.70 0.140 15);
  flower-violet: oklch(0.62 0.120 300);  flower-white: oklch(0.94 0.030 105);
  /* A poppy's scarlet and a bluebell's cornflower (painter-flowers: each flower's blooms take the
     accent its own colour sorts into). */
  flower-red: oklch(0.62 0.190 33);  flower-blue: oklch(0.66 0.130 262);
  /* The conifers' needles (the painted trees: each species keeps its own needle colour, moved as
     this one moves from the summer midday's). */
  needle: oklch(0.40 0.075 176);

  /* The tone ramp (PainterTones.ramp): a role's shade is its lightness times shade-depth with
     shade-keep of its chroma, pulled toward shade-hue by shade-pull; its lit colour is lit-lift
     lighter with its hue pulled toward lit-hue by lit-pull; its two variants sit hue-spread
     degrees and value-spread of lightness either side. The ground takes its own depth, keep,
     pull, lift and spread, the grass its own keep, lit pull and lift. */
  shade-hue: 285;  shade-pull: 0.9;  shade-depth: 0.66;  shade-keep: 1;
  lit-hue: 95;  lit-pull: 0.45;  lit-lift: 0.2;  hue-spread: 12;  value-spread: 0.035;
  ground-shade-pull: 0.9;  ground-shade-depth: 0.69;  ground-shade-keep: 1;
  ground-lit-pull: 0.45;  ground-lit-lift: 0.12;
  grass-shade-keep: 1;  grass-lit-pull: 0.45;  grass-lit-lift: 0.2;
  grass-hue-spread: 12;  grass-value-spread: 0.035;
  ground-hue-spread: 14;  ground-value-spread: 0.04;

  /* The plants: the N.L where the shade, middle and lit steps meet; grass kept at 60 % and
     flowers at 80 % in groups of a slow world noise (1/m; painter-flowers: at 40 % a flowery
     meadow read empty), a drift of blooms stepped lighter or darker by a slower one. */
  tone-lo: -0.08;  tone-hi: 0.48;
  keep-grass: 0.6;  keep-flower: 0.8;  keep-freq-grass: 0.12;  keep-freq-flower: 0.15;
  flower-mix: 0.09;

  /* The ground's brush marks: the share of cells that hold one at a zone's edge and how far a
     flat area thins them, the small drift and fallen-leaf marks, the block-in's patches, the
     pixel footprint (m) between which a mark fades out, the cast shadow step's wiggle. */
  marks: 0.4;  mark-thin: 0.25;  drift-marks: 0.3;  litter-marks: 0.3;  patches: 1;
  mark-px-lo: 0.07;  mark-px-hi: 0.14;  cut: 0.1;

  /* Grounding (PainterOcclusion, cards painter-grounding and painter-tree-ground): the share the
     SHADED ground goes a step deeper under a crown or a house (occ-pool; sunlit ground takes none,
     so the pool never contradicts the sun: it deepens each shadow at its root) and the share at a
     trunk's, rock's or wall's foot (occ-core, lighter in the sun), that shade's value (occ-dark),
     the share of the foot's seam that turns to the litter's soil tone (occ-soil), how far the
     deeper shade leans cool and green (occ-cool), and a trunk's or rock's own step darker at its
     foot (base-dark). */
  occ-pool: 0.85;  occ-core: 0.8;  occ-dark: 0.9;  occ-soil: 0.5;  occ-cool: 0.05;  occ-shade: 0.2;  base-dark: 0.28;

  /* The painted trees (PainterTreeTones): a crown's shade leans teal and keeps most of its own
     green (the prototype's S18; the spike's pull toward violet cancelled a green to grey), a
     stem's shade is its own brown, nearly unpulled and bark-shade-lift less deep than a role's
     (painter-a2a4: a 0.2 pull still read red-maroon and the full depth dark chocolate beside
     Classic's mid brown stems); a crown's lit step leans a little toward the light's hue (a full
     lean read as mustard); tree-cast is how far the sun's cast shadow steps a tree into its
     cool tint. */
  crown-shade-hue: 210;  crown-shade-pull: 0.8;  crown-shade-keep: 0.7;  crown-lit-pull: 0.2;
  bark-shade-pull: 0.04;  bark-shade-keep: 0.9;  bark-shade-lift: 0.1;  tree-cast: 0.7;
  /* A crown's lit step a little lighter and richer where a mood's light colours it (a low sun
     gilds the lit side, toward the light's hue by crown-lit-pull), its shade a little less deep
     in a dark mood, and frost on its up side in winter (crown-deposit, the share it may take). */
  crown-lit-lift: 0;  crown-lit-chroma: 1;  crown-shade-lift: 0;  crown-deposit: 0;
  /* A broadleaf in leaf keeps every leaf clump (leaf-keep 1); a bare season keeps a share, each
     species falling by its own `fall` (tree_roles.json), and its kept leaves turn toward the dry
     leaf by leaf-turn. A conifer's boughs carry needle-snow times their snow. A dry leaf is thin
     and lit through: its shade keeps dry-shade-lift more of its lightness, dry-shade-keep of its
     own chroma and takes dry-shade-pull toward the crowns' shade hue (the crown's keep and pull
     greyed it to mauve). */
  leaf-keep: 1;  leaf-turn: 0;  dry-shade-lift: 0;  needle-snow: 1;  dry-leaf: oklch(0.60 0.100 58);
  dry-shade-keep: 1;  dry-shade-pull: 0.3;
  /* A bush is the leaf a step deeper and quieter, on a crown's ramp, so it sits under the oaks
     rather than glowing lime beside them (painter-trees-polish2). */
  bush-value: 0.99;  bush-chroma: 0.95;

  /* The buildings (PainterBuildings; the spike's route A cottages, spike_built3): a cream lime
     wash, a pale warm stone, honey logs and boards, dark honey beams; the roofs are the five roof
     roles. Each mood sets its day colours in its :world and its night ones in its night key.
     The ramp numbers are relative to the mood's: a wall's shade turns 11 degrees bluer than the
     mood's (the spike's 274 under summer's 285: a blue lavender, not a mauve) and is a little
     less deep, so a shaded lime wash stays a light colour; timber's shade turns away from the
     violet and is barely pulled (a brown pulled toward it went through red to maroon in the
     spike's eave bands; painter-a2a4's stems: its own brown a step darker reads best); every
     building role takes 60 % of the mood's lit lift and lit pull (the full lift took plaster
     to white; the pull is a chroma vector for buildings, so a blue slate opposite the yellow
     lit hue greys a little instead of turning teal or pink).
     Stone and roofs take less pull than a lime wash (painter-a3b round 1: the same pull on a
     darker grey stone read as a periwinkle slab, on slate as lavender). A lime wash keeps most
     of its own warm hue in shade (painter-manner-b: a 1.2 pull read lavender over a whole
     facade; 0.3 leaves a warm grey cream, the prototype's shaded walls). Roofs carry no snow
     but in winter (roof-snow, how deep it lies, in the drift role's white under the ground's
     ramp numbers; above 0 the hand-drawn buildings also get snow lips, caps and pads). */
  plaster: oklch(0.89 0.045 88);  wall-stone: oklch(0.80 0.042 80);
  wall-log: oklch(0.60 0.080 58);  wall-boards: oklch(0.64 0.058 72);  timber: oklch(0.45 0.075 52);
  wall-shade-turn: -11;  wall-pull: 0.3;  stone-pull: 0.3;  wall-shade-lift: 0.13;
  roof-pull: 0.45;  roof-shade-lift: 0.03;  timber-shade-turn: -50;  timber-pull: 0.15;
  building-lit: 0.5;  roof-snow: 0;

  /* The dry biomes' tones, derived from the role each comes from (PainterGroundRoles.DERIVED:
     hue in degrees, a chroma factor, a lightness shift), so they follow every mood and sun: the
     savanna's straw from the ground and its tufts from the grass, a burnt forest's ash from the
     stone and the badlands' baked earth from the path (painter-coverage: all four biomes read as
     lush green meadow). */
  dry-hue: 88;  dry-chroma: 0.85;  dry-lift: 0.03;
  drygrass-hue: 92;  drygrass-chroma: 0.95;  drygrass-lift: 0.07;
  ash-hue: 48;  ash-chroma: 1.9;  ash-lift: -0.27;
  earth-hue: 52;  earth-chroma: 1.9;  earth-lift: -0.13;
  /* A cactus and an agave: the leaf turned to a blue green and a little deeper. */
  cactus-hue: 172;  cactus-chroma: 0.7;  cactus-lift: -0.08;
  /* A burnt forest's dead wood (snags, logs, stumps): the bark role turned nearly neutral and a
     step darker, so the standing trunks read as char against the ash ground. */
  charcoal-hue: 45;  charcoal-chroma: 0.45;  charcoal-lift: -0.2;
  /* A crossing's stone (stepping stones, the arch, the ford's slabs; PainterBuildings.crossing_tone):
     the wall stone a quarter deeper, a little quieter and turned a few degrees toward grey brown,
     so it parts from sand banks and water (painter-edges; the pale cream bleached against sand). */
  crossing-turn: -14;  crossing-chroma: 0.8;  crossing-value: 0.76;
  /* The ground's path surfaces and cliffs (PainterGroundPaths; painter-ground-surfaces): each path
     surface's tone is the path role moved toward its own measured colour by path-own, so cobble,
     flagstone, caliche and planks part (their patterns are the shader's). The cliff stone is the
     stone turned warmer and richer, its shade a lighter step that keeps its hue (a grey stone under
     the full ground pull read as dark violet smears on every terrace), a lit lip at a cliff's top
     edge and a darker foot, and soft strata bands on the faces. */
  path-own: 1;
  cliff-turn: -8;  cliff-chroma: 1.5;  cliff-lift: 0;  cliff-pull: 0.25;  cliff-shade-lift: 0.12;
  cliff-edge: 0.22;  cliff-strata: 1;
  /* The polish (painter-ground-polish): the lip a little gold, the foot two thirds and a lit face a
     third of the way to its shade colour, so a pale sandstone step reads against the orange badlands
     as lit top, middle face, dark foot (lip and foot alone left a cream band); no bare-rock pull, snow
     cap or path dust but in winter. */
  cliff-own: 0;  cliff-snow: 0;  cliff-foot: 0.65;  cliff-face: 0.35;  cliff-warm: 0.5;
  path-dust: 0;
  /* The meadow's broad swathes (PainterMeadowSwathes): about a fifth of a meadow gold and a sixth a
     deeper moss, Classic's patches as a few bold soft shapes in the ground's own tone (round 1 at
     -48 read ochre-orange in summer and salmon at dusk and in autumn; moss at -14 olive-khaki). */
  gold-share: 0.2;  gold-turn: -40;  gold-chroma: 1.05;  gold-lift: 0.06;
  moss-share: 0.17;  moss-turn: -6;  moss-chroma: 1.1;  moss-lift: -0.08;
  /* The village fields (PainterFields; painter-fields): the tilled soil is the path turned to a
     warm earth, richer and deeper; a crop is the grass moved to its plant's own colour (ripe wheat
     gold, a young crop fresh green), a step lighter and richer than the meadow, so a field reads
     as a field; winter lays snow over the rows and leaves the furrows dark. */
  soil-hue: 66;  soil-chroma: 1.25;  soil-lift: -0.19;
  crop-own: 1;  crop-lift: 0.03;  crop-chroma: 1.12;  field-snow: 0;

  /* The water (PainterWater, painter_water.gdshader; card painter-water): one luminous wash in
     three depth bands, shallows lightest and most turquoise, the deep the most saturated blue,
     never grey; the strokes laid on it a lighter sky-tinted value and a darker deep one; white
     for the lap line, the riffles and the wrap of foam; a gold glint; the winter ice. Each mood
     moves the bands (dusk toward lilac, winter to slate-teal), its night key to indigo. The
     numbers: the share of lattice cells that hold a stroke, a stroke's length (m), the boil's
     period (s), the sun's side that glints, the wash's deepest alpha, the lap ribbon's width (m),
     and how far still water freezes (winter's only). */
  water-shallow: oklch(0.86 0.090 190);  water-mid: oklch(0.72 0.110 215);
  water-deep: oklch(0.60 0.115 238);
  water-lit: oklch(0.90 0.060 215);  water-shade: oklch(0.50 0.100 250);
  water-foam: oklch(0.98 0.015 200);  water-glint: oklch(0.97 0.095 92);
  water-ice: oklch(0.93 0.030 235);
  water-strokes: 0.55;  water-stroke-len: 1.5;  water-boil: 3.2;  water-glints: 0.8;
  water-opacity: 0.92;  water-foam-width: 0.22;  ice-over: 0;
}

@mood summer {
  /* The richest mood: a warm white sun, cool blue shade, a deep meadow, blue haze. */
  @key high 60 {
    sun: oklch(0.98 0.022 92);  sun-energy: 1.05;
    sky: oklch(0.80 0.085 238);  horizon: oklch(0.93 0.040 215);
    ambient: oklch(0.90 0.045 222);  ambient-energy: 0.55;
    haze: oklch(0.91 0.030 228);
    leaf: var(--leaf);  bark: var(--bark);  stone: var(--stone);  path: var(--path);
    roof-clay: var(--terracotta);  roof-slate: oklch(0.50 0.040 255);  roof-shingle: oklch(0.50 0.060 45);
    roof-turf: oklch(0.58 0.100 135);  roof-thatch: var(--thatch);
    /* A high sun keeps the lawn a luminous mid green (the prototype's S18): the ground and the
       grass on it stay near their own hue and lift little, so a cast shadow still parts from
       them (painter-a1b read a 0.45 pull and a 0.12 to 0.2 lift as a pale cream field). */
    ground: var(--meadow);  grass: oklch(0.64 0.150 140);
    ground-lit-pull: 0.12;  ground-lit-lift: 0.05;  grass-lit-pull: 0.1;  grass-lit-lift: 0.06;
    /* A crown's shade stays a deep but luminous teal green, never near black (painter-look-crowns:
       a crown standing in another's shadow took the shade step, the cast tint and the painted
       cast tone at once and read as one flat dark mass). */
    crown-shade-lift: 0.07;  tree-cast: 0.58;
    /* The forest floor (the taiga's ground, the jungle's, a forest's under its crowns) a luminous
       moss green, not the olive-khaki the :world floor is (painter-look-taiga: it read dull and
       muddy; its own hue between the meadow's and a gold). */
    floor: oklch(0.67 0.130 130);
  }
  /* Golden hour. The sun goes gold, not red, and the shade stays a light blue-violet so walls
     facing away from it keep their own colour (the spike's cold front walls) and clay roofs do
     not swing to magenta under a pink fill. */
  @key low 6 {
    sun: oklch(0.90 0.095 70);  sun-energy: 1.0;
    sky: oklch(0.74 0.075 262);  horizon: oklch(0.88 0.075 68);
    ambient: oklch(0.86 0.035 255);  ambient-energy: 0.72;
    haze: oklch(0.86 0.055 62);
    ground: oklch(0.69 0.125 120);  leaf: oklch(0.63 0.145 130);  bark: oklch(0.50 0.075 50);
    stone: oklch(0.69 0.040 68);  path: oklch(0.80 0.070 70);
    roof-clay: oklch(0.56 0.130 38);  roof-slate: oklch(0.51 0.040 262);  roof-shingle: oklch(0.52 0.065 48);
    roof-turf: oklch(0.57 0.100 125);  roof-thatch: oklch(0.72 0.090 78);
    floor: oklch(0.63 0.115 112);  grass: oklch(0.64 0.125 126);  drift: oklch(0.84 0.100 95);
    lit-hue: 70;  lit-pull: 0.55;
    /* The lawn and its grass stay gold-green in the low light (grass is lit like the ground since
       painter-a1c, so its lit step shows at every sun): a small lift and pull, not cream. */
    ground-lit-pull: 0.2;  ground-lit-lift: 0.06;  grass-lit-pull: 0.2;  grass-lit-lift: 0.06;
    /* Near the horizon most of a crown lies in another's cast shadow: a lighter step. The lit
       side of a crown turns gold with the light, lighter and richer, not a muddy olive. */
    tree-cast: 0.45;  crown-lit-pull: 0.3;  crown-lit-lift: 0.05;  crown-lit-chroma: 1.05;
    crown-shade-lift: 0.07;
  }
  /* Moonlight: a blue night where the board still reads. The moon (the level's sun under the
     horizon) is a strong cool key over a deeper ambient, so lit and shaded sides part. The shade
     is a dark slate, not a saturated blue (painter-a1c read the full pull as electric navy): the
     prototype's grimdark is the guide, low chroma, teal greens. */
  @key night -8 {
    sun: oklch(0.84 0.035 245);  sun-energy: 0.45;
    sky: oklch(0.30 0.050 262);  horizon: oklch(0.42 0.045 262);
    ambient: oklch(0.52 0.055 245);  ambient-energy: 0.55;
    haze: oklch(0.42 0.050 266);
    ground: oklch(0.46 0.060 166);  leaf: oklch(0.46 0.070 182);  bark: oklch(0.34 0.025 40);
    needle: oklch(0.32 0.050 196);
    stone: oklch(0.52 0.030 260);  path: oklch(0.60 0.045 255);
    roof-clay: oklch(0.42 0.075 20);  roof-slate: oklch(0.38 0.035 265);  roof-shingle: oklch(0.36 0.040 300);
    roof-turf: oklch(0.38 0.060 180);  roof-thatch: oklch(0.52 0.050 70);
    plaster: oklch(0.62 0.030 250);  wall-stone: oklch(0.55 0.025 255);
    wall-log: oklch(0.40 0.030 50);  wall-boards: oklch(0.44 0.025 60);  timber: oklch(0.32 0.025 40);
    floor: oklch(0.38 0.050 190);  shore: oklch(0.55 0.040 250);  grass: oklch(0.43 0.065 170);
    drift: oklch(0.58 0.050 220);  litter: oklch(0.40 0.040 240);
    flower-gold: oklch(0.66 0.070 95);  flower-rose: oklch(0.52 0.070 345);
    flower-violet: oklch(0.46 0.080 290);  flower-white: oklch(0.80 0.035 250);
    flower-red: oklch(0.48 0.080 30);  flower-blue: oklch(0.50 0.070 260);
    shade-hue: 215;  shade-pull: 0.35;  shade-depth: 0.62;  shade-keep: 0.5;
    lit-hue: 220;  lit-pull: 0.35;  lit-lift: 0.14;
    ground-shade-pull: 0.3;  ground-shade-depth: 0.68;  ground-shade-keep: 0.4;  ground-lit-lift: 0.12;
    grass-shade-keep: 0.4;
    crown-shade-hue: 225;  crown-shade-pull: 0.4;  crown-shade-keep: 0.6;  tree-cast: 0.4;
    /* Water under the moon: a deep indigo, low-contrast strokes, a sparse silver glint. */
    water-shallow: oklch(0.42 0.070 235);  water-mid: oklch(0.33 0.075 255);
    water-deep: oklch(0.26 0.075 265);  water-lit: oklch(0.45 0.060 250);
    water-shade: oklch(0.22 0.070 270);  water-foam: oklch(0.80 0.030 250);
    water-glint: oklch(0.88 0.040 250);  water-glints: 0.35;  water-strokes: 0.4;
  }
}

@mood dusk {
  /* The spike's dusk (tuned there at a 20 to 26 degree sun): a warm sky, violet haze and
     blue-violet shade ("blue violet works", owner 2026-11-11). Retuned in painter-a1c toward the
     prototype's S18 dusk: the lit ground and grass one gold-green family (a small lift and a
     small pull toward the warm light, not a sand cream), and every role's shade one quiet lilac
     (the ground and grass keep a fifth of their own chroma under a small pull, so a path or a
     log no longer swings to magenta). */
  :world {
    --meadow: oklch(0.67 0.120 118);
    floor: oklch(0.62 0.100 114);  grass: oklch(0.64 0.130 122);  drift: oklch(0.82 0.110 95);
    litter: oklch(0.62 0.080 70);
    flower-gold: oklch(0.82 0.140 80);  flower-rose: oklch(0.66 0.140 15);
    flower-violet: oklch(0.56 0.120 300);  flower-white: oklch(0.90 0.050 75);
    flower-red: oklch(0.60 0.180 35);  flower-blue: oklch(0.60 0.110 270);
    tone-lo: 0.02;  tone-hi: 0.43;  shade-hue: 292;  shade-pull: 0.5;  shade-depth: 0.6;
    lit-hue: 45;  lit-pull: 0.35;  lit-lift: 0.16;
    ground-shade-pull: 0.75;  ground-shade-depth: 0.66;  ground-shade-keep: 0.2;
    ground-lit-pull: 0.05;  ground-lit-lift: 0.07;
    grass-shade-keep: 0;  grass-lit-pull: 0.1;  grass-lit-lift: 0.06;
    /* Crowns stay a readable mid green with gold on their lit side (S18 dusk's willow and
       rowan), their shade a deep green, not the ground's lilac. */
    needle: oklch(0.36 0.065 182);
    crown-shade-hue: 215;  crown-shade-pull: 0.6;  crown-shade-keep: 0.7;  crown-lit-pull: 0.35;
    tree-cast: 0.55;
    /* Walls warm in the low gold light, their shade the mood's lilac. */
    plaster: oklch(0.80 0.055 70);  wall-stone: oklch(0.62 0.035 60);
    wall-log: oklch(0.50 0.070 45);  wall-boards: oklch(0.55 0.055 55);  timber: oklch(0.38 0.060 45);
    /* The water takes the sky: a lilac mid and deep, a rose-lit stroke, a gold glint column. */
    water-shallow: oklch(0.84 0.085 200);  water-mid: oklch(0.72 0.100 250);
    water-deep: oklch(0.58 0.105 268);  water-lit: oklch(0.86 0.085 335);
    water-shade: oklch(0.46 0.090 275);  water-glint: oklch(0.93 0.100 75);
    water-foam: oklch(0.97 0.025 330);
  }
  @key high 24 {
    sun: oklch(0.88 0.090 58);  sun-energy: 0.95;
    sky: oklch(0.62 0.090 300);  horizon: oklch(0.70 0.100 45);
    ambient: oklch(0.72 0.070 298);  ambient-energy: 0.6;
    haze: oklch(0.66 0.075 305);
    ground: var(--meadow);  leaf: oklch(0.60 0.120 140);  bark: oklch(0.42 0.055 50);
    stone: oklch(0.52 0.030 60);  path: oklch(0.75 0.055 65);
    roof-clay: oklch(0.50 0.130 28);  roof-slate: oklch(0.45 0.050 290);  roof-shingle: oklch(0.45 0.060 20);
    roof-turf: oklch(0.50 0.090 130);  roof-thatch: oklch(0.58 0.085 62);
    /* A crown's lit side goes warm gold toward the sun's hue (painter-trees-polish: at 0.35 it
       stayed olive-yellow and the trees read as summer trees on a violet floor; polish3: at 0.35
       and 1.1 a sulphur yellow, a touch autumn, so a little greener and quieter). */
    crown-lit-pull: 0.3;  crown-lit-lift: 0.1;  crown-lit-chroma: 1.0;
  }
  /* The last of the sun: deeper and redder, the shade a fuller violet. */
  @key low 4 {
    sun: oklch(0.82 0.120 48);  sun-energy: 0.9;
    sky: oklch(0.52 0.085 295);  horizon: oklch(0.66 0.120 38);
    ambient: oklch(0.62 0.080 295);  ambient-energy: 0.62;
    haze: oklch(0.60 0.085 310);
    ground: oklch(0.62 0.115 104);  leaf: oklch(0.58 0.122 138);  bark: oklch(0.38 0.055 45);
    stone: oklch(0.49 0.035 50);  path: oklch(0.72 0.060 58);
    roof-clay: oklch(0.47 0.125 28);  roof-slate: oklch(0.41 0.050 290);  roof-shingle: oklch(0.41 0.060 20);
    roof-turf: oklch(0.46 0.085 125);  roof-thatch: oklch(0.55 0.090 58);
    floor: oklch(0.57 0.095 106);  grass: oklch(0.60 0.125 114);
    /* The last sun lights a crown's edge apricot to gold: toward the sun's hue and lighter than
       the green under it, a gold that still leans green (painter-trees-polish2: at 0.85 pull and
       1.25 chroma the crowns read as autumn; polish3: at 0.72 and 0.95 a khaki-beige lit side on
       dark green, two flat colours). The leaf a step livelier, so its green is the middle value. */
    crown-lit-pull: 0.6;  crown-lit-lift: 0.15;  crown-lit-chroma: 1.0;
  }
  /* After sunset: a violet night, warmer than summer's. */
  @key night -8 {
    sun: oklch(0.80 0.060 290);  sun-energy: 0.4;
    sky: oklch(0.28 0.070 290);  horizon: oklch(0.40 0.075 320);
    ambient: oklch(0.48 0.095 290);  ambient-energy: 0.55;
    haze: oklch(0.40 0.060 300);
    ground: oklch(0.42 0.065 170);  leaf: oklch(0.42 0.070 188);  bark: oklch(0.32 0.025 30);
    needle: oklch(0.30 0.050 200);  bark-shade-pull: 0.05;
    stone: oklch(0.46 0.035 290);  path: oklch(0.56 0.050 300);
    roof-clay: oklch(0.38 0.080 15);  roof-slate: oklch(0.34 0.040 285);  roof-shingle: oklch(0.33 0.045 320);
    roof-turf: oklch(0.35 0.060 175);  roof-thatch: oklch(0.47 0.055 60);
    plaster: oklch(0.56 0.040 295);  wall-stone: oklch(0.48 0.035 290);
    wall-log: oklch(0.36 0.030 30);  wall-boards: oklch(0.40 0.030 40);  timber: oklch(0.30 0.025 30);
    floor: oklch(0.35 0.055 200);  shore: oklch(0.50 0.045 290);  grass: oklch(0.39 0.070 180);
    drift: oklch(0.55 0.055 290);  litter: oklch(0.38 0.045 300);
    flower-gold: oklch(0.62 0.070 85);  flower-rose: oklch(0.48 0.075 340);
    flower-violet: oklch(0.42 0.085 295);  flower-white: oklch(0.74 0.040 300);
    flower-red: oklch(0.46 0.080 30);  flower-blue: oklch(0.46 0.075 265);
    lit-hue: 250;  lit-pull: 0.4;  lit-lift: 0.15;
    water-shallow: oklch(0.42 0.070 270);  water-mid: oklch(0.33 0.080 285);
    water-deep: oklch(0.26 0.080 295);  water-lit: oklch(0.46 0.070 300);
    water-shade: oklch(0.22 0.075 300);  water-foam: oklch(0.80 0.035 290);
    water-glint: oklch(0.88 0.050 290);  water-glints: 0.35;  water-strokes: 0.4;
  }
}

@mood grimdark {
  /* The spike's grimdark (a 27 degree sun): a limited palette, deep blue-green masses, bone and
     rust where the light falls, a pale fog. */
  :world {
    floor: oklch(0.32 0.035 150);  shore: oklch(0.48 0.025 90);  grass: oklch(0.38 0.045 160);
    drift: oklch(0.52 0.035 110);  litter: oklch(0.40 0.040 60);
    flower-gold: oklch(0.62 0.070 85);  flower-rose: oklch(0.48 0.080 25);
    flower-violet: oklch(0.42 0.050 290);  flower-white: oklch(0.72 0.020 90);
    flower-red: oklch(0.46 0.090 32);  flower-blue: oklch(0.46 0.050 255);
    tone-lo: 0.12;  tone-hi: 0.66;  shade-hue: 250;  shade-pull: 0.45;  shade-depth: 0.53;
    /* (painter-trees-fix: the lit ground a step under the crowns' lit, so a crown does not merge
       into the khaki ground behind it; it was 0.2.) */
    lit-hue: 85;  lit-lift: 0.17;  ground-lit-lift: 0.14;
    /* (painter-trees-fix2: the critic read one uniform teal-olive. The ground's lit side leans
       further toward the warm light, khaki-ochre, and its shade further toward the slate; the
       crowns' lit tops likewise toward olive-gold, their shade toward blue slate. Was ground
       shade pull 0.45 and lit pull 0.45 (the default), crown shade pull 0.35 and lit pull 0.3.) */
    ground-shade-pull: 0.6;  ground-lit-pull: 0.7;
    /* Crowns are readable grey-green masses (S18 grimdark), not black: a lighter leaf than the
       plants had, a slate-teal shade, a light cast step over an already dark palette. */
    needle: oklch(0.37 0.045 186);
    crown-shade-hue: 225;  crown-shade-pull: 0.5;  crown-shade-keep: 0.7;  tree-cast: 0.35;
    /* A wider value range so a crown's shape reads in the gloom (painter-trees-polish: flat
       grey-teal masses, spruce near black): a bone-lit top, a shade a step less deep (polish3:
       at 0.08 a crown's shade side merged with the ground's shadow into one near-black mass). */
    crown-lit-lift: 0.15;  crown-lit-chroma: 1.3;  crown-lit-pull: 0.55;  crown-shade-lift: 0.22;
    /* Bone walls and grey stone where the light falls (the spike's grimdark plaster). */
    plaster: oklch(0.64 0.030 85);  wall-stone: oklch(0.48 0.016 215);
    wall-log: oklch(0.40 0.040 60);  wall-boards: oklch(0.44 0.030 75);  timber: oklch(0.30 0.025 45);
    /* Water in the gloom: desaturated but never grey (chroma stays above 0.04), a bone foam. */
    water-shallow: oklch(0.64 0.055 195);  water-mid: oklch(0.50 0.058 215);
    water-deep: oklch(0.36 0.060 238);  water-lit: oklch(0.66 0.048 210);
    water-shade: oklch(0.30 0.055 248);  water-foam: oklch(0.88 0.020 195);
    water-glint: oklch(0.92 0.040 90);  water-glints: 0.5;  water-strokes: 0.45;
  }
  @key high 27 {
    sun: oklch(0.88 0.030 85);  sun-energy: 0.8;
    sky: oklch(0.40 0.020 250);  horizon: oklch(0.56 0.025 240);
    ambient: oklch(0.64 0.030 220);  ambient-energy: 0.6;
    haze: oklch(0.64 0.030 215);
    ground: oklch(0.36 0.040 165);  leaf: oklch(0.47 0.056 160);  bark: oklch(0.33 0.025 50);
    stone: oklch(0.40 0.015 220);  path: oklch(0.50 0.030 75);
    roof-clay: oklch(0.35 0.058 35);  roof-slate: oklch(0.34 0.020 230);  roof-shingle: oklch(0.32 0.030 50);
    roof-turf: oklch(0.34 0.040 160);  roof-thatch: oklch(0.43 0.045 75);
  }
  /* A low sun under the lid of cloud: rust in the light, the shade gone to slate. */
  @key low 5 {
    sun: oklch(0.80 0.060 60);  sun-energy: 0.75;
    sky: oklch(0.34 0.020 255);  horizon: oklch(0.50 0.040 60);
    ambient: oklch(0.56 0.030 230);  ambient-energy: 0.6;
    haze: oklch(0.56 0.030 220);
    ground: oklch(0.33 0.040 150);  leaf: oklch(0.41 0.050 160);  bark: oklch(0.31 0.025 45);
    stone: oklch(0.37 0.018 210);  path: oklch(0.47 0.035 65);
    roof-clay: oklch(0.33 0.058 35);  roof-slate: oklch(0.31 0.020 230);  roof-shingle: oklch(0.30 0.030 50);
    roof-turf: oklch(0.31 0.040 155);  roof-thatch: oklch(0.40 0.045 70);
    lit-hue: 60;  lit-pull: 0.5;
  }
  /* A cold, near-black night that still separates the board's masses. */
  @key night -8 {
    sun: oklch(0.76 0.030 240);  sun-energy: 0.4;
    sky: oklch(0.20 0.020 250);  horizon: oklch(0.30 0.025 245);
    ambient: oklch(0.42 0.040 240);  ambient-energy: 0.55;
    haze: oklch(0.32 0.025 240);
    ground: oklch(0.28 0.035 190);  leaf: oklch(0.33 0.040 195);  bark: oklch(0.26 0.020 30);
    needle: oklch(0.27 0.035 200);
    stone: oklch(0.34 0.015 240);  path: oklch(0.42 0.025 240);
    roof-clay: oklch(0.28 0.050 25);  roof-slate: oklch(0.26 0.020 240);  roof-shingle: oklch(0.25 0.025 280);
    roof-turf: oklch(0.26 0.035 185);  roof-thatch: oklch(0.36 0.030 70);
    plaster: oklch(0.46 0.020 240);  wall-stone: oklch(0.36 0.015 240);
    wall-log: oklch(0.29 0.020 40);  wall-boards: oklch(0.32 0.018 60);  timber: oklch(0.24 0.015 30);
    floor: oklch(0.24 0.030 200);  grass: oklch(0.29 0.040 190);  drift: oklch(0.40 0.030 230);
    flower-gold: oklch(0.50 0.040 90);  flower-white: oklch(0.60 0.020 240);
    lit-hue: 235;  lit-pull: 0.4;
    water-shallow: oklch(0.38 0.050 225);  water-mid: oklch(0.30 0.055 240);
    water-deep: oklch(0.24 0.055 252);  water-lit: oklch(0.40 0.045 240);
    water-shade: oklch(0.20 0.050 255);  water-foam: oklch(0.72 0.025 235);
    water-glint: oklch(0.82 0.035 240);  water-glints: 0.3;  water-strokes: 0.35;
  }
}

@mood winter {
  /* The spike's winter (a 19 to 29 degree sun): snow meadow, a pale cool haze, crowns a frosted
     green (painter-a2a3: phase 1 keeps the leaves, and the spike's grey-violet bare-crown tone
     read as lavender trees). Grass and flowers stand as dry stalks over the snow. */
  :world {
    floor: oklch(0.82 0.030 255);  shore: oklch(0.72 0.025 250);
    /* Snow bases: the seam is the snow's own blue shade, no soil, no green lean. */
    occ-soil: 0;  occ-cool: 0;  occ-dark: 0.84;  occ-shade: 0.85;
    /* Grass and flowers as dry straw over the snow (painter-trees-fix2: a pale straw under the full
       lit lift read beige slabs, its shade pulled to the snow's violet grey-lilac ghosts). A
       warmer straw, a small lit lift, and a shade that keeps its own hue over the pull (a keep
       above 1: a muted russet, not grey); fewer tufts stand above the snow, and the snow caps
       those (crown-deposit, which the plants take too). Its variants spread wide (painter-plants-
       fix3): a russet and a pale straw, so a tuft's dabs are never one tan. */
    grass: oklch(0.67 0.062 72);  grass-lit-lift: 0.08;  grass-shade-keep: 1.8;
    grass-hue-spread: 22;  grass-value-spread: 0.06;
    keep-grass: 0.45;  keep-flower: 0.25;  field-snow: 0.75;
    drift: oklch(0.95 0.015 240);  litter: oklch(0.62 0.040 60);
    flower-gold: oklch(0.74 0.060 85);  flower-rose: oklch(0.62 0.060 20);
    flower-violet: oklch(0.58 0.050 300);  flower-white: oklch(0.95 0.015 240);
    flower-red: oklch(0.60 0.070 30);  flower-blue: oklch(0.62 0.050 255);
    tone-lo: -0.02;  tone-hi: 0.48;  shade-hue: 265;  shade-pull: 1.0;  shade-depth: 0.74;
    lit-lift: 0.07;  ground-shade-pull: 1.05;  ground-shade-depth: 0.78;  ground-lit-lift: 0.075;
    ground-hue-spread: 6;  ground-value-spread: 0.02;
    /* The keys' leaf is a pale frosted green; a broadleaf's kept clumps take the dry leaf instead
       (leaf-turn below), so it tints the bushes (bush-value) and any leaf the bare season keeps. */
    needle: oklch(0.44 0.045 200);
    crown-shade-hue: 245;  crown-shade-pull: 0.6;  crown-shade-keep: 0.6;  tree-cast: 0.6;
    /* Crisp winter light (painter-trees-polish: a pale low-contrast sage): a warm lit step, a
       deeper blue shade, frost on the crowns' and the needles' up sides. The keys' leaf a little
       lighter and greener (polish3: it read dull and muddy beside the cobalt ground shadows). */
    crown-lit-lift: 0.1;  crown-lit-pull: 0.3;  crown-shade-lift: -0.06;  crown-deposit: 0.55;
    /* Bare broadleaves (owner, 2026-11-13: toward the prototype's winter): a fifth of the clumps
       kept at the reference fall (the oak about a third, a birch or willow a few), all of them a
       russet to golden dry leaf; the conifers' boughs loaded heavier. */
    leaf-keep: 0.15;  leaf-turn: 1;  dry-shade-lift: 0.15;  needle-snow: 1.6;
    dry-leaf: oklch(0.58 0.088 56);
    /* Warm walls against the blue snow: a lime wash a step under the snow's white; the roofs
       under a blanket with thick edges (card painter-roof-snow): deep on thatch, thin enough on
       steep and sun-facing tile and slate that their strokes show through. */
    plaster: oklch(0.84 0.032 72);  wall-stone: oklch(0.66 0.020 75);
    wall-log: oklch(0.55 0.060 55);  wall-boards: oklch(0.62 0.042 70);  timber: oklch(0.42 0.055 50);
    roof-snow: 0.45;
    /* The ground under snow (painter-ground-polish): a cliff face is bare warm rock (its own hue,
       not the blue stone: a badlands tier read as a blue band on orange ground) under a snow cap on
       its lip; a stone path is lifted toward the snow and dusted at its edges (it read heavy grey);
       no gold or moss swathes on the snow. */
    cliff-own: 0.85;  cliff-snow: 0.85;  cliff-warm: 0;  path-dust: 0.6;
    gold-share: 0;  moss-share: 0;
    /* Open water a slate teal, the still ponds frozen to a pale periwinkle (ice-over), a silver
       low glint; the shallows stay a clear pale teal. */
    water-shallow: oklch(0.84 0.085 196);  water-mid: oklch(0.67 0.100 212);
    water-deep: oklch(0.50 0.105 232);  water-lit: oklch(0.89 0.060 210);
    water-shade: oklch(0.42 0.095 242);  water-foam: oklch(0.98 0.012 230);
    water-glint: oklch(0.97 0.020 230);  water-ice: oklch(0.92 0.040 270);
    ice-over: 1;  water-strokes: 0.5;  water-glints: 0.6;
  }
  @key high 24 {
    sun: oklch(0.97 0.020 80);  sun-energy: 1.0;
    sky: oklch(0.84 0.030 240);  horizon: oklch(0.94 0.022 235);
    ambient: oklch(0.90 0.025 255);  ambient-energy: 0.6;
    haze: oklch(0.93 0.020 262);
    ground: oklch(0.88 0.040 250);  leaf: oklch(0.67 0.066 154);  bark: oklch(0.42 0.045 50);
    stone: oklch(0.62 0.015 250);  path: oklch(0.80 0.030 248);
    /* The snow's ground block (painter-look-winter; the prototype's S19: a periwinkle white, soft
       blue-lavender shade). The default lit pull (0.45 toward the sun's hue 95) carried the blue
       ground through green to a mint (the short way round the hue wheel), so the daylight snow takes
       no pull and a small lift, a wider hue spread (the lit variants run sky blue to lavender in
       patches), and a lighter, less electric shade. The low key keeps the :world values (the rose
       lit step of a low sun is unchanged). Also the ramp of the snow on plants and roofs (drift). */
    ground-lit-pull: 0;  ground-lit-lift: 0.03;  ground-hue-spread: 13;  ground-value-spread: 0.022;
    ground-shade-pull: 0.55;  ground-shade-depth: 0.86;
    roof-clay: oklch(0.52 0.110 36);  roof-slate: oklch(0.50 0.030 255);  roof-shingle: oklch(0.48 0.050 45);
    roof-turf: oklch(0.60 0.060 140);  roof-thatch: oklch(0.66 0.060 85);
  }
  /* Rose-gold light on the snow, lilac shade. */
  @key low 4 {
    sun: oklch(0.92 0.060 55);  sun-energy: 0.95;
    sky: oklch(0.76 0.040 260);  horizon: oklch(0.88 0.050 50);
    ambient: oklch(0.84 0.035 280);  ambient-energy: 0.65;
    haze: oklch(0.88 0.035 300);
    ground: oklch(0.86 0.035 300);  leaf: oklch(0.65 0.064 150);  bark: oklch(0.40 0.045 45);
    stone: oklch(0.60 0.020 280);  path: oklch(0.78 0.035 300);
    roof-clay: oklch(0.52 0.110 34);  roof-slate: oklch(0.48 0.030 270);  roof-shingle: oklch(0.46 0.050 40);
    roof-turf: oklch(0.56 0.055 135);  roof-thatch: oklch(0.65 0.065 75);
    floor: oklch(0.80 0.035 300);  lit-hue: 55;  lit-pull: 0.45;
  }
  /* Snow under the moon: the brightest night of the moods, a quiet blue (the full pull read as
     electric blue shade in painter-a1c's numbers, chroma 0.15). */
  @key night -8 {
    sun: oklch(0.86 0.030 250);  sun-energy: 0.5;
    sky: oklch(0.32 0.045 262);  horizon: oklch(0.46 0.040 262);
    ambient: oklch(0.56 0.045 258);  ambient-energy: 0.55;
    haze: oklch(0.48 0.045 262);
    ground: oklch(0.66 0.045 255);  leaf: oklch(0.48 0.035 205);  bark: oklch(0.31 0.020 40);
    needle: oklch(0.31 0.040 210);  dry-leaf: oklch(0.44 0.045 40);
    stone: oklch(0.46 0.025 260);  path: oklch(0.60 0.040 258);
    roof-clay: oklch(0.40 0.070 20);  roof-slate: oklch(0.36 0.030 262);  roof-shingle: oklch(0.35 0.035 290);
    roof-turf: oklch(0.40 0.045 190);  roof-thatch: oklch(0.50 0.040 70);
    plaster: oklch(0.62 0.025 255);  wall-stone: oklch(0.50 0.022 258);
    wall-log: oklch(0.38 0.025 45);  wall-boards: oklch(0.44 0.022 60);  timber: oklch(0.30 0.020 40);
    floor: oklch(0.60 0.045 258);  grass: oklch(0.48 0.035 230);  drift: oklch(0.74 0.040 255);
    flower-gold: oklch(0.56 0.040 90);  flower-white: oklch(0.74 0.035 255);
    lit-hue: 240;  lit-pull: 0.3;  shade-pull: 0.5;  shade-keep: 0.6;
    ground-shade-pull: 0.4;  ground-shade-keep: 0.5;  grass-shade-keep: 0.5;
    water-shallow: oklch(0.48 0.050 225);  water-mid: oklch(0.38 0.060 245);
    water-deep: oklch(0.29 0.065 258);  water-lit: oklch(0.52 0.045 245);
    water-shade: oklch(0.24 0.060 262);  water-foam: oklch(0.86 0.020 245);
    water-glint: oklch(0.90 0.030 245);  water-ice: oklch(0.70 0.045 262);
    water-glints: 0.35;  water-strokes: 0.4;
  }
}

@mood autumn {
  /* The spike's autumn (a 34 degree sun): amber crowns over a warm meadow, warm haze. */
  :world {
    floor: oklch(0.60 0.100 70);  grass: oklch(0.70 0.110 105);  drift: oklch(0.82 0.100 85);
    litter: oklch(0.66 0.130 55);
    flower-gold: oklch(0.82 0.140 80);  flower-rose: oklch(0.66 0.140 25);
    flower-violet: oklch(0.58 0.110 300);  flower-white: oklch(0.92 0.035 90);
    flower-red: oklch(0.58 0.170 38);  flower-blue: oklch(0.62 0.110 265);
    litter-marks: 0.5;
    /* Amber crowns shade to rust (a pull toward teal would grey them), needles to blue-teal. */
    crown-shade-hue: 300;  crown-shade-pull: 0.5;  crown-shade-keep: 0.85;
    plaster: oklch(0.87 0.048 82);  wall-stone: oklch(0.74 0.035 72);
    wall-log: oklch(0.57 0.075 52);  wall-boards: oklch(0.62 0.055 68);  timber: oklch(0.44 0.075 48);
    /* The water a touch greener, a clear teal under amber crowns. */
    water-shallow: oklch(0.85 0.090 178);  water-mid: oklch(0.70 0.105 205);
    water-deep: oklch(0.52 0.105 238);
  }
  @key high 34 {
    sun: oklch(0.96 0.045 78);  sun-energy: 1.0;
    sky: oklch(0.80 0.070 232);  horizon: oklch(0.92 0.045 90);
    ambient: oklch(0.88 0.040 235);  ambient-energy: 0.55;
    haze: oklch(0.90 0.050 80);
    ground: oklch(0.74 0.120 114);  leaf: oklch(0.72 0.155 62);  bark: var(--bark);
    stone: var(--stone);  path: var(--path);
    roof-clay: oklch(0.45 0.100 15);  roof-slate: oklch(0.48 0.040 250);  roof-shingle: oklch(0.48 0.070 40);
    roof-turf: oklch(0.62 0.110 105);  roof-thatch: oklch(0.72 0.060 82);
  }
  /* An amber evening: the crowns glow, the shade turns blue-violet. */
  @key low 5 {
    sun: oklch(0.90 0.100 62);  sun-energy: 1.0;
    sky: oklch(0.72 0.070 255);  horizon: oklch(0.86 0.090 62);
    ambient: oklch(0.82 0.040 265);  ambient-energy: 0.7;
    haze: oklch(0.84 0.065 60);
    ground: oklch(0.70 0.120 100);  leaf: oklch(0.68 0.155 52);  bark: oklch(0.48 0.075 48);
    stone: oklch(0.67 0.040 65);  path: oklch(0.78 0.070 68);
    roof-clay: oklch(0.46 0.105 18);  roof-slate: oklch(0.47 0.040 258);  roof-shingle: oklch(0.49 0.075 42);
    roof-turf: oklch(0.58 0.105 98);  roof-thatch: oklch(0.71 0.075 75);
    floor: oklch(0.57 0.100 62);  lit-hue: 65;  lit-pull: 0.55;
  }
  /* A clear autumn night: blue, with the crowns still a dull rust. */
  @key night -8 {
    sun: oklch(0.82 0.050 250);  sun-energy: 0.45;
    sky: oklch(0.30 0.055 262);  horizon: oklch(0.42 0.055 268);
    ambient: oklch(0.52 0.085 260);  ambient-energy: 0.55;
    haze: oklch(0.42 0.045 262);
    ground: oklch(0.45 0.060 160);  leaf: oklch(0.42 0.060 40);  bark: oklch(0.31 0.025 35);
    stone: oklch(0.50 0.030 255);  path: oklch(0.58 0.040 255);
    roof-clay: oklch(0.36 0.065 15);  roof-slate: oklch(0.37 0.035 262);  roof-shingle: oklch(0.36 0.045 300);
    roof-turf: oklch(0.40 0.060 150);  roof-thatch: oklch(0.52 0.045 70);
    plaster: oklch(0.60 0.030 250);  wall-stone: oklch(0.52 0.028 255);
    wall-log: oklch(0.40 0.030 45);  wall-boards: oklch(0.44 0.026 60);  timber: oklch(0.31 0.025 35);
    floor: oklch(0.38 0.055 60);  shore: oklch(0.54 0.040 250);  grass: oklch(0.44 0.060 150);
    drift: oklch(0.56 0.045 230);  litter: oklch(0.40 0.055 40);
    flower-gold: oklch(0.62 0.070 85);  flower-rose: oklch(0.48 0.070 345);
    flower-violet: oklch(0.44 0.080 290);  flower-white: oklch(0.78 0.035 250);
    flower-red: oklch(0.46 0.075 30);  flower-blue: oklch(0.46 0.070 262);
    shade-hue: 270;  shade-pull: 1.2;  lit-hue: 235;  lit-pull: 0.45;
    water-shallow: oklch(0.42 0.070 235);  water-mid: oklch(0.33 0.075 255);
    water-deep: oklch(0.26 0.075 265);  water-lit: oklch(0.45 0.060 250);
    water-shade: oklch(0.22 0.070 270);  water-foam: oklch(0.80 0.030 250);
    water-glint: oklch(0.88 0.040 250);  water-glints: 0.35;  water-strokes: 0.4;
