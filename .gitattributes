# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# The core content library (libraries/core, built by plantgen from the sources repo
# core-library; docs/systems/library.md "The core library") keeps its GLBs, surface PNGs and
# thumbnails in Git LFS so a library rebuild does not grow the repo history by ~170 MB. The
# JSON files and the constant `importer="keep"` .import sidecars stay in plain git. CI restores
# LFS objects from the Actions cache (.github/workflows/build.yml) to stay inside the free LFS
# bandwidth. (Until 2026-10-25 the same rules covered assets/palette, treecube's palette.)
libraries/core/**/*.glb filter=lfs diff=lfs merge=lfs -text
libraries/core/**/*.png filter=lfs diff=lfs merge=lfs -text
libraries/core/**/*.jpg filter=lfs diff=lfs merge=lfs -text

# The built-in avatar kit (figurine output, docs/ASSET_PIPELINE.md section 10), the same way:
# GLBs and PNGs in LFS, kit.json, build_report.json and the .import sidecars in plain git.
assets/avatar_kit/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/avatar_kit/**/*.png filter=lfs diff=lfs merge=lfs -text

# The fire's baked books (tools/fire_sim/README.md): FireBook resources of about 10 MB each,
# re-baked rarely but never worth a diff, so the same way.
assets/fire/** filter=lfs diff=lfs merge=lfs -text
